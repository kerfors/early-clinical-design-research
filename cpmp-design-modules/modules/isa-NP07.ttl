cpmp:ISA_NP07 a owl:Class ;
    rdfs:label "CPMP ISA NP07 design (registered, no documents posted)" ;
    rdfs:subClassOf _:N0cddf20377964df384f176c9ff7a6ca0,
        _:N6943bf6af7634186a0357daa28accab4,
