cpmp:crit-0ae1020d92 a owl:Class ;
    rdfs:label "have history or presence of severe hepatic disease including cirrhosis" ;
    rdfs:subClassOf obo:OBI_0500028 ;
    cpmp:occursIn "NP03" ;
    cpmp:sharingClass "single ISA" ;
    cpmp:textIdentical true .

cpmp:crit-157a8e5b36 a owl:Class ;
    rdfs:label "are taking carbonic anhydrase inhibitors if also taking metformin" ;
    rdfs:subClassOf obo:OBI_0500028 ;
    cpmp:occursIn "NP03" ;
    cpmp:sharingClass "single ISA" ;
    cpmp:textIdentical true .

cpmp:crit-b8e16939b8 a owl:Class ;
    rdfs:label "have not maintained a stable dose of glucose-lowering agents other than metformin for at least 4 weeks prior to Visit 3." ;
    rdfs:subClassOf obo:OBI_0500028 ;
    cpmp:occursIn "NP03" ;
    cpmp:sharingClass "single ISA" ;
    cpmp:textIdentical true .

cpmp:crit-c9801c4f39 a owl:Class ;
    rdfs:label "have had a change in metformin therapy in the last 12 weeks before Visit 2." ;
    rdfs:subClassOf obo:OBI_0500028 ;
    cpmp:occursIn "NP03" ;
    cpmp:sharingClass "single ISA" ;
    cpmp:textIdentical true .

cpmp:crit-d1b6b338d0 a owl:Class ;
    rdfs:label "Women who are pregnant or breastfeeding." ;
    rdfs:subClassOf obo:OBI_0500028 ;
    cpmp:note "Occurs in ISAs of more than one compound column; no document groups it." ;
    cpmp:occursIn "BP01;BP02;BP03;BP05;NP01;NP02;NP03;NP05;OA01;OA02;OA03;OA05" ;
    cpmp:sharingClass "other" ;
    cpmp:textIdentical false ;
    cpmp:variantText "are pregnant or breastfeeding.",
        "are women who are pregnant or breastfeeding.",
        "women who are pregnant or breastfeeding." .

cpmp:crit-de97e1f724 a owl:Class ;
    rdfs:label "have uncontrolled or unstable congestive heart failure" ;
    rdfs:subClassOf obo:OBI_0500028 ;
    cpmp:occursIn "NP03" ;
    cpmp:sharingClass "single ISA" ;
    cpmp:textIdentical true .

cpmp:crit-e8a1361731 a owl:Class ;
    rdfs:label "are taking medications that are known MATE1 or OCT2 substrates with the risk for potentially clinically significant drug-drug interactions, such as metformin, dofetilide and dalfampridine Metformin Exception Limited dosages of metformin are allowed in this study. ¶ Once daily dosing Dose levels up to and including 750 mg extended release and 850 mg immediate release may be administered once daily. ¶ Twice daily dosing Dose levels up to and including 500 mg of an immediate release formulation may be administered twice daily" ;
    rdfs:subClassOf obo:OBI_0500028 ;
    cpmp:occursIn "NP03" ;
    cpmp:sharingClass "single ISA" ;
    cpmp:textIdentical true .

cpmp:crit-fd4690f8c9 a owl:Class ;
    rdfs:label "have a history or presence of lactic acidosis" ;
    rdfs:subClassOf obo:OBI_0500028 ;
    cpmp:occursIn "NP03" ;
    cpmp:sharingClass "single ISA" ;
    cpmp:textIdentical true .

