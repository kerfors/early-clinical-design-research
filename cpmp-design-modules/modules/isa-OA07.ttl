<https://kerfors.github.io/early-clinical-design-research/cpmp-design-modules/modules/isa-OA07> a owl:Ontology ;
    owl:imports <https://kerfors.github.io/early-clinical-design-research/cpmp-design-modules/modules/disease-OA>,
        <https://kerfors.github.io/early-clinical-design-research/cpmp-design-modules/modules/master> .

cpmp:ISA_OA07 a owl:Class ;
    rdfs:label "CPMP ISA OA07 design (registered, no documents posted)" ;
    rdfs:subClassOf _:N0f54cde19f8b4abf9cf0e40829f4df7d,
        _:N685fcc7eda24427093327875d555bdbb,
        _:Nbe5d19bf687f41da8b6ba1ec2c2460f6,
        obo:OBI_0500001,
        cpmp:DiseaseState_OA,
        cpmp:MasterDesign ;
    cpmp:compoundStated "LY4065967" ;
    cpmp:diseaseStated "OA" ;
    cpmp:moduleRole "compound x disease state" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource cpmp:ISA_OA07 ;
    owl:annotatedTarget _:N685fcc7eda24427093327875d555bdbb ;
    cpmp:allocation "default assumed, no document" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource cpmp:ISA_OA07 ;
    owl:annotatedTarget cpmp:DiseaseState_OA ;
    cpmp:evidenceDoc "NCT07641517 (ClinicalTrials.gov record, last update 2026-09-04)" ;
    cpmp:evidenceText "The main purpose of this study is to test the safety and efficacy of study drug for the treatment of knee pain due to osteoarthritis (OA). This trial is part of the chronic pain master protocol H0P-MC-CPMP (NCT05986292), which is a protocol to accelerate the development of new treatments for chronic pain." .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource cpmp:ISA_OA07 ;
    owl:annotatedTarget cpmp:MasterDesign ;
    cpmp:evidenceDoc "NCT07641517 (ClinicalTrials.gov record, last update 2026-09-04)" ;
    cpmp:evidenceText "The main purpose of this study is to test the safety and efficacy of study drug for the treatment of knee pain due to osteoarthritis (OA). This trial is part of the chronic pain master protocol H0P-MC-CPMP (NCT05986292), which is a protocol to accelerate the development of new treatments for chronic pain." .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource cpmp:ISA_OA07 ;
    owl:annotatedTarget _:N0f54cde19f8b4abf9cf0e40829f4df7d ;
    cpmp:allocation "default assumed, no document" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource cpmp:ISA_OA07 ;
    owl:annotatedTarget _:Nbe5d19bf687f41da8b6ba1ec2c2460f6 ;
    cpmp:allocation "default assumed, no document" .

_:N0f54cde19f8b4abf9cf0e40829f4df7d a owl:Restriction ;
