cpmp:crit-3383ea9433 a owl:Class ;
    rdfs:label "Have an eGFR of less than 70 ml/min/1.73m2 based on CKD-EPI formula at Visit 1 or Visit 2" ;
    rdfs:subClassOf obo:OBI_0500028 ;
    cpmp:occursIn "BP01;NP01;OA01" ;
    cpmp:sharingClass "compound column" ;
    cpmp:textIdentical false ;
    cpmp:variantText "Have an estimated glomerular filtration rate (eGFR) of less than 70 ml/min/1.73m2 based on the Chronic Kidney Disease Epidemiology Collaboration (CKD-EPI) formula at Visit 1 or Visit 2",
        "have an eGFR of less than 70 ml/min/1.73m2 based on CKD-EPI formula at Visit 1 or Visit 2" .

cpmp:crit-3c0e69b5ef a owl:Class ;
    rdfs:label "have a history of allergic reactions to monoclonal antibodies, or clinically significant multiple or severe drug allergies, including but not limited to erythema multiforme major, linear immunoglobulin A dermatosis, toxic epidermal necrolysis, or exfoliative dermatitis" ;
    rdfs:subClassOf obo:OBI_0500028 ;
    cpmp:occursIn "BP01;NP01;OA01" ;
    cpmp:sharingClass "compound column" ;
    cpmp:textIdentical false ;
    cpmp:variantText "have a history of allergic reactions to monoclonal antibodies, or clinically significant multiple or severe drug allergies, including but not limited to erythema multiforme major, linear immunoglobulin A dermatosis, toxic epidermal necrolysis, or exfoliative dermatitis." .

cpmp:crit-64b102cbb0 a owl:Class ;
    rdfs:label "must have venous access in both arms for IV infusion and sample collection." ;
    rdfs:subClassOf obo:OBI_0500027 ;
    cpmp:occursIn "BP01;NP01;OA01" ;
    cpmp:sharingClass "compound column" ;
    cpmp:textIdentical true .

cpmp:crit-9743386e83 a owl:Class ;
    rdfs:label "have received any antibodies against nerve growth factor (NGF), antibodies against EGFR, or EGFR tyrosine kinase inhibitors (TKI)." ;
