    rdfs:subClassOf obo:OBI_0500027 ;
    cpmp:evidenceNumber "7" ;
    cpmp:evidencePage 31 ;
    cpmp:occursIn "CPMP" ;
    cpmp:sharingClass "master" ;
    cpmp:textIdentical true .

