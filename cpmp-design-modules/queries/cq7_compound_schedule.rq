# CQ7: which SoA cells does each compound design hold?
PREFIX cpmp: <https://kerfors.github.io/early-clinical-design-research/cpmp-design-modules/>
PREFIX obo:  <http://purl.obolibrary.org/obo/>
PREFIX owl:  <http://www.w3.org/2002/07/owl#>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?compound ?cell ?activity ?visit
WHERE {
    ?compound cpmp:moduleRole "compound" ;
              owl:equivalentClass/owl:intersectionOf/rdf:rest*/rdf:first ?r .
    ?r owl:onProperty obo:BFO_0000051 ;
       owl:someValuesFrom ?cell .
    ?cell rdfs:subClassOf obo:IAO_0000007 ;
          cpmp:activityKey ?activity ;
          cpmp:visit ?visit .
}
ORDER BY ?compound ?activity ?visit
