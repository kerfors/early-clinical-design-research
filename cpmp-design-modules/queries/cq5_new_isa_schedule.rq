# CQ5: what schedule does an ISA with no public content inherit?
# Schedule parts (SoA cells and schedule slots, both under action specification) from the
# master design, plus the master defaults the ISA has directly ("default assumed, no document").
PREFIX cpmp: <https://kerfors.github.io/early-clinical-design-research/cpmp-design-modules/>
PREFIX obo:  <http://purl.obolibrary.org/obo/>
PREFIX owl:  <http://www.w3.org/2002/07/owl#>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?isa ?how ?part ?label
WHERE {
    ?isa cpmp:moduleRole "compound x disease state" .
    FILTER NOT EXISTS {
        ?isa rdfs:subClassOf ?c .
        ?c cpmp:moduleRole "compound" .
    }
    {
        ?isa rdfs:subClassOf cpmp:MasterDesign .
        cpmp:MasterDesign owl:equivalentClass/owl:intersectionOf/rdf:rest*/rdf:first ?r .
        BIND ("master cell" AS ?how)
    }
    UNION
    {
        ?isa rdfs:subClassOf cpmp:MasterDesign .
        cpmp:MasterDesign rdfs:subClassOf ?r .
        BIND ("master slot" AS ?how)
    }
    UNION
    {
        ?isa rdfs:subClassOf ?r .
        ?ax owl:annotatedSource ?isa ;
            owl:annotatedTarget ?r ;
            cpmp:allocation ?how .
    }
    ?r owl:onProperty obo:BFO_0000051 ;
       owl:someValuesFrom ?part .
    FILTER isIRI(?part)
    ?part rdfs:subClassOf obo:IAO_0000007 ;
          rdfs:label ?label .
}
ORDER BY ?isa ?how ?label
