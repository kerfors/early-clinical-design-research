# CQ2: what does an ISA design with no public content inherit before anything is written for it?
# ISA designs not classified under any compound design; their parts come from the
# definitions or subclass axioms of their superclasses (master, disease state).
PREFIX cpmp: <https://kerfors.github.io/early-clinical-design-research/cpmp-design-modules/>
PREFIX obo:  <http://purl.obolibrary.org/obo/>
PREFIX owl:  <http://www.w3.org/2002/07/owl#>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?isa ?from ?part ?label
WHERE {
    ?isa cpmp:moduleRole "compound x disease state" .
    FILTER NOT EXISTS {
        ?isa rdfs:subClassOf ?c .
        ?c cpmp:moduleRole "compound" .
    }
    ?isa rdfs:subClassOf ?from .
    ?from cpmp:moduleRole ?role .
    {
        ?from owl:equivalentClass/owl:intersectionOf/rdf:rest*/rdf:first ?r .
    }
    UNION
    {
        ?from rdfs:subClassOf ?r .
    }
    ?r owl:onProperty obo:BFO_0000051 ;
       owl:someValuesFrom ?part .
    FILTER isIRI(?part)
    FILTER NOT EXISTS { ?part rdfs:subClassOf obo:IAO_0000007 }
    ?part rdfs:label ?label .
}
ORDER BY ?isa ?from ?label
