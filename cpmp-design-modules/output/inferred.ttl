   owl:annotatedSource <https://kerfors.github.io/early-clinical-design-research/cpmp-design-modules/ISA_NP01> ;
   owl:annotatedProperty rdfs:subClassOf ;
   owl:annotatedTarget _:genid1383 ;
   <https://kerfors.github.io/early-clinical-design-research/cpmp-design-modules/evidenceDoc> "NP01" ;
