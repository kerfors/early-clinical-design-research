   <https://kerfors.github.io/early-clinical-design-research/cpmp-design-modules/evidencePage> 20 ;
   <https://kerfors.github.io/early-clinical-design-research/cpmp-design-modules/evidenceText> "have had a change in metformin therapy in the last 12 weeks before Visit 2."
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource <https://kerfors.github.io/early-clinical-design-research/cpmp-design-modules/ISA_NP03> ;
   owl:annotatedProperty rdfs:subClassOf ;
   owl:annotatedTarget _:genid1789 ;
   <https://kerfors.github.io/early-clinical-design-research/cpmp-design-modules/evidenceDoc> "NP03" ;
   <https://kerfors.github.io/early-clinical-design-research/cpmp-design-modules/evidenceNumber> "3027" ;
   <https://kerfors.github.io/early-clinical-design-research/cpmp-design-modules/evidencePage> 19 ;
   <https://kerfors.github.io/early-clinical-design-research/cpmp-design-modules/evidenceText> "have a QRS interval ≥120 msec at Visit 1 or Visit 2"
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource <https://kerfors.github.io/early-clinical-design-research/cpmp-design-modules/ISA_NP03> ;
