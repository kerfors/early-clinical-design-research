ns2:MONDO_7770007 a owl:Class ;
    rdfs:label "disease by developmental or physiological process" ;
    ns2:IAO_0000115 "A grouping class for human diseases classified by the molecular, biochemical, cellular, anatomic, developmental or physiological process that is disrupted." ;
    ns1:id "MONDO:7770007" ;
    rdfs:comment "This term is intended solely for classification purposes and should not be used for direct data annotation." ;
