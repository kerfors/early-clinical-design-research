ns2:MONDO_0021166 a owl:Class ;
    rdfs:label "inflammatory disease" ;
    ns2:IAO_0000115 "A disease involving a pathogenic inflammatory response in the anatomical structure." ;
    dcterms:conformsTo <http://purl.obolibrary.org/obo/mondo/patterns/specific_infectious_disease_by_location.yaml>,
        <http://purl.obolibrary.org/obo/mondo/patterns/specific_inflammatory_disease_by_site.yaml> ;
    ns1:hasDbXref "ICD9:799.89",
        "MEDGEN:452939",
        "NCIT:C93210",
        "SCTID:128139000",
        "UMLS:C1290884" ;
    ns1:hasExactSynonym "anatomical structure inflammation",
        "inflammation of anatomical structure",
