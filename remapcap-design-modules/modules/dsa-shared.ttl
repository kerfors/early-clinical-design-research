rcap:SharedDSA_AB_MD a owl:Class ;
    rdfs:label "Shared by Antibiotic Domain-Specific Appendix 4, Macrolide Duration Domain-Specific Appendix 4 (no Core, no PANDA)" ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( obo:OBI_0500001 [ a owl:Restriction ;
                        owl:onProperty obo:BFO_0000051 ;
                        owl:someValuesFrom rcap:c93d0ed0860 ] ) ] ;
    rcap:note "B-shared: derived from the documents' shared components; no document states this grouping." .

