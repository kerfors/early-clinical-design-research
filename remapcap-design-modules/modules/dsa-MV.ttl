    rcap:evidenceSection "8.5.2" ;
    rcap:evidenceText "SAE as defined in the core protocol documents and qualified in this DSA" ;
    rcap:occurrenceKind "endpoint_secondary" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_MV ;
    owl:annotatedTarget _:N747ac1cefec14043808c83ca1a0960c0 ;
    rcap:evidenceDoc "Mechanical Ventilation Domain-Specific Appendix 2" ;
    rcap:evidenceGlyph "•" ;
    rcap:evidencePage 30 ;
    rcap:evidencePosition "1" ;
    rcap:evidenceSection "8.5.2" ;
    rcap:evidenceText "Administration of rescue therapies" ;
    rcap:occurrenceKind "endpoint_secondary" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_MV ;
    owl:annotatedTarget _:N676842845e6742f2a58c55d591f2b356 ;
    rcap:evidenceDoc "Mechanical Ventilation Domain-Specific Appendix 2" ;
    rcap:evidencePosition "lead_in:3" ;
    rcap:evidenceSection "8.3.5" ;
    rcap:evidenceText "Adherence to the allocated mechanical ventilation strategy should continue as long as the patient is receiving invasive ventilation or until day 28, whichever occurs first." ;
    rcap:occurrenceKind "intervention" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_MV ;
    owl:annotatedTarget _:N2d4aee553f8c4872869733b169937ab1 ;
    rcap:evidenceDoc "Mechanical Ventilation Domain-Specific Appendix 2" ;
    rcap:evidencePosition "lead_in:2" ;
    rcap:evidenceSection "8.5.2" ;
    rcap:evidenceText "The domain-specific secondary outcome measures (occurring during the index hospitalization, censored 90 days after enrollment) are:" ;
    rcap:occurrenceKind "endpoint_secondary" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_MV ;
    owl:annotatedTarget _:Nb03c08a1ea0941308e6d63ff9d7dc88d ;
    rcap:evidenceDoc "Mechanical Ventilation Domain-Specific Appendix 2" ;
    rcap:evidencePosition "lead_in:14" ;
    rcap:evidenceSection "8.3.4" ;
    rcap:evidenceText "Given that the original ARDSnet including the standard PEEP arm is frequently the control group in ventilation studies and many units still deliver the original ARDS net protocol (including the standard PEEP approach), we will allow units to use either FiO2 / PEEP table below." ;
    rcap:occurrenceKind "intervention" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_MV ;
    owl:annotatedTarget _:Na7068e254a9344b18684807c615b7c41 ;
    rcap:evidenceDoc "Mechanical Ventilation Domain-Specific Appendix 2" ;
    rcap:evidencePosition "lead_in:1" ;
    rcap:evidenceSection "9.2" ;
    rcap:evidenceText "Refer to relevant Core Protocol documents for criteria for discontinuation of participation in this trial." ;
    rcap:occurrenceKind "discontinuation" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_MV ;
    owl:annotatedTarget _:Ndd8df7cccab24d32863cb35d81b9f4d9 ;
    rcap:evidenceDoc "Mechanical Ventilation Domain-Specific Appendix 2" ;
    rcap:evidencePosition "lead_in:1" ;
    rcap:evidenceSection "8.3.1" ;
    rcap:evidenceText "Patients will be randomly assigned to receive one of the following open-label study interventions." ;
    rcap:occurrenceKind "intervention" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_MV ;
    owl:annotatedTarget _:Ndcb935a7fcaf430db42647c47961b082 ;
    rcap:evidenceDoc "Mechanical Ventilation Domain-Specific Appendix 2" ;
    rcap:evidencePosition "lead_in:1" ;
    rcap:evidenceSection "10.4" ;
    rcap:evidenceText "The timing of the revealing of allocation status and administration of interventions is as specified to be Randomization with Immediate Reveal and Initiation, Delayed Reveal and Initiation, or Deferred Reveal and Initiation." ;
    rcap:occurrenceKind "allocation_reveal" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_MV ;
    owl:annotatedTarget _:Nb3ccb2a8227e4a7ebe0b061062f66fbf ;
    rcap:evidenceDoc "Mechanical Ventilation Domain-Specific Appendix 2" ;
    rcap:evidencePosition "lead_in:1" ;
    rcap:evidenceSection "8.2.2" ;
    rcap:evidenceText "Patients will be excluded from this domain if they have any of the following:" ;
    rcap:occurrenceKind "domain_exclusion" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_MV ;
    owl:annotatedTarget _:N88738c263030460eaabd6eb0d0ed414c ;
    rcap:evidenceDoc "Mechanical Ventilation Domain-Specific Appendix 2" ;
    rcap:evidencePosition "lead_in:3" ;
    rcap:evidenceSection "8.3.3" ;
    rcap:evidenceText "Any and all ventilatory parameters, including mode of ventilation, can be adjusted at any time." ;
    rcap:occurrenceKind "intervention" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_MV ;
    owl:annotatedTarget _:N9495f1fd99984fb1a5b737fcf2aa0473 ;
    rcap:evidenceDoc "Mechanical Ventilation Domain-Specific Appendix 2" ;
    rcap:evidencePosition "lead_in:18" ;
    rcap:evidenceSection "8.3.4" ;
    rcap:evidenceText "The delivery of protocolized mechanical ventilation will be facilitated by training of site personnel, the availability of bedside study tools, and audit and feedback to sites regarding adherence to the protocol." ;
    rcap:occurrenceKind "intervention" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_MV ;
    owl:annotatedTarget _:N2665f6b041114b7fb510672f3174a2f1 ;
    rcap:evidenceDoc "Mechanical Ventilation Domain-Specific Appendix 2" ;
    rcap:evidenceGlyph "•" ;
    rcap:evidencePage 31 ;
    rcap:evidencePosition "4" ;
    rcap:evidenceSection "9.1.1" ;
    rcap:evidenceText "Occurrence and duration of prone ventilation" ;
    rcap:occurrenceKind "data_collection" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_MV ;
    owl:annotatedTarget _:Nc397dfe985cd4051b0c575daef571e48 ;
    rcap:evidenceDoc "Mechanical Ventilation Domain-Specific Appendix 2" ;
    rcap:evidencePosition "lead_in:11" ;
    rcap:evidenceSection "8.3.4" ;
    rcap:evidenceText "If the acidosis has a substantial metabolic component, continuous renal replacement therapy may be instituted, at the discretion of the treating clinician." ;
    rcap:occurrenceKind "intervention" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_MV ;
    owl:annotatedTarget _:N17f799648abb42c09199a0b9df023967 ;
    rcap:evidenceDoc "Mechanical Ventilation Domain-Specific Appendix 2" ;
    rcap:evidencePosition "lead_in:9" ;
    rcap:evidenceSection "8.3.4" ;
    rcap:evidenceText "If arterial pH is less than 7.15, the tidal volume can be increased in 5 to 10% increments until arterial pH is more than 7.15, noting that, if necessary, to maintain a pH of not less than 7.15, it is permitted for the plateau pressure to exceed 30 cm H 2 O." ;
    rcap:occurrenceKind "intervention" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_MV ;
    owl:annotatedTarget _:N91949177a7bd4ffd8f332e1e2446f4b7 ;
    rcap:evidenceDoc "Mechanical Ventilation Domain-Specific Appendix 2" ;
    rcap:evidencePosition "lead_in:3" ;
    rcap:evidenceSection "8.3.4" ;
    rcap:evidenceText "If the plateau pressure is more than 30 cmH 2 O, the tidal volume should be reduced in 5 to 10% increments, but to not less than 65% of the initial specified tidal volume (corresponding to 4.0 ml/kg PBW)." ;
    rcap:occurrenceKind "intervention" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_MV ;
    owl:annotatedTarget _:N4dd0138185fa465bacc149c408dc9f34 ;
    rcap:evidenceDoc "Mechanical Ventilation Domain-Specific Appendix 2" ;
    rcap:evidencePosition "lead_in:12" ;
    rcap:evidenceSection "8.3.4" ;
    rcap:evidenceText "Administration of a tidal volume of more than 6.0 ml/kg PBW or a plateau pressure of 30 cm H20 or more is a protocol deviation unless the pH is less than 7.15." ;
    rcap:occurrenceKind "intervention" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_MV ;
    owl:annotatedTarget _:N50ff3cbb35484e838721dc2d7ddbeca5 ;
    rcap:evidenceDoc "Mechanical Ventilation Domain-Specific Appendix 2" ;
    rcap:evidencePosition "lead_in:1" ;
    rcap:evidenceSection "8.3.5" ;
    rcap:evidenceText "The duration of administration of the interventions outlined in this domain is at the discretion of the treating clinician." ;
    rcap:occurrenceKind "intervention" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_MV ;
    owl:annotatedTarget _:N4062e2b5b94b4ce98ebe5410fda9a94e ;
    rcap:evidenceDoc "Mechanical Ventilation Domain-Specific Appendix 2" ;
    rcap:evidencePosition "lead_in:15" ;
    rcap:evidenceSection "8.3.4" ;
    rcap:evidenceText "Each participating Intensive Care Unit will declare a priori which PEEP table it will follow in the Protocolized intervention." ;
    rcap:occurrenceKind "intervention" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_MV ;
    owl:annotatedTarget _:N0160258179ca4a6a9fb9ecb8bd2ea956 ;
    rcap:evidenceDoc "Mechanical Ventilation Domain-Specific Appendix 2" ;
    rcap:evidenceGlyph "•" ;
    rcap:evidencePage 27 ;
    rcap:evidencePosition "4" ;
    rcap:evidenceSection "8.2.1" ;
    rcap:evidenceText "Treating clinician regards Protocolized Mechanical Ventilation Strategy or their preferred mechanical ventilation strategy as (equally) appropriate for this patient." ;
    rcap:occurrenceKind "domain_inclusion" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_MV ;
    owl:annotatedTarget _:Nc32a15f885194ef8b6f7c8150340fd8b ;
    rcap:evidenceDoc "Mechanical Ventilation Domain-Specific Appendix 2" ;
    rcap:evidencePosition "lead_in:1" ;
    rcap:evidenceSection "8.5.2" ;
    rcap:evidenceText "All secondary endpoints as specified in the Core Protocol." ;
    rcap:occurrenceKind "endpoint_secondary" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_MV ;
    owl:annotatedTarget _:Nd5c371eff5c34a4b8c2885062a1c52e9 ;
    rcap:evidenceDoc "Mechanical Ventilation Domain-Specific Appendix 2" ;
    rcap:evidencePosition "lead_in:2" ;
    rcap:evidenceSection "8.3.4" ;
    rcap:evidenceText "The treating clinician will set the mode of ventilation as either SIMV, Assist Control, or Pressure Regulated Volume Control, setting the tidal volume to that specified by the on-line eligibility system or calculated by the site." ;
    rcap:occurrenceKind "intervention" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_MV ;
    owl:annotatedTarget _:N6475a9dd094c46f299adac422b5bc112 ;
    rcap:evidenceDoc "Mechanical Ventilation Domain-Specific Appendix 2" ;
    rcap:evidencePosition "lead_in:1" ;
    rcap:evidenceSection "8.1.3" ;
    rcap:evidenceText "Domain-specific strata are not applied to patients at the time of assessment for this domain." ;
    rcap:occurrenceKind "domain_strata" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_MV ;
    owl:annotatedTarget _:N7d9dc4c1183c4c33b144e260fe062e75 ;
    rcap:evidenceDoc "Mechanical Ventilation Domain-Specific Appendix 2" ;
    rcap:evidenceGlyph "•" ;
    rcap:evidencePage 26 ;
    rcap:evidencePosition "1" ;
    rcap:evidenceSection "8.2.1" ;
    rcap:evidenceText "Receiving invasive mechanical ventilation" ;
    rcap:occurrenceKind "domain_inclusion" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_MV ;
    owl:annotatedTarget _:N5d2ec99127e74a078c2b75698858bef6 ;
    rcap:evidenceDoc "Mechanical Ventilation Domain-Specific Appendix 2" ;
    rcap:evidencePosition "lead_in:5" ;
    rcap:evidenceSection "8.3.4" ;
    rcap:evidenceText "The respiratory rate is set by the treating clinician with the goal of achieving the targeted PaCO 2 and adjusted, as required, to achieve the PaCO 2 target." ;
    rcap:occurrenceKind "intervention" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_MV ;
    owl:annotatedTarget _:N8878073bca304ec4bb7d810678a5c347 ;
    rcap:evidenceDoc "Mechanical Ventilation Domain-Specific Appendix 2" ;
    rcap:evidencePosition "lead_in:10" ;
    rcap:evidenceSection "8.3.4" ;
    rcap:evidenceText "In the presence of severe acidosis, bicarbonate may be administered, at the discretion of the treating clinician." ;
    rcap:occurrenceKind "intervention" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_MV ;
    owl:annotatedTarget _:N7ab17fe696ae4039ac0641491827cae0 ;
    rcap:evidenceDoc "Mechanical Ventilation Domain-Specific Appendix 2" ;
    rcap:evidencePosition "lead_in:1" ;
    rcap:evidenceSection "10.6" ;
    rcap:evidenceText "Nesting is not applicable to this domain." ;
    rcap:occurrenceKind "allocation_nesting" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_MV ;
    owl:annotatedTarget _:Nb1e9874b3e3a4082ad7795386fbdbb64 ;
    rcap:evidenceDoc "Mechanical Ventilation Domain-Specific Appendix 2" ;
    rcap:evidencePosition "lead_in:4" ;
    rcap:evidenceSection "8.3.4" ;
    rcap:evidenceText "At any time, if the tidal volume is less than that specified following calculation from the patient’s height and the plateau pressure is 29 cm or less, the tidal volume should be increased in 5% increments to achieve a tidal volume as close to, but not exceeding, the specified target tidal volume while maintain plateau pressure of not more than 30 cm H 2 O." ;
    rcap:occurrenceKind "intervention" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_MV ;
    owl:annotatedTarget _:Nd714b4088e4a4b2fb2e90c61e5145b88 ;
    rcap:evidenceDoc "Mechanical Ventilation Domain-Specific Appendix 2" ;
    rcap:evidenceGlyph "•" ;
    rcap:evidencePage 26 ;
    rcap:evidencePosition "2" ;
    rcap:evidenceSection "8.2.1" ;
    rcap:evidenceText "The most recent PaO 2 :FiO 2 ratio obtained within the preceding 6 hours is less than 200 mmHg" ;
    rcap:occurrenceKind "domain_inclusion" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_MV ;
    owl:annotatedTarget _:N1fd2428e93964a97bbb0d584bba358bd ;
    rcap:evidenceDoc "Mechanical Ventilation Domain-Specific Appendix 2" ;
    rcap:evidencePosition "lead_in:1" ;
    rcap:evidenceSection "8.1.1" ;
    rcap:evidenceText "This domain is available to patients who are in the Adult Age Stratum, as defined in Core Protocol documents." ;
    rcap:occurrenceKind "applicability_age" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_MV ;
    owl:annotatedTarget _:Na73d7a1426fe4c0fbddc89d250905db3 ;
    rcap:evidenceDoc "Mechanical Ventilation Domain-Specific Appendix 2" ;
    rcap:evidencePosition "lead_in:6" ;
    rcap:evidenceSection "8.3.5" ;
    rcap:evidenceText "Criteria for extubation, or insertion of a tracheostomy tube, are not specified by the trial and are at the discretion of the treating clinician." ;
    rcap:occurrenceKind "intervention" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_MV ;
    owl:annotatedTarget _:Na37ed952be2a435aacf9b0d2e8017c94 ;
    rcap:evidenceDoc "Mechanical Ventilation Domain-Specific Appendix 2" ;
    rcap:evidencePosition "lead_in:1" ;
    rcap:evidenceSection "10.5" ;
    rcap:evidenceText "Interactions with all other domains are either not evaluable or not considered possible and will not be incorporated into the statistical model in which this domain is evaluated." ;
    rcap:occurrenceKind "allocation_interactions" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_MV ;
    owl:annotatedTarget _:N0afd1aa579524604a7ebf2b326068a50 ;
    rcap:evidenceDoc "Mechanical Ventilation Domain-Specific Appendix 2" ;
    rcap:evidencePosition "lead_in:13" ;
    rcap:evidenceSection "8.3.4" ;
    rcap:evidenceText "The FiO 2 and PEEP should be set on the ventilator to the minimum allowable combination of FiO 2 and PEEP that consistently achieves a PaO 2 / SaO 2 within the target range and adjusted further, as required according to either of the tables below which is derived from either the ARMA ARDSnet trial (the standard PEEP arm) OR the LOVS and ALVEOLI trials (the high PEEP arm) (Meade et al., 2008, Brower et al., 2004)." ;
    rcap:occurrenceKind "intervention" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_MV ;
    owl:annotatedTarget _:N6e10d36e05c34f7fbc4ab1c3806f042b ;
    rcap:evidenceDoc "Mechanical Ventilation Domain-Specific Appendix 2" ;
    rcap:evidencePosition "lead_in:1" ;
    rcap:evidenceSection "8.3.3" ;
    rcap:evidenceText "The clinician will choose the mode of ventilation and all ventilatory parameters that they would use normally for this patient." ;
    rcap:occurrenceKind "intervention" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
