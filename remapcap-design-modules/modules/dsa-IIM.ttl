    rcap:evidencePosition "lead_in:2" ;
    rcap:evidenceSection "8.1.1" ;
    rcap:evidenceText "Eligibility within these strata may be further constrained by domain-specific eligibility criteria specified below." ;
    rcap:occurrenceKind "applicability_age" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_IIM ;
    owl:annotatedTarget _:N2f7024cb2dd441098cb7d905817c4b5c ;
    rcap:evidenceDoc "Influenza Immune Modulation Domain-Specific Appendix 2.1" ;
    rcap:evidenceGlyph "•" ;
    rcap:evidencePage 26 ;
    rcap:evidencePosition "6" ;
    rcap:evidenceSection "8.2.2" ;
    rcap:evidenceText "Patient has already received any dose of one or more of any form of tocilizumab or another IL-6 receptor antagonist (e.g. sarilumab), baricitinib or another JAK inhibitor (e.g. tofacitinib, ruxolitinib or upadacitinib) during this hospitalization or is on long-term therapy with any of these agents prior to this hospital admission." ;
    rcap:occurrenceKind "domain_exclusion" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_IIM ;
    owl:annotatedTarget _:N8504ccb0cf9f4d158fbf68a76b2bb565 ;
    rcap:evidenceDoc "Influenza Immune Modulation Domain-Specific Appendix 2.1" ;
    rcap:evidencePosition "lead_in:2" ;
    rcap:evidenceSection "8.2.3" ;
    rcap:evidenceText "In such cases, patients will be randomly allocated a remaining intervention from among those available at that site." ;
    rcap:occurrenceKind "intervention_exclusion" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_IIM ;
    owl:annotatedTarget _:N00dff527a898474cbed01d23ec055f9d ;
    rcap:evidenceDoc "Influenza Immune Modulation Domain-Specific Appendix 2.1" ;
    rcap:evidencePosition "lead_in:5" ;
    rcap:evidenceSection "8.3.4" ;
    rcap:evidenceText "Baricitinib will be given at a dose of 1 mg daily if the eGFR is at least 15 and less than 30 mL/min/1.73m 2 ." ;
    rcap:occurrenceKind "intervention" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_IIM ;
    owl:annotatedTarget _:Nb844d5432db8406d99446e7adb9f2125 ;
    rcap:evidenceDoc "Influenza Immune Modulation Domain-Specific Appendix 2.1" ;
    rcap:evidencePosition "lead_in:8" ;
    rcap:evidenceSection "8.3.4" ;
    rcap:evidenceText "In children 2 years to <9 years of age, baricitinib will be withheld if the eGFR is <30 mL/min/1.73m 2 or the patient is receiving renal replacement therapy For patients who are unable to swallow whole tablets, baricitinib may be dispersed in water and delivered via an enteral feeding tube." ;
    rcap:occurrenceKind "intervention" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_IIM ;
    owl:annotatedTarget _:N81782efc98014042b264ceea5aa1903f ;
    rcap:evidenceDoc "Influenza Immune Modulation Domain-Specific Appendix 2.1" ;
    rcap:evidenceGlyph "•" ;
    rcap:evidencePage 28 ;
    rcap:evidencePosition "7" ;
    rcap:evidenceSection "8.2.3" ;
    rcap:evidenceText "In children aged >2 years and <9 years, a baseline eGFR <30 mL/min/1.73m 2 and/or receipt of renal replacement therapy (including long-term renal replacement therapy) at baseline will result in exclusion from receiving baricitinib" ;
    rcap:occurrenceKind "intervention_exclusion" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_IIM ;
    owl:annotatedTarget _:Na723c0522616450e9ac3ecb83b2c8980 ;
    rcap:evidenceDoc "Influenza Immune Modulation Domain-Specific Appendix 2.1" ;
    rcap:evidencePosition "lead_in:1" ;
    rcap:evidenceSection "8.3.4" ;
    rcap:evidenceText "The dose of baricitinib is dependent on age and renal function." ;
    rcap:occurrenceKind "intervention" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_IIM ;
    owl:annotatedTarget _:N4046ca3d24764b1ca3b4d7312da5c6c0 ;
    rcap:evidenceDoc "Influenza Immune Modulation Domain-Specific Appendix 2.1" ;
    rcap:evidencePosition "trailing:1" ;
    rcap:evidenceSection "8.5.2" ;
    rcap:evidenceText "An additional endpoint, that will be reported as it becomes available and only from sites where linked data is available, is occurrence of major adverse cardiovascular events." ;
    rcap:occurrenceKind "endpoint_secondary" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_IIM ;
    owl:annotatedTarget _:N731d1b0e37e5421f9c87e3f565a15607 ;
    rcap:evidenceDoc "Influenza Immune Modulation Domain-Specific Appendix 2.1" ;
    rcap:evidenceGlyph "•" ;
    rcap:evidencePage 27 ;
    rcap:evidencePosition "6" ;
    rcap:evidenceSection "8.2.3" ;
    rcap:evidenceText "In adults and in children ≥ 9 years of age, a baseline eGFR <15 mL/min/1.73m 2 and/or receipt of renal replacement therapy (including long-term renal replacement therapy) at baseline will result in exclusion from receiving baricitinib" ;
    rcap:occurrenceKind "intervention_exclusion" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_IIM ;
    owl:annotatedTarget _:N3a375a18e73b42a98e5d68537705b05d ;
    rcap:evidenceDoc "Influenza Immune Modulation Domain-Specific Appendix 2.1" ;
    rcap:evidencePosition "lead_in:4" ;
    rcap:evidenceSection "8.3.3" ;
    rcap:evidenceText "Tocilizumab will be commenced as soon as possible following reveal of allocation and administered as an intravenous infusion via a central or peripheral line over a one-hour period." ;
    rcap:occurrenceKind "intervention" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_IIM ;
    owl:annotatedTarget _:N4133527b36f14a9aab206d4b6573b9e4 ;
    rcap:evidenceDoc "Influenza Immune Modulation Domain-Specific Appendix 2.1" ;
    rcap:evidencePosition "lead_in:1" ;
    rcap:evidenceSection "10.4" ;
    rcap:evidenceText "The timing of the revealing of allocation status and administration of interventions is specified to be Randomization with Immediate Reveal and Initiation or Randomization with Deferred Reveal and Initiation if prospective agreement to participate is required for this domain (see relevant Core Protocol documents) or if the results of microbiological testing for influenza or SARS-CoV-2 or both are unavailable at the time of eligibility." ;
    rcap:occurrenceKind "allocation_reveal" .

