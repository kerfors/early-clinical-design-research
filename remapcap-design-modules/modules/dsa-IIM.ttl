[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_IIM ;
    owl:annotatedTarget _:N4cab9c7782ce4d2ba91ac757328cc71c ;
    rcap:evidenceDoc "Influenza Immune Modulation Domain-Specific Appendix 2.1" ;
    rcap:evidencePosition "lead_in:2" ;
    rcap:evidenceSection "8.3.1" ;
    rcap:evidenceText "The interventions will be commenced immediately after allocation status is revealed." ;
    rcap:occurrenceKind "intervention" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_IIM ;
    owl:annotatedTarget _:N77fd1cb152354aba9b7c6cffc464e451 ;
    rcap:evidenceDoc "Influenza Immune Modulation Domain-Specific Appendix 2.1" ;
    rcap:evidencePosition "lead_in:2" ;
    rcap:evidenceSection "8.3.5" ;
    rcap:evidenceText "The study interventions can be discontinued at any time by the treating clinician if doing so is regarded as being in the best interests of the patient." ;
    rcap:occurrenceKind "intervention" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_IIM ;
    owl:annotatedTarget _:Naf9ae2c36b9d4a66bc7746a4a01945c8 ;
    rcap:evidenceDoc "Influenza Immune Modulation Domain-Specific Appendix 2.1" ;
    rcap:evidencePosition "lead_in:14" ;
    rcap:evidenceSection "8.3.4" ;
    rcap:evidenceText "However, continued administration of the course of baricitinib after discharge from the participating clinical area is a clinical decision that is at the discretion of the treating clinician." ;
    rcap:occurrenceKind "intervention" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_IIM ;
    owl:annotatedTarget _:Ned35df00609549af8e6e2e8f36800ea6 ;
