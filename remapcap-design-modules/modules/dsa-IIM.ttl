    rcap:evidencePosition "lead_in:2" ;
    rcap:evidenceSection "8.3.4" ;
    rcap:evidenceText "The dose of baricitinib administered will depend on the most recent eGFR, including modification of dose for change in renal function during the treatment period." ;
    rcap:occurrenceKind "intervention" .

