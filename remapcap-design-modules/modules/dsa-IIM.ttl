    rcap:evidenceGlyph "•" ;
    rcap:evidencePage 26 ;
    rcap:evidencePosition "2" ;
    rcap:evidenceSection "8.2.2" ;
    rcap:evidenceText "More than 48 hours has elapsed since commencement of sustained organ failure support" ;
    rcap:occurrenceKind "domain_exclusion" .

