    rcap:evidencePage 26 ;
    rcap:evidencePosition "3" ;
    rcap:evidenceSection "8.2.2" ;
    rcap:evidenceText "Known condition or treatment resulting in ongoing immune suppression, including neutropenia, prior to this hospitalization" ;
    rcap:occurrenceKind "domain_exclusion" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_IIM ;
    owl:annotatedTarget _:N68a6bd2916f04d9b9159e9931436a629 ;
    rcap:evidenceDoc "Influenza Immune Modulation Domain-Specific Appendix 2.1" ;
    rcap:evidencePosition "lead_in:2" ;
    rcap:evidenceSection "8.3.3" ;
    rcap:evidenceText "Tocilizumab will be administered as a single dose of 8mg/kg based on measured body weight (or estimated body weight in adults if measured body weight is unavailable) with the total dose not exceeding 800mg." ;
    rcap:occurrenceKind "intervention" .

