[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_IIM ;
    owl:annotatedTarget _:N1334484ad3e748f4be86585c3826fcd3 ;
    rcap:evidenceDoc "Influenza Immune Modulation Domain-Specific Appendix 2.1" ;
    rcap:evidencePosition "lead_in:7" ;
    rcap:evidenceSection "8.3.4" ;
    rcap:evidenceText "In children 2 years to <9 years of age, baricitinib will be given at a dose of 1 mg daily if the eGFR is at least 30 and less than 60 mL/min/1.73m 2 ." ;
    rcap:occurrenceKind "intervention" .

