    rcap:evidenceSection "10.2" ;
    rcap:evidenceText "microbiological testing-confirmed influenza) and the Severe Illness Severity State." ;
    rcap:occurrenceKind "allocation_unit_of_analysis" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_IIM ;
    owl:annotatedTarget _:N1459a7e5e9674fa6b11cb77e6e3f9221 ;
    rcap:evidenceDoc "Influenza Immune Modulation Domain-Specific Appendix 2.1" ;
    rcap:evidencePosition "lead_in:1" ;
    rcap:evidenceSection "8.2.3" ;
    rcap:evidenceText "Patients may also be excluded from receiving one or more interventions within the domain for patient-specific reasons." ;
    rcap:occurrenceKind "intervention_exclusion" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_IIM ;
    owl:annotatedTarget _:N6ff04d5189324a0eac8449d10ba03abd ;
    rcap:evidenceDoc "Influenza Immune Modulation Domain-Specific Appendix 2.1" ;
    rcap:evidencePosition "lead_in:5" ;
    rcap:evidenceSection "8.3.3" ;
    rcap:evidenceText "The appropriate dose of drug will be mixed in a 100 ml bag of 0.9% saline, after removing an equivalent volume of saline, 0.4ml/kg, to match the added drug, so that the total volume is 100 mls." ;
    rcap:occurrenceKind "intervention" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_IIM ;
    owl:annotatedTarget _:N0ac04b3f43c44f9ba4e0979be2208b6a ;
    rcap:evidenceDoc "Influenza Immune Modulation Domain-Specific Appendix 2.1" ;
    rcap:evidencePosition "lead_in:4" ;
    rcap:evidenceSection "10.5" ;
    rcap:evidenceText "If an interaction is specified with a future domain, it is sufficient for the interaction to be specified only in the DSA of such a future domain." ;
    rcap:occurrenceKind "allocation_interactions" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_IIM ;
