    rcap:evidenceText "Patients are eligible for this domain only if they have been allocated a macrolide-containing intervention within an Antibiotic Domain of this Platform." ;
    rcap:occurrenceKind "domain_inclusion" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_MD ;
    owl:annotatedTarget _:Ncc0ea454abbc4cdc9826420a9309ff1a ;
    rcap:evidenceDoc "Macrolide Duration Domain-Specific Appendix 4" ;
    rcap:evidencePosition "lead_in:1" ;
    rcap:evidenceSection "8.1.2" ;
    rcap:evidenceText "This domain is available for patients who are in the Severe Illness Severity State, as defined in Core Protocol Documents." ;
    rcap:occurrenceKind "applicability_state" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_MD ;
    owl:annotatedTarget _:N86195bd8086a4838b8ac989563696cf6 ;
    rcap:evidenceDoc "Macrolide Duration Domain-Specific Appendix 4" ;
    rcap:evidencePosition "lead_in:1" ;
    rcap:evidenceSection "8.5.1" ;
    rcap:evidenceText "The primary endpoint for this domain is the primary outcome specified in Core Protocol." ;
    rcap:occurrenceKind "endpoint_primary" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_MD ;
    owl:annotatedTarget _:N7545d990903c467cb48166ff1d0eb084 ;
    rcap:evidenceDoc "Macrolide Duration Domain-Specific Appendix 4" ;
    rcap:evidencePosition "lead_in:1" ;
    rcap:evidenceSection "8.1.1" ;
    rcap:evidenceText "This domain is available to patients who are in the Adult Age Stratum, as defined in Core Protocol Documents." ;
    rcap:occurrenceKind "applicability_age" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_MD ;
    owl:annotatedTarget _:N8394a39d55b2476a9435a35660cb9fbd ;
    rcap:evidenceDoc "Macrolide Duration Domain-Specific Appendix 4" ;
    rcap:evidencePosition "lead_in:3" ;
    rcap:evidenceSection "8.3.3" ;
    rcap:evidenceText "If reveal of allocation occurs after Study Day 3, and the patient is allocated to standard course macrolide, discontinued immediately." ;
    rcap:occurrenceKind "intervention" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_MD ;
    owl:annotatedTarget _:N669171b46701490a909ef5e325a82a65 ;
    rcap:evidenceDoc "Macrolide Duration Domain-Specific Appendix 4" ;
    rcap:evidencePosition "lead_in:6" ;
    rcap:evidenceSection "8.3.4" ;
    rcap:evidenceText "In this regard, consideration should be given to the development of ventricular dysrhythmias and evaluation of the QT interval during the intervention period and prior to discontinuation of continuous ECG monitoring." ;
    rcap:occurrenceKind "intervention" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_MD ;
    owl:annotatedTarget _:Nf89f45c471284d25a798cde28d0d774b ;
    rcap:evidenceDoc "Macrolide Duration Domain-Specific Appendix 4" ;
    rcap:evidencePosition "lead_in:1" ;
    rcap:evidenceSection "9.2.1" ;
    rcap:evidenceText "In addition to Domain-specific data required as a consequence of participation in the Antibiotic Domain, patients who are randomized in this domain will have the following data collected:" ;
    rcap:occurrenceKind "data_collection" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_MD ;
    owl:annotatedTarget _:N5f3c6ee655fb43b899f9b639b2d4a5ff ;
    rcap:evidenceDoc "Macrolide Duration Domain-Specific Appendix 4" ;
    rcap:evidencePosition "lead_in:2" ;
    rcap:evidenceSection "10.2" ;
    rcap:evidenceText "No strata are applied, although this may be modified as an operational decision as specified in the Current State document." ;
    rcap:occurrenceKind "allocation_unit_of_analysis" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_MD ;
    owl:annotatedTarget _:Nf41c8f4486604175a6ddab8cbed24b68 ;
    rcap:evidenceDoc "Macrolide Duration Domain-Specific Appendix 4" ;
    rcap:evidencePosition "lead_in:1" ;
    rcap:evidenceSection "8.1.3" ;
    rcap:evidenceText "Domain-specific strata are not applied to patients at the time of assessment for this domain." ;
    rcap:occurrenceKind "domain_strata" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_MD ;
    owl:annotatedTarget _:N6599b036e7f8450caade16066cf20161 ;
    rcap:evidenceDoc "Macrolide Duration Domain-Specific Appendix 4" ;
    rcap:evidencePosition "trailing:3" ;
    rcap:evidenceSection "8.3.2" ;
    rcap:evidenceText "A switch from IV to enteral macrolide is permitted as directed by the treating clinician." ;
    rcap:occurrenceKind "intervention" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_MD ;
    owl:annotatedTarget _:Nab319cb34a5d441e940017b31dd3674c ;
    rcap:evidenceDoc "Macrolide Duration Domain-Specific Appendix 4" ;
    rcap:evidencePosition "lead_in:1" ;
    rcap:evidenceSection "10.4" ;
    rcap:evidenceText "The timing of the revealing of allocation status and administration of interventions is specified to be Randomization with Deferred Reveal once the results of microbiological testing to establish domain eligibility are available, or if prospective agreement to participate is required for this domain." ;
    rcap:occurrenceKind "allocation_reveal" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_MD ;
    owl:annotatedTarget _:Ne2f0340ce43e49d9a6edb2c1300076b3 ;
    rcap:evidenceDoc "Macrolide Duration Domain-Specific Appendix 4" ;
    rcap:evidencePosition "lead_in:1" ;
    rcap:evidenceSection "10.3" ;
    rcap:evidenceText "Response-adaptive randomization will be applied for this domain." ;
    rcap:occurrenceKind "allocation_rar" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_MD ;
    owl:annotatedTarget _:N0a56604ccfbe4bfeb1a590736897af57 ;
    rcap:evidenceDoc "Macrolide Duration Domain-Specific Appendix 4" ;
    rcap:evidencePosition "lead_in:3" ;
    rcap:evidenceSection "8.3.4" ;
    rcap:evidenceText "Any patient randomized to standard course macrolide, in whom legionellosis or another ‘atypical’ organism is diagnosed after cessation of macrolide, must commence treatment that is effective against the organisms such as a macrolide or fluoroquinolone." ;
    rcap:occurrenceKind "intervention" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_MD ;
    owl:annotatedTarget _:N983ac27f245542a0b650863ccfe95c0f ;
    rcap:evidenceDoc "Macrolide Duration Domain-Specific Appendix 4" ;
    rcap:evidencePosition "lead_in:2" ;
    rcap:evidenceSection "8.3.3" ;
    rcap:evidenceText "If reveal of allocation occurs before Study Day 3, and the patient is allocated to standard course macrolide, the intervention should be ceased on Study Day 3." ;
    rcap:occurrenceKind "intervention" .

