    rcap:evidencePosition "lead_in:5" ;
    rcap:evidenceSection "8.3.3" ;
    rcap:evidenceText "For participants discharged from hospital before the end of the allocated course of macrolide therapy, macrolides should be discontinued at hospital discharge." ;
    rcap:occurrenceKind "intervention" .

