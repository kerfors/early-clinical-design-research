    rcap:evidencePosition "lead_in:3" ;
    rcap:evidenceSection "8.3.1" ;
    rcap:evidenceText "The duration of macrolide therapy will then be determined by allocation in this domain." ;
    rcap:occurrenceKind "intervention" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_MD ;
    owl:annotatedTarget _:N6bbffd8424ed4858978f283bd5f9fa38 ;
    rcap:evidenceDoc "Macrolide Duration Domain-Specific Appendix 4" ;
    rcap:evidencePosition "trailing:2" ;
    rcap:evidenceSection "8.3.2" ;
    rcap:evidenceText "The dose of all macrolides is the same for IV and enteral administration and no dose adjustment is required for alterations in renal function including if the patient is receiving renal replacement therapy." ;
    rcap:occurrenceKind "intervention" .

