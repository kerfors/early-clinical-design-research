    rcap:evidencePage 17 ;
    rcap:evidencePosition "2" ;
    rcap:evidenceSection "8.3.2" ;
    rcap:evidenceText "The preferred IV macrolide is azithromycin, but IV clarithromycin may be substituted." ;
    rcap:occurrenceKind "intervention" .

