    rcap:evidenceSection "8.3.4" ;
    rcap:evidenceText "All use of systemic corticosteroids is recorded and the reason for any administration after Study Day 10 will be documented." ;
    rcap:occurrenceKind "intervention" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_CS ;
    owl:annotatedTarget _:N87ead87c0fbc4465a2d3b2eef33d48ce ;
    rcap:evidenceDoc "Corticosteroid Domain-Specific Appendix 6" ;
    rcap:evidenceGlyph "•" ;
    rcap:evidencePage 23 ;
    rcap:evidencePosition "1" ;
    rcap:evidenceSection "8.2.1" ;
    rcap:evidenceText "Patient is aged ≥ 28 days old (corrected gestational age)" ;
    rcap:occurrenceKind "domain_inclusion" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_CS ;
    owl:annotatedTarget _:N32077e468fe94588824c920f547aa370 ;
    rcap:evidenceDoc "Corticosteroid Domain-Specific Appendix 6" ;
    rcap:evidencePosition "lead_in:1" ;
    rcap:evidenceSection "10.4" ;
    rcap:evidenceText "The timing of the revealing of allocation status and administration of interventions is specified to be Randomization with Immediate Reveal and Initiation or Randomization with Deferred Reveal and Initiation if prospective agreement to participate is required for this domain (see relevant Core Protocol documents)." ;
    rcap:occurrenceKind "allocation_reveal" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_CS ;
    owl:annotatedTarget _:N76694c4b9b54485081ca39b0b02418f5 ;
    rcap:evidenceDoc "Corticosteroid Domain-Specific Appendix 6" ;
    rcap:evidencePosition "lead_in:3" ;
    rcap:evidenceSection "8.3.5" ;
    rcap:evidenceText "If septic shock develops due to a cause other than the respiratory tract infection, administration of corticosteroids is at the discretion of the treating clinician." ;
    rcap:occurrenceKind "intervention" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_CS ;
    owl:annotatedTarget _:Nccdab1c7b94e49a2a3a68e6a64435e88 ;
    rcap:evidenceDoc "Corticosteroid Domain-Specific Appendix 6" ;
    rcap:evidencePosition "lead_in:2" ;
    rcap:evidenceSection "10.5" ;
    rcap:evidenceText "If an interaction is specified with a future domain, it is sufficient for the interaction to be specified only in the DSA or such a future domain." ;
    rcap:occurrenceKind "allocation_interactions" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_CS ;
    owl:annotatedTarget _:Nf23dc0a41a784b77a95880568b943c07 ;
    rcap:evidenceDoc "Corticosteroid Domain-Specific Appendix 6" ;
    rcap:evidencePosition "lead_in:4" ;
    rcap:evidenceSection "8.3.4" ;
    rcap:evidenceText "In children the dose of dexamethasone will be 0.15 mg/kg (max 6mg/day) for a maximum of 10 days while in hospital." ;
    rcap:occurrenceKind "intervention" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_CS ;
    owl:annotatedTarget _:N4d1eae9a2c9c4cc4bab720cf1b754e7a ;
    rcap:evidenceDoc "Corticosteroid Domain-Specific Appendix 6" ;
    rcap:evidencePosition "lead_in:1" ;
    rcap:evidenceSection "10.3" ;
    rcap:evidenceText "Response Adaptive Randomization may be applied." ;
    rcap:occurrenceKind "allocation_rar" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_CS ;
    owl:annotatedTarget _:N34e1c6f056104852aae053bb372ee070 ;
    rcap:evidenceDoc "Corticosteroid Domain-Specific Appendix 6" ;
    rcap:evidenceGlyph "•" ;
    rcap:evidencePage 23 ;
    rcap:evidencePosition "3" ;
    rcap:evidenceSection "8.2.2" ;
    rcap:evidenceText "Known hypersensitivity to any corticosteroid" ;
    rcap:occurrenceKind "domain_exclusion" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_CS ;
    owl:annotatedTarget _:N5c84ecd838e14360a741568066bb8445 ;
    rcap:evidenceDoc "Corticosteroid Domain-Specific Appendix 6" ;
    rcap:evidencePosition "trailing:3" ;
    rcap:evidenceSection "8.5.2" ;
    rcap:evidenceText "It is not an objective of this trial to re-evaluate these questions but determine the aggregate effect of treatment with corticosteroids on mortality." ;
    rcap:occurrenceKind "endpoint_secondary" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_CS ;
    owl:annotatedTarget _:N66d9e97bc34f420993a9f40b16b6497d ;
    rcap:evidenceDoc "Corticosteroid Domain-Specific Appendix 6" ;
    rcap:evidencePosition "trailing:4" ;
    rcap:evidenceSection "8.5.2" ;
    rcap:evidenceText "It is also known that treatment with corticosteroids can result in myopathy and muscle weakness but this effect will be evaluated by the aggregate effect of treatment, in conjunction with other factors, on the duration of mechanical ventilation and long-term outcomes, for participants enrolled at sites that are collecting long-term outcomes." ;
    rcap:occurrenceKind "endpoint_secondary" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_CS ;
    owl:annotatedTarget _:N0c04e1ea6c784c62addff5968b8e347b ;
    rcap:evidenceDoc "Corticosteroid Domain-Specific Appendix 6" ;
    rcap:evidencePosition "lead_in:2" ;
    rcap:evidenceSection "10.4" ;
    rcap:evidenceText "For patients allocated to the shock-dependent duration hydrocortisone intervention, who are not in septic shock at the time of randomization, Immediate Reveal and Initiation is interpreted as intention to commence hydrocortisone if and when septic shock develops." ;
    rcap:occurrenceKind "allocation_reveal" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_CS ;
    owl:annotatedTarget _:Ne032462422214814b045d224694f76ba ;
    rcap:evidenceDoc "Corticosteroid Domain-Specific Appendix 6" ;
    rcap:evidencePosition "lead_in:1" ;
    rcap:evidenceSection "10.2" ;
    rcap:evidenceText "The unit-of-analysis for this domain corresponds to the patients who receive an allocation in this domain, further subdivided by the combination of: Influenza Infection Confirmed Strata (defined as Influenza Infection Confirmed or Influenza Infection Not Confirmed); Shock Strata (defined as Shock Present or Shock Absent); Age Strata (defined as Pediatric, or combined Adolescent and Adult Age Strata); and Illness Severity State (defined as Moderate or Severe State)." ;
    rcap:occurrenceKind "allocation_unit_of_analysis" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_CS ;
    owl:annotatedTarget _:Na65aa264ac06484c81c8f67ac3ace64b ;
    rcap:evidenceDoc "Corticosteroid Domain-Specific Appendix 6" ;
    rcap:evidencePosition "lead_in:11" ;
    rcap:evidenceSection "8.3.3" ;
    rcap:evidenceText "If, after cessation of hydrocortisone, there is redevelopment of septic shock due to CAP (as defined above), then hydrocortisone IV 50 mg every 6 hours is to be recommenced until resolution." ;
    rcap:occurrenceKind "intervention" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_CS ;
    owl:annotatedTarget _:Nee33140c5549491da3900cc3d56d89c5 ;
    rcap:evidenceDoc "Corticosteroid Domain-Specific Appendix 6" ;
    rcap:evidencePosition "lead_in:2" ;
    rcap:evidenceSection "8.5.2" ;
    rcap:evidenceText "The domain-specific secondary outcome measures (occurring during the index hospitalization, censored at 90 days after enrollment) will be:" ;
    rcap:occurrenceKind "endpoint_secondary" .

