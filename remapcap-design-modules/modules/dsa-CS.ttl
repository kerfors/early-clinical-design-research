    rcap:evidencePosition "1" ;
    rcap:evidenceSection "9.2.1" ;
    rcap:evidenceText "Administration of systemic corticosteroids" ;
    rcap:occurrenceKind "data_collection" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_CS ;
    owl:annotatedTarget _:Na308aaa52872491f88900909fff06f1b ;
    rcap:evidenceDoc "Corticosteroid Domain-Specific Appendix 6" ;
    rcap:evidenceGlyph "•" ;
    rcap:evidencePage 23 ;
    rcap:evidencePosition "6" ;
    rcap:evidenceSection "8.2.2" ;
    rcap:evidenceText "The treating clinician believes that participation in the domain would not be in the best interests of the patient" ;
    rcap:occurrenceKind "domain_exclusion" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_CS ;
    owl:annotatedTarget _:Nd0de5bcd32f84c3e85754f88fb9c7451 ;
    rcap:evidenceDoc "Corticosteroid Domain-Specific Appendix 6" ;
    rcap:evidencePosition "lead_in:3" ;
    rcap:evidenceSection "10.3" ;
    rcap:evidenceText "If required, any such modifications will be an operational decision of the Design Team specified in the Current State document and applied by the SAC." ;
    rcap:occurrenceKind "allocation_rar" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_CS ;
    owl:annotatedTarget _:N9906559377744f2f9280a5de919f4b03 ;
    rcap:evidenceDoc "Corticosteroid Domain-Specific Appendix 6" ;
    rcap:evidencePosition "lead_in:10" ;
    rcap:evidenceSection "8.3.3" ;
    rcap:evidenceText "A clinician may regard septic shock to have resolved if vasopressor infusion is being administered intermittently or at sufficiently low dose." ;
    rcap:occurrenceKind "intervention" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_CS ;
    owl:annotatedTarget _:N94443b63b2f249c19f7d6b5886e64d25 ;
    rcap:evidenceDoc "Corticosteroid Domain-Specific Appendix 6" ;
    rcap:evidencePosition "lead_in:2" ;
    rcap:evidenceSection "8.3.5" ;
    rcap:evidenceText "The interventions in this domain apply up until study day 28 during the index hospitalization, noting that the criteria related to respiratory tract infection and its direct complications still apply." ;
    rcap:occurrenceKind "intervention" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_CS ;
    owl:annotatedTarget _:Ne356a0d3f74a4d6394fbbc1936c94814 ;
    rcap:evidenceDoc "Corticosteroid Domain-Specific Appendix 6" ;
    rcap:evidencePosition "lead_in:1" ;
    rcap:evidenceSection "10.5" ;
    rcap:evidenceText "Interactions with all other domains are either not evaluable or not considered possible and will not be incorporated into the statistical model or models in which this domain is evaluated." ;
    rcap:occurrenceKind "allocation_interactions" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_CS ;
    owl:annotatedTarget _:N60716f2057ef47e2b38175ee1e7004c0 ;
    rcap:evidenceDoc "Corticosteroid Domain-Specific Appendix 6" ;
    rcap:evidencePosition "lead_in:9" ;
    rcap:evidenceSection "8.3.4" ;
    rcap:evidenceText "In particular longer courses of corticosteroids should be avoided in very young infants." ;
    rcap:occurrenceKind "intervention" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_CS ;
    owl:annotatedTarget _:Na10b6305410e4a43a427317969ee116a ;
    rcap:evidenceDoc "Corticosteroid Domain-Specific Appendix 6" ;
    rcap:evidencePosition "lead_in:2" ;
    rcap:evidenceSection "8.3.4" ;
    rcap:evidenceText "Administration is to commence immediately after reveal of allocation." ;
    rcap:occurrenceKind "intervention" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_CS ;
    owl:annotatedTarget _:N52cecc3c342649728bc2f63f9f7af029 ;
    rcap:evidenceDoc "Corticosteroid Domain-Specific Appendix 6" ;
    rcap:evidenceGlyph "☐" ;
    rcap:evidencePage 24 ;
    rcap:evidencePosition "3" ;
    rcap:evidenceSection "8.3.1" ;
    rcap:evidenceText "Fixed duration dexamethasone for 10 days" ;
    rcap:occurrenceKind "intervention" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:Domain_CS ;
    owl:annotatedTarget _:N73a47666cd764027b1579ee6dbec9552 ;
    rcap:evidenceDoc "Corticosteroid Domain-Specific Appendix 6" ;
    rcap:evidenceGlyph "☐" ;
    rcap:evidencePage 24 ;
    rcap:evidenceRule "B-domain" ;
    rcap:evidenceSection "8.3.1" ;
    rcap:evidenceText "Shock-dependent hydrocortisone while the patient is in septic shock (Severe State only)" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_CS ;
    owl:annotatedTarget _:N95347ae284af445aa95aa950f4ed64f7 ;
    rcap:evidenceDoc "Corticosteroid Domain-Specific Appendix 6" ;
    rcap:evidencePosition "lead_in:1" ;
    rcap:evidenceSection "8.1.3" ;
    rcap:evidenceText "Domain-specific strata are not applied to patients at the time of assessment for this domain." ;
    rcap:occurrenceKind "domain_strata" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_CS ;
    owl:annotatedTarget _:N75cdb74277f64fa8abb751801a94fb5a ;
    rcap:evidenceDoc "Corticosteroid Domain-Specific Appendix 6" ;
    rcap:evidenceGlyph "•" ;
    rcap:evidencePage 24 ;
    rcap:evidencePosition "1" ;
    rcap:evidenceSection "8.2.3" ;
    rcap:evidenceText "It is recognized that there is a wide range of regulatory approaches and attitudes to the evaluation of interventions in pregnant trial participants across participating regions and sites. Known or suspected pregnancy is not an intervention-level exclusion for the fixed-course dexamethasone intervention by default; however, if a site does not have regulatory approval to enroll pregnant patients to the fixed-course dexamethasone intervention, known or suspected pregnancy will be applied as an intervention-specific exclusion and will result in exclusion from the fixed course dexamethasone intervention." ;
    rcap:occurrenceKind "intervention_exclusion" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_CS ;
    owl:annotatedTarget _:Nd08a6b30f9ee405f99d27ea0d25546c0 ;
    rcap:evidenceDoc "Corticosteroid Domain-Specific Appendix 6" ;
    rcap:evidencePosition "lead_in:7" ;
    rcap:evidenceSection "8.3.3" ;
    rcap:evidenceText "Dosage guidance of vasopressor for initiation of corticosteroids for this intervention is described in a separate operational document." ;
    rcap:occurrenceKind "intervention" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_CS ;
    owl:annotatedTarget _:N527fb2436be94246b770c48ee54a02f9 ;
    rcap:evidenceDoc "Corticosteroid Domain-Specific Appendix 6" ;
    rcap:evidencePosition "lead_in:1" ;
    rcap:evidenceSection "10.7" ;
    rcap:evidenceText "The threshold probability for statistical triggers for superiority, efficacy, and inferiority, are those specified in the relevant Core Protocol documents." ;
    rcap:occurrenceKind "allocation_threshold" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_CS ;
    owl:annotatedTarget _:Nfc43b6ba40954d45a16ccb46241973b5 ;
    rcap:evidenceDoc "Corticosteroid Domain-Specific Appendix 6" ;
    rcap:evidencePosition "lead_in:6" ;
    rcap:evidenceSection "8.3.4" ;
    rcap:evidenceText "In pregnancy dexamethasone should be replaced by oral prednisolone 40mg once daily or IV hydrocortisone 50mg every 6 hours for 10 days while in hospital." ;
    rcap:occurrenceKind "intervention" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_CS ;
    owl:annotatedTarget _:N2da5c8e8ee5c4be8bd127bef15a59a76 ;
    rcap:evidenceDoc "Corticosteroid Domain-Specific Appendix 6" ;
    rcap:evidencePosition "lead_in:6" ;
    rcap:evidenceSection "8.3.3" ;
    rcap:evidenceText "The rationale for avoiding an exact dose is because no particular dose signifies 'shock' unambiguously." ;
    rcap:occurrenceKind "intervention" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_CS ;
    owl:annotatedTarget _:Nf16116fbc4fc4ea58fa4ff1b843b563e ;
    rcap:evidenceDoc "Corticosteroid Domain-Specific Appendix 6" ;
    rcap:evidenceGlyph "•" ;
    rcap:evidencePage 23 ;
    rcap:evidencePosition "1" ;
    rcap:evidenceSection "8.2.2" ;
    rcap:evidenceText "Confirmed SARS-CoV-2 infection" ;
    rcap:occurrenceKind "domain_exclusion" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_CS ;
    owl:annotatedTarget _:Nddf0ed6cad5c4b75abeb4210f3cf3310 ;
    rcap:evidenceDoc "Corticosteroid Domain-Specific Appendix 6" ;
    rcap:evidencePosition "lead_in:5" ;
    rcap:evidenceSection "8.2.3" ;
    rcap:evidenceText "Criteria that exclude a patient from a one or more interventions are:" ;
    rcap:occurrenceKind "intervention_exclusion" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_CS ;
    owl:annotatedTarget _:Nfb3771416d7e495e9808477b76fa6ea2 ;
    rcap:evidenceDoc "Corticosteroid Domain-Specific Appendix 6" ;
    rcap:evidencePosition "lead_in:2" ;
    rcap:evidenceSection "8.3.3" ;
    rcap:evidenceText "Patients allocated to the shock-dependent duration hydrocortisone intervention, will receive hydrocortisone, IV 50 mg every 6 hours, commenced if septic shock develops as a result of the patient’s respiratory tract infection, up until study day 28." ;
    rcap:occurrenceKind "intervention" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_CS ;
    owl:annotatedTarget _:N612d6273448a4ed8af5df0163051da69 ;
    rcap:evidenceDoc "Corticosteroid Domain-Specific Appendix 6" ;
    rcap:evidencePosition "lead_in:1" ;
    rcap:evidenceSection "8.3.5" ;
    rcap:evidenceText "For all patients in this domain who remain in hospital after study day 28, data on the administration of corticosteroids are not collected, and administration of corticosteroids after study day 28 is at the discretion of the treating clinician." ;
    rcap:occurrenceKind "intervention" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_CS ;
    owl:annotatedTarget _:N7f42b0890245442f84717a7b28787c66 ;
    rcap:evidenceDoc "Corticosteroid Domain-Specific Appendix 6" ;
    rcap:evidencePosition "lead_in:3" ;
    rcap:evidenceSection "8.2.3" ;
    rcap:evidenceText "Patients who are eligible for only a single intervention at a site (i.e., all other interventions are contraindicated) are not eligible for this domain." ;
    rcap:occurrenceKind "intervention_exclusion" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_CS ;
    owl:annotatedTarget _:Nde3b97aea2354fb690787cb7b1cfb6dd ;
    rcap:evidenceDoc "Corticosteroid Domain-Specific Appendix 6" ;
    rcap:evidencePosition "lead_in:5" ;
    rcap:evidenceSection "8.3.2" ;
    rcap:evidenceText "All use of systemic corticosteroids is recorded and the reason for any administration will be documented." ;
    rcap:occurrenceKind "intervention" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_CS ;
    owl:annotatedTarget _:Ne36b4b14ec694fd48c608ad12549db65 ;
    rcap:evidenceDoc "Corticosteroid Domain-Specific Appendix 6" ;
    rcap:evidenceGlyph "•" ;
    rcap:evidencePage 27 ;
    rcap:evidencePosition "2" ;
    rcap:evidenceSection "9.2.1" ;
    rcap:evidenceText "Administration of etomidate between index hospital admission and randomization, and between randomization and the end of study day 8" ;
    rcap:occurrenceKind "data_collection" .

