[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_CS ;
    owl:annotatedTarget _:N94877cc9b4f8490f90e74687bddf351c ;
    rcap:evidenceDoc "Corticosteroid Domain-Specific Appendix 6" ;
    rcap:evidencePosition "lead_in:2" ;
    rcap:evidenceSection "10.8" ;
    rcap:evidenceText "The size of the pre-specified odds ratio delta is 0.10." ;
    rcap:occurrenceKind "allocation_threshold" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_CS ;
    owl:annotatedTarget _:Nd8152d8ff28d43e085c16232dbc369eb ;
    rcap:evidenceDoc "Corticosteroid Domain-Specific Appendix 6" ;
    rcap:evidencePosition "lead_in:1" ;
    rcap:evidenceSection "8.5.1" ;
    rcap:evidenceText "The primary endpoint for this domain is the primary outcome as specified in Core Protocol documents." ;
    rcap:occurrenceKind "endpoint_primary" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_CS ;
    owl:annotatedTarget _:Nea955766c386405d9ca7d93db893e6a4 ;
    rcap:evidenceDoc "Corticosteroid Domain-Specific Appendix 6" ;
    rcap:evidencePosition "lead_in:1" ;
    rcap:evidenceSection "8.2.3" ;
    rcap:evidenceText "Patients may also be excluded from receiving one or more interventions within the domain for patient-specific reasons." ;
    rcap:occurrenceKind "intervention_exclusion" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_CS ;
    owl:annotatedTarget _:N3f2bc7c4cdf745d5b7151aeec57d329c ;
    rcap:evidenceDoc "Corticosteroid Domain-Specific Appendix 6" ;
    rcap:evidencePosition "lead_in:9" ;
    rcap:evidenceSection "8.3.3" ;
    rcap:evidenceText "Septic shock would always be regarded as having resolved if vasopressor infusion has not been administered in the preceding 24 hours." ;
    rcap:occurrenceKind "intervention" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_CS ;
    owl:annotatedTarget _:Nef8ef2fa9eb34c668ac2d41ee261a5a8 ;
    rcap:evidenceDoc "Corticosteroid Domain-Specific Appendix 6" ;
    rcap:evidencePosition "lead_in:2" ;
    rcap:evidenceSection "8.1.1" ;
    rcap:evidenceText "Eligibility within each stratum may be further constrained by domain-specific eligibility criteria specified below." ;
    rcap:occurrenceKind "applicability_age" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_CS ;
    owl:annotatedTarget _:N9bd549b10ee74afc8e19841949e2152f ;
    rcap:evidenceDoc "Corticosteroid Domain-Specific Appendix 6" ;
