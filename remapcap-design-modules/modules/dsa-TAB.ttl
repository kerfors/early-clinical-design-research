[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_TAB ;
    owl:annotatedTarget _:Na540c13d58854fea9b4f4dfc919ada18 ;
    rcap:evidenceDoc "Tropical Antibiotic Domain-Specific Appendix 1" ;
    rcap:evidenceGlyph "o" ;
    rcap:evidencePage 19 ;
    rcap:evidencePosition "6" ;
    rcap:evidenceSection "8.2.2" ;
    rcap:evidenceText "Febrile neutropenia or significant immunosuppression (including organ or bone marrow transplantation, human immunodeficiency virus infection with CD4 cell count <200 cells/µL, systemic immunosuppressive, systemic corticosteroids comprising prednisolone, or equivalent, ≥20mg/day for > 4 preceding weeks)." ;
