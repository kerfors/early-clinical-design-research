[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_TAB ;
    owl:annotatedTarget _:N1b7b0a92ed30436db38fbdc2bba42f71 ;
    rcap:evidenceDoc "Tropical Antibiotic Domain-Specific Appendix 1" ;
    rcap:evidencePosition "lead_in:1" ;
    rcap:evidenceSection "8.2.3" ;
    rcap:evidenceText "Patients may also be excluded from receiving one or both interventions within the domain for patient-specific reasons." ;
    rcap:occurrenceKind "intervention_exclusion" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_TAB ;
    owl:annotatedTarget _:Ne94354a9f0214308974244c289582fe4 ;
    rcap:evidenceDoc "Tropical Antibiotic Domain-Specific Appendix 1" ;
    rcap:evidencePosition "lead_in:1" ;
    rcap:evidenceSection "8.3.6" ;
    rcap:evidenceText "Antibiotic therapy should be discontinued if there is development of a SAE which, in the opinion of the treating clinician, could be related to participation in this domain." ;
    rcap:occurrenceKind "intervention" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_TAB ;
    owl:annotatedTarget _:N999a9156c30c42a091ea92f7bc66e9f0 ;
    rcap:evidenceDoc "Tropical Antibiotic Domain-Specific Appendix 1" ;
    rcap:evidencePosition "lead_in:1" ;
    rcap:evidenceSection "10.2" ;
    rcap:evidenceText "The unit-of-analysis for this domain is all patients who receive an allocation status in this domain." ;
    rcap:occurrenceKind "allocation_unit_of_analysis" .

