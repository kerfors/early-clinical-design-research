    rcap:evidencePosition "lead_in:4" ;
    rcap:evidenceSection "8.2.3" ;
    rcap:evidenceText "Patients in whom all interventions are contraindicated will be treated according to the current standard of care at the clinician’s discretion." ;
    rcap:occurrenceKind "intervention_exclusion" .

