[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_TAB ;
    owl:annotatedTarget _:Ncebe1f86079046b6a936868aa0c36e4a ;
    rcap:evidenceDoc "Tropical Antibiotic Domain-Specific Appendix 1" ;
    rcap:evidenceGlyph "•" ;
    rcap:evidencePage 19 ;
    rcap:evidencePosition "1" ;
    rcap:evidenceSection "8.2.1" ;
    rcap:evidenceText "Patient has community-acquired respiratory tract infection" ;
    rcap:occurrenceKind "domain_inclusion" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_TAB ;
    owl:annotatedTarget _:Ncfe6b736aa924c30b91bf94d715458cd ;
    rcap:evidenceDoc "Tropical Antibiotic Domain-Specific Appendix 1" ;
    rcap:evidenceGlyph "o" ;
    rcap:evidencePage 19 ;
    rcap:evidencePosition "5" ;
    rcap:evidenceSection "8.2.2" ;
    rcap:evidenceText "Suspected or proven infection with resistant bacteria where agents being trialed would not be expected to be active. This includes cystic fibrosis, bronchiectasis or other chronic suppurative lung disease where infection with Pseudomonas may be suspected but does not include patients with suspected methicillin-resistant staphylococcus aureus (MRSA) infection*." ;
    rcap:occurrenceKind "domain_exclusion" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_TAB ;
    owl:annotatedTarget _:N289b8b4b1012441fac0403589bb19dcc ;
    rcap:evidenceDoc "Tropical Antibiotic Domain-Specific Appendix 1" ;
    rcap:evidencePosition "lead_in:2" ;
    rcap:evidenceSection "8.3.3" ;
    rcap:evidenceText "As such, most patients who receive an allocation within this domain will have already received empiric antibiotic therapy prior to enrollment." ;
    rcap:occurrenceKind "intervention" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_TAB ;
    owl:annotatedTarget _:N8d68e2a4721144e8bdb26e91e0eb30aa ;
    rcap:evidenceDoc "Tropical Antibiotic Domain-Specific Appendix 1" ;
    rcap:evidencePosition "lead_in:1" ;
    rcap:evidenceSection "8.5.1" ;
    rcap:evidenceText "The primary endpoint for this domain is the primary outcome specified in the Core Protocol." ;
    rcap:occurrenceKind "endpoint_primary" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_TAB ;
    owl:annotatedTarget _:Nc67bb5d9517f49ad9a9ed8b8eb3fccf5 ;
    rcap:evidenceDoc "Tropical Antibiotic Domain-Specific Appendix 1" ;
    rcap:evidenceGlyph "•" ;
    rcap:evidencePage 20 ;
    rcap:evidencePosition "3" ;
    rcap:evidenceSection "8.2.3" ;
    rcap:evidenceText "Known serious hypersensitivity to macrolides will result in exclusion from interventions that include macrolides" ;
    rcap:occurrenceKind "intervention_exclusion" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_TAB ;
    owl:annotatedTarget _:N50df2b15d820498c8deee652b47e0b23 ;
    rcap:evidenceDoc "Tropical Antibiotic Domain-Specific Appendix 1" ;
    rcap:evidencePage 22 ;
    rcap:evidencePosition "2" ;
    rcap:evidenceSection "8.3.5" ;
    rcap:evidenceText "IV clarithromycin, with switch to enteral azithromycin when appropriate" ;
    rcap:occurrenceKind "intervention" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_TAB ;
    owl:annotatedTarget _:Nf21903a43b614cfba0f08ac058971a57 ;
    rcap:evidenceDoc "Tropical Antibiotic Domain-Specific Appendix 1" ;
    rcap:evidencePosition "lead_in:3" ;
    rcap:evidenceSection "8.2.3" ;
    rcap:evidenceText "Patients who are eligible for only a single intervention at a site (i.e., all other interventions are contraindicated) are not eligible for this domain." ;
    rcap:occurrenceKind "intervention_exclusion" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_TAB ;
    owl:annotatedTarget _:N077027092fb54de6957d6697a38c4722 ;
    rcap:evidenceDoc "Tropical Antibiotic Domain-Specific Appendix 1" ;
    rcap:evidencePosition "lead_in:1" ;
    rcap:evidenceSection "8.1.1" ;
    rcap:evidenceText "This domain is available to patients who are in the Adult Age Stratum, as defined in Core Protocol documents." ;
    rcap:occurrenceKind "applicability_age" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_TAB ;
    owl:annotatedTarget _:N497d6727409644368f40b646c560d1d2 ;
    rcap:evidenceDoc "Tropical Antibiotic Domain-Specific Appendix 1" ;
    rcap:evidencePosition "lead_in:1" ;
    rcap:evidenceSection "10.3" ;
    rcap:evidenceText "Response-adaptive randomization will be not be applied to this domain." ;
    rcap:occurrenceKind "allocation_rar" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_TAB ;
    owl:annotatedTarget _:N59979a9707224279a9add1d77f9cf625 ;
    rcap:evidenceDoc "Tropical Antibiotic Domain-Specific Appendix 1" ;
    rcap:evidenceGlyph "•" ;
    rcap:evidencePage 22 ;
    rcap:evidencePosition "2" ;
    rcap:evidenceSection "8.3.4" ;
    rcap:evidenceText "Change to enteral antibiotics once the patient is clinically stable." ;
    rcap:occurrenceKind "intervention" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_TAB ;
    owl:annotatedTarget _:Nae1b7773133a4b73ab410ff429664cb7 ;
    rcap:evidenceDoc "Tropical Antibiotic Domain-Specific Appendix 1" ;
    rcap:evidencePosition "lead_in:1" ;
    rcap:evidenceSection "8.1.3" ;
    rcap:evidenceText "Domain-specific strata are not applied to patients at the time of assessment for this domain." ;
    rcap:occurrenceKind "domain_strata" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_TAB ;
    owl:annotatedTarget _:N634fcb6541c54f78ad85d22bf2af4550 ;
    rcap:evidenceDoc "Tropical Antibiotic Domain-Specific Appendix 1" ;
    rcap:evidenceGlyph "o" ;
    rcap:evidencePage 19 ;
    rcap:evidencePosition "7" ;
    rcap:evidenceSection "8.2.2" ;
    rcap:evidenceText "There is sufficient microbiological information to guide specific antibacterial therapy" ;
    rcap:occurrenceKind "domain_exclusion" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_TAB ;
    owl:annotatedTarget _:N55cb38b35d174d9e8fafc0c9c4c222ff ;
    rcap:evidenceDoc "Tropical Antibiotic Domain-Specific Appendix 1" ;
    rcap:evidencePosition "trailing:3" ;
    rcap:evidenceSection "8.3.2" ;
    rcap:evidenceText "If administered by continuous infusion, the recommended daily dosing is the cumulative dose given in a 24-hour period in the intermittent IV dosing regimens outlined above." ;
    rcap:occurrenceKind "intervention" .

