[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_TAB ;
    owl:annotatedTarget _:Ndf6e3732694b4998ac3017e624c70692 ;
    rcap:evidenceDoc "Tropical Antibiotic Domain-Specific Appendix 1" ;
    rcap:evidencePosition "lead_in:1" ;
    rcap:evidenceSection "8.3.3" ;
    rcap:evidenceText "In keeping with all international guidelines optimized empiric antibiotic treatment should commence as soon as possible." ;
    rcap:occurrenceKind "intervention" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_TAB ;
    owl:annotatedTarget _:N0efc12e2e5394e0ab14c576faf948d8f ;
    rcap:evidenceDoc "Tropical Antibiotic Domain-Specific Appendix 1" ;
    rcap:evidencePosition "trailing:1" ;
    rcap:evidenceSection "8.3.5" ;
    rcap:evidenceText "Vancomycin, linezolid or other antimicrobials active against MRSA may be added if MRSA is suspected at the discretion of the treating clinician, irrespective of the intervention to which the participant is allocated." ;
    rcap:occurrenceKind "intervention" .

