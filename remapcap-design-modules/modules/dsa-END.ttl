    rcap:evidencePosition "lead_in:3" ;
    rcap:evidenceSection "10.3" ;
    rcap:evidenceText "If required, any such modifications will be an operational decision of the Design Team specified in the Current State document and applied by the SAC." ;
    rcap:occurrenceKind "allocation_rar" .

