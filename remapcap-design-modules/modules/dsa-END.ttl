    rcap:evidenceGlyph "•" ;
    rcap:evidencePage 28 ;
    rcap:evidencePosition "6" ;
    rcap:evidenceSection "8.2.3" ;
    rcap:evidenceText "A baseline platelet count <50 x10 9 /L will exclude a patient from receiving enteral imatinib" ;
    rcap:occurrenceKind "intervention_exclusion" .

