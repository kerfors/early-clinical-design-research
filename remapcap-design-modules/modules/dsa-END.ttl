    rcap:evidencePosition "lead_in:1" ;
    rcap:evidenceSection "8.3.4" ;
    rcap:evidenceText "Enteral imatinib will be administered for a total of 14 days or until hospital discharge, whichever occurs first." ;
    rcap:occurrenceKind "intervention" .

