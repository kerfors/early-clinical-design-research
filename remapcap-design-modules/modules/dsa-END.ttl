[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_END ;
    owl:annotatedTarget _:N17a78783160a4d208a2c4b1548e13365 ;
    rcap:evidenceDoc "Endothelial Modulation Domain-Specific Appendix 2" ;
    rcap:evidencePosition "lead_in:1" ;
    rcap:evidenceSection "8.2.3" ;
    rcap:evidenceText "Patients may also be excluded from receiving one or more interventions within the domain for patient-specific reasons." ;
    rcap:occurrenceKind "intervention_exclusion" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_END ;
    owl:annotatedTarget _:N79f61b09528b49789866e17dc55fa50e ;
    rcap:evidenceDoc "Endothelial Modulation Domain-Specific Appendix 2" ;
    rcap:evidenceGlyph "•" ;
    rcap:evidencePage 28 ;
    rcap:evidencePosition "2" ;
    rcap:evidenceSection "8.2.3" ;
    rcap:evidenceText "Known or suspected pregnancy or breast-feeding will exclude a patient from receiving enteral imatinib. It is normal practice that women admitted who are in an age group in which pregnancy is considered possible will have a pregnancy test conducted. The results of such tests will be used to determine interpretation of this exclusion criteria" ;
    rcap:occurrenceKind "intervention_exclusion" .

