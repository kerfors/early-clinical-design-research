    rcap:evidenceGlyph "•" ;
    rcap:evidencePage 29 ;
    rcap:evidencePosition "1" ;
    rcap:evidenceSection "8.3.6" ;
    rcap:evidenceText "If a patient develops neutropenia (neutrophil count <1.0 x 10 9 /L) and/or thrombocytopenia (platelet count <50 x 10 9 /L), stop imatinib and do not restart" ;
    rcap:occurrenceKind "intervention" .

