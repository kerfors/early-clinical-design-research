rcap:delegation-cdb7e701f1 a owl:NamedIndividual,
        rcap:DelegationReading ;
    rcap:allocationKind "delegation" ;
    rcap:coreSentence40 "Whether nested analysis will be performed and, if so, the membership of category of more similar interventions will be specified in the DSA." ;
    rcap:evidenceDoc "COVID-19 Immunoglobulin Therapy Domain-Specific Appendix 4" ;
    rcap:evidenceSection "10.6" ;
    rcap:evidenceText "Following any Platform Conclusion in this domain, a sensitivity analysis will be conducted that is restricted to patients randomized concurrently to P1 and P4 interventions.",
        "Nesting high titer plasma with low titer plasma in the Immune Suppressed strata effectively borrows information from the previous immune suppressed patients randomized to convalescent plasma.",
        "Nesting high titer plasma with low titer plasma in the Non-Immune Suppressed strata is intended to reduce the amount of information borrowed from the previous positive result.",
        "The high titer convalescent plasma (active intervention specified in this DSA and designated the intervention code ‘P4’) will be nested with the (low titer) convalescent plasma intervention (intervention code ‘P2’ and the active intervention in earlier versions of this DSA approved in regions other than the United States) in the Immune Suppressed and Non-Immune Suppressed Strata.",
        "This nesting structure can be interpreted as an informative prior for high titer plasma that is a weighted average of the low titer plasma effect in immune suppressed and Non-Immune Suppressed strata." ;
    rcap:readingOf rcap:DomainDesign_IG ;
    rcap:response "fills" ;
    rcap:responseSection "10.6" ;
    rcap:responseStatement rcap:c796cb21447,
        rcap:c947cb519f4,
        rcap:c9ef610c2b5,
        rcap:cd715a78d79,
        rcap:cf3df6f4af5 ;
