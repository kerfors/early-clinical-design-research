rcap:delegation-0361698be9 a owl:NamedIndividual,
        rcap:DelegationReading ;
    rcap:allocationKind "delegation" ;
    rcap:coreSentence40 "Whether or not an intervention is regarded as having an established safety profile, and any additional reporting requirements, will be specified in the relevant DSA." ;
    rcap:evidenceDoc "Mechanical Ventilation Domain-Specific Appendix 2" ;
    rcap:evidenceSection "11.2" ;
    rcap:evidenceText "The occurrence of the following should be screened for and reported as Serious Adverse Events (SAEs) for all participants in this domain, irrespective of intervention allocation: • Barotrauma (i.e., pneumothorax, subcutaneous emphysema, etc.) Other SAEs should be reported only where, in the opinion of the site investigator, the event might reasonably have occurred as a consequence of a study intervention or study participation (see relevant Core Protocol documents)." ;
    rcap:readingOf rcap:DomainDesign_MV ;
    rcap:response "fills_by_reference" ;
    rcap:responseSection "11.2" ;
    rcap:reviewStatus "analyst-reading; map, rules and responses approved 2026-10-25" ;
    rcap:role "paired" ;
    rcap:rule "D-backref" ;
    rcap:sameText40 "True" ;
    rcap:topic "established safety profile and reporting" .

rcap:delegation-0591a0fdec a owl:NamedIndividual,
        rcap:DelegationReading ;
    rcap:allocationKind "delegation" ;
    rcap:coreSentence40 "Prespecified co-interventions related to specific domains will be recorded in the CRF and are outlined in the relevant DSAs." ;
    rcap:evidenceDoc "Corticosteroid Domain-Specific Appendix 6" ;
    rcap:evidenceSection "8.4" ;
    rcap:evidenceText "All other treatment that is not specified by assignment within the platform will be determined by the treating clinician.",
        "All use of systemic corticosteroids is recorded and the reason for any new or additional administration will be documented.",
        "New or additional systemic corticosteroids may be administered to any patient who has received an allocation status in this domain for a new clinical indication other than the respiratory tract infection and its direct complications.",
        "The administration of etomidate after enrollment is not permitted and will be considered a protocol deviation." ;
    rcap:readingOf rcap:DomainDesign_CS ;
    rcap:response "fills" ;
    rcap:responseSection "8.4" ;
    rcap:reviewStatus "analyst-reading; map, rules and responses approved 2026-10-25" ;
    rcap:role "paired" ;
    rcap:rule "D-content" ;
    rcap:sameText40 "True" ;
    rcap:topic "co-interventions" .

