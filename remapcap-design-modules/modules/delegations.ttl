    rcap:evidenceSection "10.2" ;
    rcap:evidenceText "Borrowing is permitted between strata.",
        "No other strata will contribute to the unit-of-analysis, although this may be modified as an operational decision as specified in the Current State document.",
        "The eligibility criteria for this domain correspond to the Influenza Infection Confirmed Stratum (i.e.",
        "Within this stratum and state, the unit-of-analysis is defined by the Bacterial Infection Diagnosed Strata (defined as Bacterial Infection Diagnosed or Bacterial Infection Not Diagnosed).",
        "microbiological testing-confirmed influenza) and the Severe Illness Severity State." ;
    rcap:readingOf rcap:DomainDesign_IIM ;
    rcap:response "fills" ;
    rcap:responseSection "10.2" ;
    rcap:responseStatement rcap:c1c0f1e7b50,
