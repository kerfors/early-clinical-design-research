rcap:delegation-5e5e6a74a9 a owl:NamedIndividual,
        rcap:DelegationReading ;
    rcap:allocationKind "delegation" ;
    rcap:coreSentence40 "Whether or not an intervention is regarded as having an established safety profile, and any additional reporting requirements, will be specified in the relevant DSA." ;
