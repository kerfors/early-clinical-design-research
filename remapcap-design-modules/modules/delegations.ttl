rcap:delegation-bab740cf53 a owl:NamedIndividual,
        rcap:DelegationReading ;
    rcap:allocationKind "delegation" ;
    rcap:coreSentence40 "The trial endpoints, as outlined in the Core Protocol and as specified in DSAs, are designed to capture the majority of events that might otherwise constitute an SAE." ;
    rcap:evidenceDoc "Endothelial Modulation Domain-Specific Appendix 2" ;
    rcap:evidenceSection "8.5.2" ;
    rcap:evidenceText "The domain-specific secondary outcome measures will be: From randomization in this domain, during the index hospitalization until the end of study day 15: • Severe thrombocytopenia (defined as platelet count <50 x 109 /L) • Severe neutropenia (defined as neutrophil count <1.0 x 109 /L) • Major bleeding (as defined by the ISTH criteria) • Increase in AST or ALT to 5 x ULN or bilirubin 3 x ULN From randomization in this domain, during the index hospitalization unless otherwise specified, censored 90 days after enrollment: • Confirmed proximal deep venous thrombosis • Confirmed pulmonary embolism • Acute myocardial infarction • Confirmed ischemic cerebrovascular event • Other thrombotic events • Serious adverse events as defined in relevant core protocol documents and this DSA" ;
    rcap:readingOf rcap:DomainDesign_END ;
    rcap:response "descriptive_no_slot" ;
    rcap:responseSection "8.5.2" ;
    rcap:responseStatement rcap:c27cacd94ff,
        rcap:c304206ce4e ;
    rcap:reviewStatus "analyst-reading; map, rules and responses approved 2026-10-25" ;
    rcap:role "descriptive" ;
    rcap:rule "R-descriptive" ;
    rcap:sameText40 "True" ;
    rcap:topic "endpoints capture SAEs" .

rcap:delegation-bd5a71f5ed a owl:NamedIndividual,
        rcap:DelegationReading ;
    rcap:allocationKind "delegation" ;
    rcap:conditional "yes" ;
    rcap:coreSentence40 "If required, additional clarification of issues related to the identification of SAEs that are relevant to a specific domain will be described in the DSA." ;
    rcap:evidenceDoc "Endothelial Modulation Domain-Specific Appendix 2" ;
    rcap:evidenceSection "11.2" ;
    rcap:evidenceText "The occurrence of the following should be screened for and reported as SAEs for all patients in this domain, irrespective of intervention allocation: • Unexpected respiratory depression (including if due to suspected drug interaction between fentanyl and imatinib) • Cardiac arrythmia (particularly torsades de pointes) Other SAEs should be reported only where, in the opinion of the site-investigator, the event might reasonably have occurred as a consequence of a study intervention or study participation (see relevant core protocol documents)." ;
    rcap:readingOf rcap:DomainDesign_END ;
    rcap:response "fills_by_reference" ;
    rcap:responseSection "11.2" ;
    rcap:reviewStatus "analyst-reading; map, rules and responses approved 2026-10-25" ;
    rcap:role "paired" ;
    rcap:rule "D-backref" ;
    rcap:sameText40 "True" ;
    rcap:topic "SAE clarification" .

