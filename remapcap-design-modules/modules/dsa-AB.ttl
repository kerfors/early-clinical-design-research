[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_AB ;
    owl:annotatedTarget _:Nb6275c57bf014ee486a740927ed137a5 ;
    rcap:evidenceDoc "Antibiotic Domain-Specific Appendix 4" ;
    rcap:evidencePosition "lead_in:2" ;
    rcap:evidenceSection "8.3.3" ;
    rcap:evidenceText "As such, most patients who receive an allocation within this domain will have already received empiric antibiotic therapy prior to enrollment." ;
    rcap:occurrenceKind "intervention" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_AB ;
    owl:annotatedTarget _:N3f4931257ce742d0b4eb0534ceb834fd ;
    rcap:evidenceDoc "Antibiotic Domain-Specific Appendix 4" ;
    rcap:evidenceGlyph "•" ;
    rcap:evidencePage 21 ;
    rcap:evidencePosition "1" ;
    rcap:evidenceSection "8.3.1" ;
    rcap:evidenceText "Ceftriaxone + Macrolide" ;
    rcap:occurrenceKind "intervention" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:Domain_AB ;
    owl:annotatedTarget _:N779440fb91c54defa3ff532cf931877b ;
    rcap:evidenceDoc "Antibiotic Domain-Specific Appendix 4" ;
    rcap:evidenceGlyph "•" ;
    rcap:evidencePage 21 ;
    rcap:evidenceRule "B-domain" ;
    rcap:evidenceSection "8.3.1" ;
    rcap:evidenceText "Moxifloxacin or Levofloxacin" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_AB ;
    owl:annotatedTarget _:Nd425840d487149e18c4631b7a8dcbc08 ;
    rcap:evidenceDoc "Antibiotic Domain-Specific Appendix 4" ;
    rcap:evidencePosition "lead_in:1" ;
    rcap:evidenceSection "8.3.4" ;
    rcap:evidenceText "The duration of empiric antibiotics will be determined by the treating clinician based on daily reviews of the following criteria:" ;
    rcap:occurrenceKind "intervention" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_AB ;
    owl:annotatedTarget _:Nf136759f57b843e983703c330fc2abb7 ;
    rcap:evidenceDoc "Antibiotic Domain-Specific Appendix 4" ;
    rcap:evidencePosition "lead_in:2" ;
    rcap:evidenceSection "10.6" ;
    rcap:evidenceText "The rationale for this is that each of these interventions comprises a beta-lactam antibiotic combined with a macrolide." ;
    rcap:occurrenceKind "allocation_nesting" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_AB ;
    owl:annotatedTarget _:N329fa4826da34fe6b4ba1918029eb87c ;
    rcap:evidenceDoc "Antibiotic Domain-Specific Appendix 4" ;
    rcap:evidencePosition "lead_in:9" ;
    rcap:evidenceSection "8.2.3" ;
    rcap:evidenceText "Patients in whom all interventions are contraindicated will be treated according to the current standard of care at the clinician’s discretion." ;
    rcap:occurrenceKind "intervention_exclusion" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_AB ;
    owl:annotatedTarget _:N36996a37e4174f7b947c06e7ae38d1e1 ;
    rcap:evidenceDoc "Antibiotic Domain-Specific Appendix 4" ;
    rcap:evidencePosition "lead_in:1" ;
    rcap:evidenceSection "8.2.3" ;
    rcap:evidenceText "Prior to the study commencement, sites will select which interventions that patients at their site will be allocated to, based on the current standards of acceptable care, local epidemiology and regulatory status of antibiotics as outlined below." ;
    rcap:occurrenceKind "intervention_exclusion" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_AB ;
    owl:annotatedTarget _:N20e38ff5b4684f60880f201f9c6d5fd0 ;
    rcap:evidenceDoc "Antibiotic Domain-Specific Appendix 4" ;
    rcap:evidencePage 23 ;
    rcap:evidencePosition "4" ;
    rcap:evidenceSection "8.3.5" ;
    rcap:evidenceText "Enteral clarithromycin or roxithromycin" ;
    rcap:occurrenceKind "intervention" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_AB ;
    owl:annotatedTarget _:Nc87a7ac5692e4d1cb7f0ba3ccf372c89 ;
    rcap:evidenceDoc "Antibiotic Domain-Specific Appendix 4" ;
    rcap:evidencePage 23 ;
    rcap:evidencePosition "2" ;
    rcap:evidenceSection "8.3.5" ;
    rcap:evidenceText "IV clarithromycin, with switch to enteral azithromycin when appropriate" ;
    rcap:occurrenceKind "intervention" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_AB ;
    owl:annotatedTarget _:N9609ad76361141498642832517784e1a ;
    rcap:evidenceDoc "Antibiotic Domain-Specific Appendix 4" ;
    rcap:evidenceGlyph "•" ;
    rcap:evidencePage 20 ;
    rcap:evidencePosition "9" ;
    rcap:evidenceSection "8.2.2" ;
    rcap:evidenceText "The treating clinician believes that participation in the domain would not be in the best interests of the patient" ;
    rcap:occurrenceKind "domain_exclusion" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_AB ;
    owl:annotatedTarget _:N87dc9f144f1b4afda7bf784a93469812 ;
    rcap:evidenceDoc "Antibiotic Domain-Specific Appendix 4" ;
    rcap:evidenceGlyph "•" ;
    rcap:evidencePage 19 ;
    rcap:evidencePosition "3" ;
    rcap:evidenceSection "8.2.1" ;
    rcap:evidenceText "Empiric antibiotic therapy for bacterial pneumonia is considered appropriate" ;
    rcap:occurrenceKind "domain_inclusion" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_AB ;
    owl:annotatedTarget _:Na31152c2c9c34d6a9ea71abf0747e0d5 ;
    rcap:evidenceDoc "Antibiotic Domain-Specific Appendix 4" ;
    rcap:evidenceGlyph "•" ;
    rcap:evidencePage 21 ;
    rcap:evidencePosition "2" ;
    rcap:evidenceSection "8.2.3" ;
    rcap:evidenceText "Known non-serious hypersensitivity to cephalosporins will result in exclusion from receiving interventions that include ceftriaxone" ;
    rcap:occurrenceKind "intervention_exclusion" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_AB ;
    owl:annotatedTarget _:Na72d0a81a88e40f580b798b1c566039a ;
    rcap:evidenceDoc "Antibiotic Domain-Specific Appendix 4" ;
    rcap:evidencePosition "lead_in:3" ;
    rcap:evidenceSection "8.3.3" ;
    rcap:evidenceText "The allocated intervention should be commenced immediately after reveal of allocation." ;
    rcap:occurrenceKind "intervention" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_AB ;
    owl:annotatedTarget _:N2a40d049445f4c0784e2678c8da4fd19 ;
    rcap:evidenceDoc "Antibiotic Domain-Specific Appendix 4" ;
    rcap:evidenceGlyph "•" ;
    rcap:evidencePage 22 ;
    rcap:evidencePosition "3" ;
    rcap:evidenceSection "8.3.2" ;
    rcap:evidenceText "Piperacillin-tazobactam ≥4.5 grams administered IV every 8 hours" ;
    rcap:occurrenceKind "intervention" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_AB ;
    owl:annotatedTarget _:Ne3cb5e6ecd14409b8297ffbfade52eef ;
    rcap:evidenceDoc "Antibiotic Domain-Specific Appendix 4" ;
    rcap:evidencePosition "lead_in:1" ;
    rcap:evidenceSection "10.6" ;
    rcap:evidenceText "There is one nest within this domain, comprising ceftriaxone + macrolide, piperacillin-tazobactam + macrolide, and amoxicillin-clavulanate + macrolide interventions." ;
    rcap:occurrenceKind "allocation_nesting" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_AB ;
    owl:annotatedTarget _:Nf6e95af51ad3404ea91154f8f1bec547 ;
    rcap:evidenceDoc "Antibiotic Domain-Specific Appendix 4" ;
    rcap:evidencePosition "lead_in:1" ;
    rcap:evidenceSection "10.2" ;
    rcap:evidenceText "The unit-of-analysis for this domain is all patients who receive an allocation status in this domain." ;
    rcap:occurrenceKind "allocation_unit_of_analysis" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_AB ;
    owl:annotatedTarget _:N5960d23c874d4bf0bbe3f8ac42078f9b ;
    rcap:evidenceDoc "Antibiotic Domain-Specific Appendix 4" ;
    rcap:evidencePosition "trailing:2" ;
    rcap:evidenceSection "8.3.2" ;
    rcap:evidenceText "It is permitted to provide these antibiotics via intermittent, prolonged, or continuous infusion." ;
    rcap:occurrenceKind "intervention" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_AB ;
    owl:annotatedTarget _:N1bc50eaa2f69441596b929ab43a7c63e ;
    rcap:evidenceDoc "Antibiotic Domain-Specific Appendix 4" ;
    rcap:evidencePosition "lead_in:2" ;
    rcap:evidenceSection "8.2.3" ;
    rcap:evidenceText "Patients may also be excluded from receiving one or more interventions within the domain for patient-specific reasons." ;
    rcap:occurrenceKind "intervention_exclusion" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_AB ;
    owl:annotatedTarget _:N1b1757a121684be1b1576d6526e6aea2 ;
    rcap:evidenceDoc "Antibiotic Domain-Specific Appendix 4" ;
    rcap:evidenceGlyph "•" ;
    rcap:evidencePage 21 ;
    rcap:evidencePosition "5" ;
    rcap:evidenceSection "8.2.3" ;
    rcap:evidenceText "Known serious hypersensitivity to the macrolide will result in exclusion from interventions that include piperacillin, amoxicillin, and ceftriaxone" ;
    rcap:occurrenceKind "intervention_exclusion" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_AB ;
    owl:annotatedTarget _:Na7ca36ec000e411da352878cb93685ed ;
    rcap:evidenceDoc "Antibiotic Domain-Specific Appendix 4" ;
    rcap:evidencePosition "lead_in:4" ;
    rcap:evidenceSection "8.2.3" ;
    rcap:evidenceText "An example would include patients with a history of a penicillin hypersensitivity, who may receive a cephalosporin or moxifloxacin." ;
    rcap:occurrenceKind "intervention_exclusion" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_AB ;
    owl:annotatedTarget _:N0840f4cde1f0461fa15a0e2f123e80e4 ;
    rcap:evidenceDoc "Antibiotic Domain-Specific Appendix 4" ;
    rcap:evidenceGlyph "•" ;
    rcap:evidencePage 23 ;
    rcap:evidencePosition "5" ;
    rcap:evidenceSection "8.3.4" ;
    rcap:evidenceText "Discontinuation if the patient experiences a serious adverse event (SAE) that is thought to be related to a study drug" ;
    rcap:occurrenceKind "intervention" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_AB ;
    owl:annotatedTarget _:N3a0ceb6d4657460ea6b00ee7281b6b9a ;
    rcap:evidenceDoc "Antibiotic Domain-Specific Appendix 4" ;
    rcap:evidenceGlyph "•" ;
    rcap:evidencePage 21 ;
    rcap:evidencePosition "4" ;
    rcap:evidenceSection "8.3.1" ;
    rcap:evidenceText "Amoxicillin-clavulanate + Macrolide" ;
    rcap:occurrenceKind "intervention" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_AB ;
    owl:annotatedTarget _:N45139743488843b18e266f0df39d378b ;
    rcap:evidenceDoc "Antibiotic Domain-Specific Appendix 4" ;
    rcap:evidencePosition "lead_in:1" ;
    rcap:evidenceSection "8.2.1" ;
    rcap:evidenceText "Patients are eligible for this domain if:" ;
    rcap:occurrenceKind "domain_inclusion" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_AB ;
    owl:annotatedTarget _:N55c66468a91e4d9eb45a680da1f29d69 ;
    rcap:evidenceDoc "Antibiotic Domain-Specific Appendix 4" ;
    rcap:evidencePosition "lead_in:1" ;
    rcap:evidenceSection "8.2.2" ;
    rcap:evidenceText "Patients will be excluded from this domain if they have any of the following:" ;
    rcap:occurrenceKind "domain_exclusion" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_AB ;
    owl:annotatedTarget _:N51d233f86741467685e1eb1c7c663d7a ;
    rcap:evidenceDoc "Antibiotic Domain-Specific Appendix 4" ;
    rcap:evidencePosition "trailing:2" ;
    rcap:evidenceSection "8.3.1" ;
    rcap:evidenceText "For sites that are including the moxifloxacin or levofloxacin intervention it is strongly encouraged that the sites participate in at least one intervention that includes a cephalosporin and one intervention that includes a penicillin so that causal inference by random allocation is possible for patients who have known non-serious intolerance to either cephalosporins or penicillins but not both." ;
    rcap:occurrenceKind "intervention" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_AB ;
    owl:annotatedTarget _:N147e69bcfdc64c11936976feaea5bcec ;
    rcap:evidenceDoc "Antibiotic Domain-Specific Appendix 4" ;
    rcap:evidenceGlyph "o" ;
    rcap:evidencePage 20 ;
    rcap:evidencePosition "6" ;
    rcap:evidenceSection "8.2.2" ;
    rcap:evidenceText "Febrile neutropenia or significant immunosuppression (including organ or bone marrow transplantation, human immunodeficiency virus (HIV) Infection with CD4 cell count <200 cells/µL, systemic immunosuppressive, systemic corticosteroids comprising prednisolone, or equivalent, ≥20mg/day for > 4 preceding weeks)." ;
    rcap:occurrenceKind "domain_exclusion" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_AB ;
    owl:annotatedTarget _:N3c0e4b044f53499f9c6e5052a644ae42 ;
    rcap:evidenceDoc "Antibiotic Domain-Specific Appendix 4" ;
    rcap:evidenceGlyph "•" ;
    rcap:evidencePage 22 ;
    rcap:evidencePosition "2" ;
    rcap:evidenceSection "8.3.2" ;
    rcap:evidenceText "Moxifloxacin 400mg administered IV once daily, or Levofloxacin 750mg IV q24h" ;
    rcap:occurrenceKind "intervention" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_AB ;
    owl:annotatedTarget _:Na0ce99c5046647f4a92067fdf4bb6b7a ;
    rcap:evidenceDoc "Antibiotic Domain-Specific Appendix 4" ;
    rcap:evidencePage 23 ;
    rcap:evidencePosition "5" ;
    rcap:evidenceSection "8.3.5" ;
    rcap:evidenceText "IV or enteral erythromycin. Sites in which only erythromycin is available are not able to participate in the Macrolide Duration Domain." ;
    rcap:occurrenceKind "intervention" .

