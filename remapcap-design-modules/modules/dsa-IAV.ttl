    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_IAV ;
    owl:annotatedTarget _:N845e6f80bc0b4a64b0bbafa4d2d47db3 ;
    rcap:evidenceDoc "Influenza Antiviral Domain-Specific Appendix 4" ;
    rcap:evidencePosition "lead_in:1" ;
    rcap:evidenceSection "8.1.2" ;
    rcap:evidenceText "This domain is available for patients who are in either the Moderate or Severe State." ;
