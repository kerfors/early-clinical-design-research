    rcap:evidencePage 19 ;
    rcap:evidencePosition "1" ;
    rcap:evidenceSection "8.2.3" ;
    rcap:evidenceText "Known hypersensitivity to an agent specified as an intervention in this domain will exclude a patient from receiving that agent" ;
    rcap:occurrenceKind "intervention_exclusion" .

