[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_IAV ;
    owl:annotatedTarget _:N36cbf9896851485eb35f21ea7c3e83fc ;
    rcap:evidenceDoc "Influenza Antiviral Domain-Specific Appendix 4" ;
    rcap:evidencePosition "lead_in:2" ;
    rcap:evidenceSection "8.3.3" ;
    rcap:evidenceText "For baloxavir containing interventions, a third dose can be administered on day 7, if, in the opinion of the treating clinician, there has been insufficient clinical improvement." ;
    rcap:occurrenceKind "intervention" .

