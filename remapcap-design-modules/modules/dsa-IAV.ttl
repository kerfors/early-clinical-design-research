[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_IAV ;
    owl:annotatedTarget _:N600bbdf567db4308b25b93f392166b88 ;
    rcap:evidenceDoc "Influenza Antiviral Domain-Specific Appendix 4" ;
    rcap:evidencePosition "lead_in:1" ;
    rcap:evidenceSection "10.4" ;
    rcap:evidenceText "The timing of the revealing of allocation status and administration of interventions is specified to be Randomization with Immediate Reveal and Initiation, or with Delayed Reveal and Initiation, for situations where randomization occurs before influenza test results are available, with reveal of allocation occurring at time of confirmed positive result." ;
    rcap:occurrenceKind "allocation_reveal" .

