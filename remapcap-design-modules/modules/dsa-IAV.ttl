[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_IAV ;
    owl:annotatedTarget rcap:CoreDesign ;
    rcap:binding "unversioned" ;
    rcap:evidenceDoc "Influenza Antiviral Domain-Specific Appendix 4" ;
    rcap:evidencePage 10 ;
    rcap:evidenceRule "B-dsa" ;
    rcap:evidenceText "The Core Protocol contains all information that is generic to the trial …" ;
    rcap:note "Core Protocol 4.0 1.2: Domain-Specific Appendix is an appendix to the Core Protocol.",
        "Core Protocol 4.1 1.2: Domain-Specific Appendix is an appendix to the Core Protocol." .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_IAV ;
    owl:annotatedTarget _:N336001fa7c964509b433565db3fd1b4e ;
    rcap:evidenceDoc "Influenza Antiviral Domain-Specific Appendix 4" ;
    rcap:evidencePosition "lead_in:3" ;
    rcap:evidenceSection "10.5" ;
    rcap:evidenceText "If an interaction is specified with a future domain, it is sufficient for the interaction to be specified only in the DSA of such a future domain." ;
    rcap:occurrenceKind "allocation_interactions" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_IAV ;
    owl:annotatedTarget _:N088f10663a6f4da599593289fdb55993 ;
    rcap:evidenceDoc "Influenza Antiviral Domain-Specific Appendix 4" ;
    rcap:evidencePosition "lead_in:2" ;
    rcap:evidenceSection "10.3" ;
    rcap:evidenceText "If RAR is applied, the cap on the maximum or minimum proportion of patients assigned to an intervention that is specified in core protocol documents may be modified by the Statistical Analysis Committee (SAC) if needed to reduce the likelihood of sites being unblinded or to improve power." ;
    rcap:occurrenceKind "allocation_rar" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_IAV ;
    owl:annotatedTarget _:Nbe30e29b02664ff3bb69daf18a396d32 ;
    rcap:evidenceDoc "Influenza Antiviral Domain-Specific Appendix 4" ;
    rcap:evidencePosition "lead_in:1" ;
    rcap:evidenceSection "10.2" ;
    rcap:evidenceText "The primary unit-of-analysis, for both analysis of treatment effect and the Response Adaptive Randomization (RAR), corresponds to patients who have received an allocation within this domain (i.e." ;
    rcap:occurrenceKind "allocation_unit_of_analysis" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_IAV ;
    owl:annotatedTarget _:Ndbfc7c7d37d34491a146121c0df74bc6 ;
    rcap:evidenceDoc "Influenza Antiviral Domain-Specific Appendix 4" ;
    rcap:evidencePosition "lead_in:3" ;
    rcap:evidenceSection "10.3" ;
    rcap:evidenceText "If required, any such modifications will be an operational decision of the Design Team specified in the Current State document and applied by the SAC." ;
    rcap:occurrenceKind "allocation_rar" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_IAV ;
    owl:annotatedTarget _:N260e57744edf4436a3899a5de2845e3b ;
    rcap:evidenceDoc "Influenza Antiviral Domain-Specific Appendix 4" ;
    rcap:evidencePosition "lead_in:2" ;
    rcap:evidenceSection "8.3.4" ;
    rcap:evidenceText "The study interventions can be temporarily or permanently discontinued at any time by the treating clinician if doing so is regarded as being in the best interests of the patient." ;
    rcap:occurrenceKind "intervention" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_IAV ;
    owl:annotatedTarget _:N47357ce2e4f8436fa78ec410601db41a ;
    rcap:evidenceDoc "Influenza Antiviral Domain-Specific Appendix 4" ;
    rcap:evidencePosition "lead_in:2" ;
    rcap:evidenceSection "10.6" ;
    rcap:evidenceText "Patients enrolled in previous versions of this DSA to the 10-day oseltamivir + baloxavir intervention will continue to be nested with the 5-day oseltamivir + baloxavir intervention." ;
    rcap:occurrenceKind "allocation_nesting" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_IAV ;
    owl:annotatedTarget _:Nd1d2307fedff4bf188db7c75538ab4ab ;
    rcap:evidenceDoc "Influenza Antiviral Domain-Specific Appendix 4" ;
    rcap:evidencePosition "lead_in:1" ;
    rcap:evidenceSection "10.3" ;
    rcap:evidenceText "Response Adaptive Randomization may be applied." ;
    rcap:occurrenceKind "allocation_rar" .

