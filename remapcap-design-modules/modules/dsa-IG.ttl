[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:DomainDesign_IG ;
    owl:annotatedTarget _:N0bff39f4c2b54f708c97dd68b7032fc8 ;
    rcap:evidenceDoc "COVID-19 Immunoglobulin Therapy Domain-Specific Appendix 4" ;
    rcap:evidencePosition "lead_in:2" ;
    rcap:evidenceSection "10.6" ;
    rcap:evidenceText "Nesting high titer plasma with low titer plasma in the Immune Suppressed strata effectively borrows information from the previous immune suppressed patients randomized to convalescent plasma." ;
    rcap:occurrenceKind "allocation_nesting" .

