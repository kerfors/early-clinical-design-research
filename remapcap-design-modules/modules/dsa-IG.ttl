    rcap:evidencePosition "lead_in:1" ;
    rcap:evidenceSection "10.4" ;
    rcap:evidenceText "The timing of the revealing of allocation status and administration of interventions is specified to be Randomization with Deferred Reveal to permit confirmation of microbiological diagnosis if results of testing are not known at the time of initial assessment of eligibility (see relevant core protocol documents)." ;
    rcap:occurrenceKind "allocation_reveal" .

