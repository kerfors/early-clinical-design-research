    rcap:evidencePosition "lead_in:2" ;
    rcap:evidenceSection "10.2" ;
    rcap:evidenceText "So as to achieve continuity with the initial phase of this domain, a stratum is defined as comprising patients who are immune suppressed." ;
    rcap:occurrenceKind "allocation_unit_of_analysis" .

