    rcap:occursIn "CORE40;CORE41" .

rcap:c88d652552d a owl:Class ;
    rdfs:label "SARS-CoV-2 infection is stratified as SARS-CoV-2 infection confirmed (SARS-CoV-2 detected on microbiological testing with a compatible clinical assessment) and SARS-CoV-2 not confirmed." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "PANDA" .

rcap:c89c6bd7fd6 a owl:Class ;
    rdfs:label "Date and time of hospital admission" ;
    rdfs:subClassOf rcap:DataCollectionSpecification ;
    rcap:coreStatus "same" ;
    rcap:occursIn "CORE40;CORE41" .

rcap:c89d09ee65a a owl:Class ;
    rdfs:label "Tocilizumab will be commenced as soon as possible following reveal of allocation and administered as an intravenous infusion via a central or peripheral line over a one-hour period." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "IIM_DSA" .

rcap:c8aa5949cb6 a owl:Class ;
    rdfs:label "Hospital discharge destination" ;
    rdfs:subClassOf rcap:DataCollectionSpecification ;
    rcap:coreStatus "same" ;
    rcap:occursIn "CORE40;CORE41" .

rcap:c8b63ca6c9c a owl:Class ;
    rdfs:label "Known or suspected pregnancy will result in exclusion from the baricitinib intervention. It is normal clinical practice that women admitted who are in an age group in which pregnancy is possible will have a pregnancy test conducted. The results of such tests will be used to determine interpretation of this exclusion criteria." ;
    rdfs:subClassOf obo:OBI_0500028 ;
    rcap:occursIn "IIM_DSA" .

rcap:c8bc517a21d a owl:Class ;
    rdfs:label "Patients are eligible for this domain if:" ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "AB_DSA;CS_DSA;END_DSA;IAV_DSA;IG_DSA;IIM_DSA;MV_DSA;TAB_DSA" .

rcap:c8c1b7c82a3 a owl:Class ;
    rdfs:label "Within one week of the estimated onset of new or worsening respiratory symptoms" ;
    rdfs:subClassOf rcap:CategorySpecification ;
    rcap:occursIn "PANDA" .

rcap:c8ca25838f1 a owl:Class ;
    rdfs:label "patients who are not receiving invasive mechanical ventilation" ;
    rdfs:subClassOf rcap:CategorySpecification ;
    rcap:occursIn "PANDA" .

rcap:c8cab22acf8 a owl:Class ;
    rdfs:label "Severe neutropenia (defined as neutrophil count <1.0 x 10 9 /L)" ;
    rdfs:subClassOf rcap:EndpointSpecification ;
    rcap:occursIn "END_DSA" .

rcap:c8ce90776ba a owl:Class ;
    rdfs:label "In addition to Domain-specific data required as a consequence of participation in the Antibiotic Domain, patients who are randomized in this domain will have the following data collected:" ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "MD_DSA" .

rcap:c8d1e9454aa a owl:Class ;
    rdfs:label "Hospitalized on non-invasive ventilation or high-flow oxygen*" ;
    rdfs:subClassOf rcap:EndpointSpecification ;
    rcap:coreStatus "moved" ;
    rcap:occursIn "CORE40;CORE41" .

rcap:c8da9e5a430 a owl:Class ;
    rdfs:label "Dates of ICU readmission and discharge during the index hospitalization" ;
    rdfs:subClassOf rcap:DataCollectionSpecification ;
    rcap:coreStatus "same" ;
    rcap:occursIn "CORE40;CORE41" .

rcap:c8de130c28c a owl:Class ;
    rdfs:label "Ceftriaxone + Macrolide" ;
    rdfs:subClassOf rcap:InterventionSpecification ;
    rcap:occursIn "AB_DSA" .

rcap:c8e9a8b7596 a owl:Class ;
    rdfs:label "Respiratory tract infection can manifest as a range of disease entities." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "PANDA" .

rcap:c8efcf1d144 a owl:Class ;
    rdfs:label "At that point, randomization to all other remaining interventions in the domain and in that unit-of-analysis where superiority or efficacy has been declared will be halted at sites at which the relevant intervention is available." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:coreStatus "same" ;
    rcap:occursIn "CORE40;CORE41" .

rcap:c8f0bf764e2 a owl:Class ;
    rdfs:label "The allocated intervention should be discontinued if there is development of a SAE which, in the opinion of the treating clinician, could be related to participation in this domain." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "IAV_DSA" .

rcap:c8f3e270ba9 a owl:Class ;
    rdfs:label "Hydrocortisone administration is to cease when the clinician believes that septic shock has resolved." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "CS_DSA" .

rcap:c8f73b85657 a owl:Class ;
    rdfs:label "Corticosteroids can be administered, either by enrolment in the Corticosteroid Domain of REMAP-CAP or as determined by the treating clinician." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "IIM_DSA" .

rcap:c8fb4c49cb7 a owl:Class ;
    rdfs:label "In adults and in children 9 years of age and older, baricitinib will be administered enterally at a dose of 4 mg daily if the eGFR is at least 60 mL/min/1.73m 2 ." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "IIM_DSA" .

rcap:c8fd5723cf0 a owl:Class ;
    rdfs:label "Administration of antiviral medications active against influenza" ;
    rdfs:subClassOf rcap:DataCollectionSpecification ;
    rcap:occursIn "IAV_DSA" .

rcap:c9061fee8f6 a owl:Class ;
    rdfs:label "Daily ventilatory and physiological parameters and arterial blood gas parameters" ;
    rdfs:subClassOf rcap:DataCollectionSpecification ;
    rcap:occursIn "MV_DSA" .

rcap:c90847b31b4 a owl:Class ;
    rdfs:label "Baseline and nadir platelet and neutrophil counts (between randomization and day 15) and date of nadir result" ;
    rdfs:subClassOf rcap:DataCollectionSpecification ;
    rcap:occursIn "END_DSA" .

rcap:c9109c66618 a owl:Class ;
    rdfs:label "The infusion speed must be 10 mls per hour for 15 minutes and then increased to 130 mls per hour for the next 45 minutes." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "IIM_DSA" .

rcap:c910da2da31 a owl:Class ;
    rdfs:label "Occurrence and duration of prone ventilation" ;
    rdfs:subClassOf rcap:DataCollectionSpecification ;
    rcap:occursIn "MV_DSA" .

rcap:c91b4608fe0 a owl:Class ;
    rdfs:label "Occurrence of barotrauma" ;
    rdfs:subClassOf obo:IAO_0000033 ;
    rcap:occursIn "MV_DSA" .

rcap:c9219e5fe98 a owl:Class ;
    rdfs:label "The entry criteria of the domain are designed to identify patients who are likely to require invasive mechanical ventilation for at least 24 hours." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "MV_DSA" .

rcap:c927d647e14 a owl:Class ;
    rdfs:label "Patients assigned to this intervention are not to receive any additional targeted immune modulation therapy until the end of study day 28 or hospital discharge, whichever occurs first." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "IIM_DSA" .

rcap:c9291b4492d a owl:Class ;
    rdfs:label "Demographic data" ;
    rdfs:subClassOf rcap:DataCollectionSpecification ;
    rcap:coreStatus "same" ;
    rcap:occursIn "CORE40;CORE41" .

rcap:c92cfc5ceb8 a owl:Class ;
    rdfs:label "All patients who die on or before day 90 will be assigned a score of ‘1’." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:coreStatus "only_41" ;
    rcap:occursIn "CORE41" .

rcap:c933da4f669 a owl:Class ;
    rdfs:label "More than 48 hours has elapsed since commencement of invasive mechanical ventilation" ;
    rdfs:subClassOf obo:OBI_0500028 ;
    rcap:occursIn "MV_DSA" .

rcap:c93bcad2a88 a owl:Class ;
    rdfs:label "Hypoxemic State, defined in 3 categories comprising:" ;
    rdfs:subClassOf rcap:CategorySpecification ;
    rcap:occursIn "PANDA" .

rcap:c93d0ed0860 a owl:Class ;
    rdfs:label "Response-adaptive randomization will be applied for this domain." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "AB_DSA;MD_DSA" .

rcap:c93f429f76c a owl:Class ;
    rdfs:label "Positive blood culture for pathogenic bacteria and/or fungus during this hospitalization and more than 48 hours following randomization" ;
    rdfs:subClassOf rcap:EndpointSpecification ;
    rcap:occursIn "IIM_DSA" .

rcap:c93f9ab717f a owl:Class ;
    rdfs:label "Vasopressor-free days at day 28" ;
    rdfs:subClassOf rcap:EndpointSpecification ;
    rcap:coreStatus "same" ;
    rcap:occursIn "CORE40;CORE41" .

rcap:c93fb75134e a owl:Class ;
    rdfs:label "This can be either prolonged macrolide treatment or substitution with a fluoroquinolone or other active agent." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "MD_DSA" .

rcap:c94270b8f05 a owl:Class ;
    rdfs:label "The timing of the revealing of allocation status and administration of interventions is specified to be Randomization with Immediate Reveal and Initiation, or Randomization with Deferred Reveal and Initiation if prospective agreement is required for participation in this domain." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "AB_DSA;TAB_DSA" .

rcap:c945e1d2493 a owl:Class ;
    rdfs:label "It is recognised that there is a wide range of regulatory approaches and attitudes to the evaluation of interventions in pregnant trial participants across participating regions and sites. Known or suspected pregnancy is not an intervention-level exclusion for the tocilizumab intervention by default; however, if a site does not have regulatory approval to enrol pregnant patients to the tocilizumab intervention, known or suspected pregnancy will be applied as an intervention-specific exclusion and will result in exclusion from the tocilizumab intervention." ;
    rdfs:subClassOf obo:OBI_0500028 ;
    rcap:occursIn "IIM_DSA" .

rcap:c947cb519f4 a owl:Class ;
    rdfs:label "The high titer convalescent plasma (active intervention specified in this DSA and designated the intervention code ‘P4’) will be nested with the (low titer) convalescent plasma intervention (intervention code ‘P2’ and the active intervention in earlier versions of this DSA approved in regions other than the United States) in the Immune Suppressed and Non-Immune Suppressed Strata." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "IG_DSA" .

rcap:c949256d13a a owl:Class ;
    rdfs:label "Status for all applicable states and strata" ;
    rdfs:subClassOf rcap:DataCollectionSpecification ;
    rcap:coreStatus "same" ;
    rcap:occursIn "CORE40;CORE41" .

rcap:c955a3279e8 a owl:Class ;
    rdfs:label "Enteral imatinib will be administered for a total of 14 days or until hospital discharge, whichever occurs first." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "END_DSA" .

rcap:c969a345043 a owl:Class ;
    rdfs:label "IV azithromycin, with switch to enteral azithromycin when appropriate" ;
    rdfs:subClassOf rcap:InterventionSpecification ;
    rcap:occursIn "AB_DSA;TAB_DSA" .

rcap:c969c498ac0 a owl:Class ;
    rdfs:label "Patients allocated to the moxifloxacin or levofloxacin intervention will not receive a macrolide or any beta-lactam or monobactam agent." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "AB_DSA" .

rcap:c96f99cecfd a owl:Class ;
    rdfs:label "However, continued administration of the course of baricitinib after discharge from the participating clinical area is a clinical decision that is at the discretion of the treating clinician." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "IIM_DSA" .

rcap:c9710c0df45 a owl:Class ;
    rdfs:label "Serious ventricular arrhythmia (including ventricular fibrillation) or sudden unexpected death in hospital." ;
    rdfs:subClassOf rcap:DataCollectionSpecification ;
    rcap:occursIn "MD_DSA" .

rcap:c97191d8ecd a owl:Class ;
    rdfs:label "The timing of the revealing of allocation status and administration of interventions is specified to be Randomization with Immediate Reveal and Initiation or Randomization with Deferred Reveal and Initiation if prospective agreement to participate is required for this domain (see relevant Core Protocol documents) or if the results of microbiological testing for influenza or SARS-CoV-2 or both are unavailable at the time of eligibility." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "IIM_DSA" .

rcap:c9733fcba16 a owl:Class ;
    rdfs:label "If arterial pH is less than 7.15, the tidal volume can be increased in 5 to 10% increments until arterial pH is more than 7.15, noting that, if necessary, to maintain a pH of not less than 7.15, it is permitted for the plateau pressure to exceed 30 cm H 2 O." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "MV_DSA" .

rcap:c9775fa413c a owl:Class ;
    rdfs:label "Shock-dependent hydrocortisone while the patient is in septic shock (Severe State only)" ;
    rdfs:subClassOf rcap:InterventionSpecification ;
    rcap:occursIn "CS_DSA" .

rcap:c9988e71abb a owl:Class ;
    rdfs:label "dasatinib, nilotinib) unless for an accepted clinical indication (e.g." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "END_DSA" .

rcap:c9a41291a28 a owl:Class ;
    rdfs:label "Administration is to commence immediately after reveal of allocation." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "CS_DSA" .

rcap:c9af5ab3b4d a owl:Class ;
    rdfs:label "A participant is eligible to be randomized in the Severe Illness Severity State if they have previously been randomized in the Moderate Illness Severity State, but not if they have previously been randomized in the Recovering Illness Severity State." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "PANDA" .

rcap:c9b0cdad1f3 a owl:Class ;
    rdfs:label "P a O 2 :F I O 2 ratio ≤300 mmHg or S p O 2 /F I O 2 ratio ≤315 with S p O 2 ≤97% (altitude-adjusted if >1000m)" ;
    rdfs:subClassOf rcap:CategorySpecification ;
    rcap:occursIn "PANDA" .

rcap:c9b40cb182e a owl:Class ;
    rdfs:label "Hospital-acquired, defined as infection not incubating at the time of hospital admission and manifesting 48 hours or more after hospital admission" ;
    rdfs:subClassOf rcap:CategorySpecification ;
    rcap:occursIn "PANDA" .

rcap:c9b8bdba438 a owl:Class ;
    rdfs:label "This domain is available for patients who are in either the Moderate or Severe State." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "CS_DSA;IAV_DSA;IG_DSA" .

rcap:c9b95fda8b6 a owl:Class ;
    rdfs:label "Respiratory tract infection, defined in two categories, lower or upper, with lower defined as infection of the airways below the level of the larynx (including tracheitis, bronchitis, bronchiolitis, and pneumonia) and upper defined as infection of the airways at the level of the larynx and above, excluding isolated otitis media or mastoiditis" ;
    rdfs:subClassOf rcap:CategorySpecification ;
    rcap:occursIn "PANDA" .

rcap:c9bfd7a0eed a owl:Class ;
    rdfs:label "Highly effective contraception includes combined (estrogen and progestogen containing) hormonal contraception associated with inhibition of ovulation, progesterone-only contraception association with inhibition of ovulation, intrauterine device, intrauterine hormone-releasing system, bilateral tubal occlusion, vasectomised partner and sexual abstinence." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "END_DSA" .

rcap:c9c2969bd8c a owl:Class ;
    rdfs:label "An immune modulation intervention for influenza should be discontinued if there is development of a SAE which, in the opinion of the treating clinician, could be related to participation in this domain." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "IIM_DSA" .

rcap:c9c4ee896ea a owl:Class ;
    rdfs:label "Participating sites may choose to offer this domain to patients in one or more (or all) of these Age Strata." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "CS_DSA;IAV_DSA;IG_DSA;IIM_DSA" .

rcap:c9c6cc320ec a owl:Class ;
    rdfs:label "A set of generic secondary endpoints will be evaluated in all domains." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:coreStatus "only_40" ;
    rcap:occursIn "CORE40" .

rcap:c9d34740b48 a owl:Class ;
    rdfs:label "It is recognized that there is a wide range of regulatory approaches and attitudes to the evaluation of interventions in pregnant trial participants across participating regions and sites. Known or suspected pregnancy is not an intervention-level exclusion for the fixed-course dexamethasone intervention by default; however, if a site does not have regulatory approval to enroll pregnant patients to the fixed-course dexamethasone intervention, known or suspected pregnancy will be applied as an intervention-specific exclusion and will result in exclusion from the fixed course dexamethasone intervention." ;
    rdfs:subClassOf obo:OBI_0500028 ;
    rcap:occursIn "CS_DSA" .

rcap:c9dba388002 a owl:Class ;
    rdfs:label "Such participants may be considered to be a separate pathogen analysis stratum." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "PANDA" .

rcap:c9e0ae9bd3c a owl:Class ;
    rdfs:label "Pathogen analysis strata allow differential treatment effects to be assessed in participants with specific pathogens (or groups of pathogens) at eligibility assessment and improves covariate balance within pathogen strata." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "PANDA" .

rcap:c9e40a2b775 a owl:Class ;
    rdfs:label "Influenza virus infection has been confirmed by microbiological testing" ;
    rdfs:subClassOf obo:OBI_0500027 ;
    rcap:occursIn "IAV_DSA;IIM_DSA" .

rcap:c9e7d01aeee a owl:Class ;
    rdfs:label "Amoxicillin-clavulanate + Ceftazidime + Macrolide" ;
    rdfs:subClassOf rcap:InterventionSpecification ;
    rcap:occursIn "TAB_DSA" .

rcap:c9ef610c2b5 a owl:Class ;
    rdfs:label "This nesting structure can be interpreted as an informative prior for high titer plasma that is a weighted average of the low titer plasma effect in immune suppressed and Non-Immune Suppressed strata." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "IG_DSA" .

rcap:c9f97c0e55a a owl:Class ;
    rdfs:label "Among Day-90 survivors, their daily respiratory support level as defined by position on a five-category ordinal scale:" ;
    rdfs:subClassOf rcap:EndpointSpecification ;
    rcap:coreStatus "moved" ;
    rcap:occursIn "CORE40;CORE41" .

rcap:c9fd4c2c7f1 a owl:Class ;
    rdfs:label "The index hospital admission is defined as continuing while the participant is admitted to any healthcare facility or level of residence that provides an equivalent or higher level of care than that corresponding to where the participant was enrolled." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:coreStatus "moved" ;
    rcap:occursIn "CORE40;CORE41" .

rcap:ca041d3b3e0 a owl:Class ;
    rdfs:label "Within this stratum and state, the unit-of-analysis is defined by the Bacterial Infection Diagnosed Strata (defined as Bacterial Infection Diagnosed or Bacterial Infection Not Diagnosed)." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "IIM_DSA" .

rcap:ca053db75aa a owl:Class ;
    rdfs:label "Progression to IMV/ECLS/death among those not receiving invasive mechanical ventilation or ECLS at baseline" ;
    rdfs:subClassOf rcap:EndpointSpecification ;
    rcap:coreStatus "only_41" ;
    rcap:occursIn "CORE41" .

rcap:ca0bdefd3cd a owl:Class ;
    rdfs:label "Pandemic respiratory pathogen infection is stratified as pandemic respiratory pathogen infection confirmed (the pandemic respiratory pathogen is detected on microbiological testing with a clinically compatible illness) and pandemic respiratory pathogen infection not confirmed." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "PANDA" .

rcap:ca23aee54fd a owl:Class ;
    rdfs:label "Collected while participants are admitted to hospital between randomization and Day 28: For participants admitted to ICU at the time of enrollment, or after enrollment: At the discretion of the site, unless specified otherwise in an RSA or DSA, and collected by phone:" ;
    rdfs:subClassOf rcap:rcdb4b81960 ;
    rcap:coreStatus "revised" ;
    rcap:inVersion "4.0" ;
    rcap:occursIn "CORE40" ;
    rcap:revisionOf rcap:rcdb4b81960 .

rcap:ca2a9916271 a owl:Class ;
    rdfs:label "Clinical treatment decisions are often made prior to the availability of microbiological test results and may rely on history, examination and supporting investigations such as inflammatory markers and imaging (“clinical assessment”) to include or exclude potential infecting pathogen(s) relevant to those decisions." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "PANDA" .

rcap:ca33244a322 a owl:Class ;
    rdfs:label "not receiving qualifying organ failure support AND" ;
    rdfs:subClassOf rcap:CategorySpecification ;
    rcap:occursIn "PANDA" .

rcap:ca35d9ae3e3 a owl:Class ;
    rdfs:label "Suspected or proven infection with resistant bacteria where agents being trialed would not be expected to be active. This includes cystic fibrosis, bronchiectasis or other chronic suppurative lung disease where infection with Pseudomonas may be suspected but does not include patients with suspected methicillin-resistant staphylococcus aureus (MRSA) infection*." ;
    rdfs:subClassOf obo:OBI_0500028 ;
    rcap:occursIn "AB_DSA;TAB_DSA" .

rcap:ca37e9eebf6 a owl:Class ;
    rdfs:label "The duration of macrolide therapy will then be determined by allocation in this domain." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "MD_DSA" .

rcap:ca38602c04e a owl:Class ;
    rdfs:label "New or worsening respiratory symptoms that developed within 2 weeks prior to the onset of oxygen/respiratory support" ;
    rdfs:subClassOf rcap:CategorySpecification ;
    rcap:occursIn "PANDA" .

rcap:ca3c788e844 a owl:Class ;
    rdfs:label "receiving qualifying organ failure support AND" ;
    rdfs:subClassOf rcap:CategorySpecification ;
    rcap:occursIn "PANDA" .

rcap:ca3cd41bbeb a owl:Class ;
    rdfs:label "Actions following Statistical Trigger for superiority, efficacy, inferiority, or harm If an intervention reaches one of the above thresholds and the DSMB declares this as a Platform Conclusion, the ITSC will be informed that the trigger has been met." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:coreStatus "same" ;
    rcap:occursIn "CORE40;CORE41" .

rcap:ca44d73b6be a owl:Class ;
    rdfs:label "Extracorporeal life support (ECLS)" ;
    rdfs:subClassOf rcap:EndpointSpecification ;
    rcap:coreStatus "only_41" ;
    rcap:occursIn "CORE41" .

rcap:ca4f15ec584 a owl:Class ;
    rdfs:label "MERS-CoV" ;
    rdfs:subClassOf rcap:CategorySpecification ;
    rcap:occursIn "PANDA" .

rcap:ca581855e50 a owl:Class ;
    rdfs:label "Macrolide antibiotics have already been discontinued for more than 36 hours" ;
    rdfs:subClassOf obo:OBI_0500028 ;
    rcap:occursIn "MD_DSA" .

rcap:ca58ce41d12 a owl:Class ;
    rdfs:label "Enteral azithromycin" ;
    rdfs:subClassOf rcap:InterventionSpecification ;
    rcap:occursIn "AB_DSA;TAB_DSA" .

rcap:ca5d0396f02 a owl:Class ;
    rdfs:label "Patient has already received any dose of one or more of any form of tocilizumab or another IL-6 receptor antagonist (e.g. sarilumab), baricitinib or another JAK inhibitor (e.g. tofacitinib, ruxolitinib or upadacitinib) during this hospitalization or is on long-term therapy with any of these agents prior to this hospital admission." ;
    rdfs:subClassOf obo:OBI_0500028 ;
    rcap:occursIn "IIM_DSA" .

rcap:ca60d0073b2 a owl:Class ;
    rdfs:label "This Appendix defines the following categories at the time of randomization:" ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "PANDA" .

rcap:ca69a8b569c a owl:Class ;
    rdfs:label "For the purposes of this intervention, septic shock is defined as administration of any vasopressor by continuous infusion where the treating clinician believes that the vasopressor requirement is caused by the respiratory tract infection and is not being administered for another reason such as untreated hypovolemia or solely to offset the effects of other interventions such as administration of sedation or mechanical ventilation." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "CS_DSA" .

rcap:ca6b1d7af7a a owl:Class ;
    rdfs:label "Known serious hypersensitivity to the macrolide will result in exclusion from interventions that include piperacillin, amoxicillin, and ceftriaxone" ;
    rdfs:subClassOf obo:OBI_0500028 ;
    rcap:occursIn "AB_DSA" .

rcap:ca6e134ec22 a owl:Class ;
    rdfs:label "Bacterial infection is stratified as bacterial infection diagnosed (comprising cases where infection with a recognized bacterial respiratory pathogen is confirmed or probable) and bacterial infection not diagnosed (comprising cases where infection with a recognized bacterial respiratory pathogen is neither confirmed nor probable i.e., bacterial infection was assessed as only possible or not suspected)." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "PANDA" .

rcap:ca7233a7d9d a owl:Class ;
    rdfs:label "A novel pandemic respiratory pathogen" ;
    rdfs:subClassOf rcap:CategorySpecification ;
    rcap:occursIn "PANDA" .

rcap:ca7be08f164 a owl:Class ;
    rdfs:label "Hospitalized patient" ;
    rdfs:subClassOf obo:OBI_0500027 ;
    rcap:coreStatus "same" ;
    rcap:occursIn "CORE40;CORE41" .

rcap:ca7dd1a0df3 a owl:Class ;
    rdfs:label "Results of culture of blood for pathogenic bacteria and/or fungus during this hospitalization" ;
    rdfs:subClassOf rcap:DataCollectionSpecification ;
    rcap:occursIn "IIM_DSA" .

rcap:ca8098dc8a3 a owl:Class ;
    rdfs:label "In adults and in children ≥ 9 years of age, a baseline eGFR <15 mL/min/1.73m 2 and/or receipt of renal replacement therapy (including long-term renal replacement therapy) at baseline will result in exclusion from receiving baricitinib" ;
    rdfs:subClassOf obo:OBI_0500028 ;
    rcap:occursIn "IIM_DSA" .

rcap:ca8c5ba6b39 a owl:Class ;
    rdfs:label "The timing of the revealing of allocation status and administration of interventions is specified to be Randomization with Immediate Reveal and Initiation or Randomization with Deferred Reveal and Initiation if prospective agreement to participate is required for this domain (see relevant Core Protocol documents)." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "CS_DSA" .

rcap:ca8ce9c3f7e a owl:Class ;
    rdfs:label "Administration of relevant concomitant medications" ;
    rdfs:subClassOf rcap:DataCollectionSpecification ;
    rcap:coreStatus "same" ;
    rcap:occursIn "CORE40;CORE41" .

rcap:ca9ac94debc a owl:Class ;
    rdfs:label "The delivery of protocolized mechanical ventilation will be facilitated by training of site personnel, the availability of bedside study tools, and audit and feedback to sites regarding adherence to the protocol." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "MV_DSA" .

rcap:caa02ba49d4 a owl:Class ;
    rdfs:label "Patients allocated to the no corticosteroid intervention are not to receive any systemic corticosteroid, including hydrocortisone or dexamethasone, for this respiratory tract infection and its direct complications up until study day 28 or hospital discharge, whichever occurs first." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "CS_DSA" .

rcap:cab1ce74ed4 a owl:Class ;
    rdfs:label "Viral variants. Method of viral testing and analysis will vary from country to country and will be within country-specific testing guidance document." ;
    rdfs:subClassOf rcap:DataCollectionSpecification ;
    rcap:occursIn "IG_DSA" .

rcap:cab49a930cf a owl:Class ;
    rdfs:label "For some pathogens, clinical features may be sufficiently similar that a domain considers them collectively (e.g., ‘confirmed viral respiratory tract infection’ may be a group defined as the detection of any virus known to cause respiratory tract infection on microbiological testing)." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "PANDA" .

rcap:cabc9ae0474 a owl:Class ;
    rdfs:label "Receiving respiratory support with high-flow nasal oxygen (HFNO) at a flow rate of at least 30 liters per minute (or at least 2 liters per minute per kilogram of bodyweight in children less than 15 kilograms) OR invasive mechanical ventilation (IMV), non-invasive ventilation (NIV) or continuous positive airways pressure (CPAP) with PEEP or CPAP ≥5cm H 2 O. (This criterion is not required in resource-limited settings where none of these modalities are available)" ;
    rdfs:subClassOf rcap:CategorySpecification ;
    rcap:occursIn "PANDA" .

rcap:cac352d8efe a owl:Class ;
    rdfs:label "Confirmed proximal deep venous thrombosis" ;
    rdfs:subClassOf rcap:EndpointSpecification ;
    rcap:occursIn "END_DSA" .

rcap:cac579e3b99 a owl:Class ;
    rdfs:label "We acknowledge mortality is tied to a longer time frame than the ordinal scale." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:coreStatus "only_41" ;
    rcap:occursIn "CORE41" .

rcap:cad22b7129d a owl:Class ;
    rdfs:label "If a Statistical Trigger is achieved this will be communicated by the SAC to the DSMB." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:coreStatus "same" ;
    rcap:occursIn "CORE40;CORE41" .

rcap:cad81daa211 a owl:Class ;
    rdfs:label "If reveal of allocation occurs before Study Day 3, and the patient is allocated to standard course macrolide, the intervention should be ceased on Study Day 3." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "MD_DSA" .

rcap:caddd53de20 a owl:Class ;
    rdfs:label "There is no automated adaptation when equivalence is deemed to have occurred." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:coreStatus "same" ;
    rcap:occursIn "CORE40;CORE41" .

rcap:cae2185962c a owl:Class ;
    rdfs:label "Date and time of hospital admission and discharge" ;
    rdfs:subClassOf rcap:DataCollectionSpecification ;
    rcap:coreStatus "same" ;
    rcap:occursIn "CORE40;CORE41" .

rcap:caef1c59e4d a owl:Class ;
    rdfs:label "Daily targets for physiological parameters, if specified" ;
    rdfs:subClassOf rcap:DataCollectionSpecification ;
    rcap:occursIn "MV_DSA" .

rcap:caf1c7e456b a owl:Class ;
    rdfs:label "The eligibility criteria for this domain correspond to the Influenza Infection Confirmed Stratum (i.e." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "IIM_DSA" .

rcap:cafe6794404 a owl:Class ;
    rdfs:label "Screening information, including Platform, domain and intervention eligibility criteria" ;
    rdfs:subClassOf rcap:DataCollectionSpecification ;
    rcap:coreStatus "same" ;
    rcap:occursIn "CORE40;CORE41" .

rcap:cb045c9a15d a owl:Class ;
    rdfs:label "Amoxicillin-clavulanate 1.2 grams administered IV every 8 hours" ;
    rdfs:subClassOf rcap:InterventionSpecification ;
    rcap:occursIn "TAB_DSA" .

rcap:cb09bcf457d a owl:Class ;
    rdfs:label "Initial intravenous (IV) administration of a macrolide is strongly preferred" ;
    rdfs:subClassOf rcap:InterventionSpecification ;
    rcap:occursIn "MD_DSA" .

rcap:cb0ae4a3b67 a owl:Class ;
    rdfs:label "A specific antibiotic choice is indicated, for example:" ;
    rdfs:subClassOf obo:OBI_0500028 ;
    rcap:occursIn "AB_DSA;TAB_DSA" .

rcap:cb108da728c a owl:Class ;
    rdfs:label "It is also known that treatment with corticosteroids can result in myopathy and muscle weakness but this effect will be evaluated by the aggregate effect of treatment, in conjunction with other factors, on the duration of mechanical ventilation and long-term outcomes, for participants enrolled at sites that are collecting long-term outcomes." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "CS_DSA" .

rcap:cb18d74602f a owl:Class ;
    rdfs:label "Known serious hypersensitivity to beta-lactams, including penicillins or cephalosporins, will result in exclusion from interventions that include amoxicillin and ceftazidime" ;
    rdfs:subClassOf obo:OBI_0500028 ;
    rcap:occursIn "TAB_DSA" .

rcap:cb1dfbad5c4 a owl:Class ;
    rdfs:label "The unit-of-analysis for this domain is all patients who receive an allocation status in this domain." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "AB_DSA;END_DSA;MD_DSA;TAB_DSA" .

rcap:cb214214243 a owl:Class ;
    rdfs:label "Adapt the domain to better refine the optimal characteristics of interventions (i.e., duration or dose)" ;
    rdfs:subClassOf rcap:AllocationSpecification ;
    rcap:coreStatus "same" ;
    rcap:occursIn "CORE40;CORE41" .

rcap:cb23c46b462 a owl:Class ;
    rdfs:label "The introduction and transition to spontaneous ventilation is at the discretion of the treating clinician." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "MV_DSA" .

rcap:cb26af16384 a owl:Class ;
    rdfs:label "Patients will be randomly assigned to receive one of the following open-label study interventions." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "AB_DSA;CS_DSA;END_DSA;IG_DSA;IIM_DSA;MD_DSA;MV_DSA;TAB_DSA" .

rcap:cb31eb2bc1f a owl:Class ;
    rdfs:label "The ITSC in conjunction with the DSMB may undertake additional analyses, for example, of clinically relevant secondary endpoints." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:coreStatus "same" ;
    rcap:occursIn "CORE40;CORE41" .

rcap:cb34d84e7ea a owl:Class ;
    rdfs:label "Continuous infusion of vasopressors, inotropes or both" ;
    rdfs:subClassOf obo:IAO_0000033 ;
    rcap:coreStatus "only_41" ;
    rcap:occursIn "CORE41;PANDA" .

rcap:cb366f79e1b a owl:Class ;
    rdfs:label "Serious Adverse Events (SAE) as defined in Core Protocol documents and qualified in this DSA" ;
    rdfs:subClassOf rcap:EndpointSpecification ;
    rcap:occursIn "IG_DSA" .

rcap:cb3f54800eb a owl:Class ;
    rdfs:label "There are no intervention-specific exclusion criteria for this domain." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "MD_DSA" .

rcap:cb41b0cebb4 a owl:Class ;
    rdfs:label "The clinician will choose the mode of ventilation and all ventilatory parameters that they would use normally for this patient." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "MV_DSA" .

rcap:cb41d7b2b8c a owl:Class ;
    rdfs:label "The use of any other mode of controlled mechanical ventilation (Pressure Control, APRV) is a protocol deviation." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "MV_DSA" .

rcap:cb47d826c76 a owl:Class ;
    rdfs:label "If a Platform Conclusion arises because one or more pairs of interventions reach a Statistical Trigger for equivalence or noninferiority within a unit-of-analysis, this will be communicated to the ITSC by the DSMB." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:coreStatus "same" ;
    rcap:occursIn "CORE40;CORE41" .

rcap:cb59ab3377d a owl:Class ;
    rdfs:label "From completion of the 10-day course onwards, patients allocated to this intervention are not to receive any systemic corticosteroid, including hydrocortisone or dexamethasone, for this respiratory tract infection and its direct complications up until study day 28 or hospital discharge, whichever occurs first." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "CS_DSA" .

rcap:cb769fefc84 a owl:Class ;
    rdfs:label "RSV infection is stratified as RSV infection confirmed (RSV detected on microbiological testing with a compatible clinical assessment) and RSV not confirmed." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "PANDA" .

rcap:cb7befa7b3a a owl:Class ;
    rdfs:label "Dosing is determined by the treating clinician and the following are provided as a guide." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "IAV_DSA" .

rcap:cb7f092fa32 a owl:Class ;
    rdfs:label "Ventilator-associated, a subcategory of hospital-acquired infection, additionally defined as infection in an invasively ventilated patient manifesting 48 hours or more after endotracheal intubation" ;
    rdfs:subClassOf rcap:CategorySpecification ;
    rcap:occursIn "PANDA" .

rcap:cb87f53e4f6 a owl:Class ;
    rdfs:label "Given that the original ARDSnet including the standard PEEP arm is frequently the control group in ventilation studies and many units still deliver the original ARDS net protocol (including the standard PEEP approach), we will allow units to use either FiO2 / PEEP table below." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "MV_DSA" .

rcap:cb93e454359 a owl:Class ;
    rdfs:label "Respiratory illness severity can change over time as a patient’s disease progresses and illness severity is an important determinate of both clinical outcome and potential differential treatment effect." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "PANDA" .

rcap:cba62d620cf a owl:Class ;
    rdfs:label "If the plateau pressure is more than 30 cmH 2 O, the tidal volume should be reduced in 5 to 10% increments, but to not less than 65% of the initial specified tidal volume (corresponding to 4.0 ml/kg PBW)." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "MV_DSA" .

rcap:cba8b5376a9 a owl:Class ;
    rdfs:label "Patient has community-acquired respiratory tract infection" ;
    rdfs:subClassOf obo:OBI_0500027 ;
    rcap:occursIn "AB_DSA;END_DSA;IIM_DSA;TAB_DSA" .

rcap:cbab88bbe86 a owl:Class ;
    rdfs:label "The ordinal weighted score will be analyzed with a covariate-adjusted linear model, and effects will be reported as a difference in average scores between treatment groups." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:coreStatus "only_41" ;
    rcap:occursIn "CORE41" .

rcap:cbac53fc942 a owl:Class ;
    rdfs:label "More than 24 hours has elapsed since commencement of sustained organ failure support" ;
    rdfs:subClassOf obo:OBI_0500028 ;
    rcap:occursIn "AB_DSA;TAB_DSA" .

rcap:cbb090195d3 a owl:Class ;
    rdfs:label "90-day mortality will be hierarchically integrated with the daily ordinal scale so that 90-day mortality will be deemed the worst possible category, regardless of prior trajectory." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:coreStatus "only_40" ;
    rcap:occursIn "CORE40" .

rcap:cbc08787e8f a owl:Class ;
    rdfs:label "Patients who are not eligible for this domain will be treated according to the current standard of care at the clinician’s discretion." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "IG_DSA" .

rcap:cbca0ca62ff a owl:Class ;
    rdfs:label "both a penicillin and a cephalosporin hypersensitivity)." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "AB_DSA" .

rcap:cbcd69628d6 a owl:Class ;
    rdfs:label "The most recent PaO 2 :FiO 2 ratio obtained within the preceding 6 hours is less than 200 mmHg" ;
    rdfs:subClassOf obo:OBI_0500027 ;
    rcap:occursIn "MV_DSA" .

rcap:cbd968086d6 a owl:Class ;
    rdfs:label "IV or enteral erythromycin. Sites in which only erythromycin is available are not able to participate in the Macrolide Duration Domain." ;
    rdfs:subClassOf rcap:InterventionSpecification ;
    rcap:occursIn "AB_DSA;TAB_DSA" .

rcap:cbd9f9062ae a owl:Class ;
    rdfs:label "All participants who die before the end of study day 90 will be coded as ‘-1’ on the ordinal scale, the worst score." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:coreStatus "only_41" ;
    rcap:occursIn "CORE41" .

rcap:cbde5a9f0f5 a owl:Class ;
    rdfs:label "Where a Platform Conclusion is reached for superiority or efficacy, the DSMB may recommend that Public Disclosure should be delayed until additional results are available, so as to allow further recruitment to evaluate interactions between interventions in different domains or for other clinically or statistically valid reasons." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:coreStatus "same" ;
    rcap:occursIn "CORE40;CORE41" .

rcap:cbde5b937d8 a owl:Class ;
    rdfs:label "Baseline and peak AST, ALT and bilirubin (between randomization and day 15)" ;
    rdfs:subClassOf rcap:DataCollectionSpecification ;
    rcap:occursIn "END_DSA" .

rcap:cbdec051bf7 a owl:Class ;
    rdfs:label "Tocilizumab" ;
    rdfs:subClassOf rcap:InterventionSpecification ;
    rcap:occursIn "IIM_DSA" .

rcap:cbe129064a8 a owl:Class ;
    rdfs:label "Administration of imatinib" ;
    rdfs:subClassOf rcap:DataCollectionSpecification ;
    rcap:occursIn "END_DSA" .

rcap:cbe7e2bf784 a owl:Class ;
    rdfs:label "Sites where erythromycin is the only available macrolide will not be able to participate in this domain." ;
    rdfs:subClassOf rcap:InterventionSpecification ;
    rcap:occursIn "MD_DSA" .

rcap:cbe8e555e2e a owl:Class ;
    rdfs:label "Reveal of allocation in the Macrolide Duration Domain is only possible before the end of Study Day 5 after randomization to a macrolide-containing intervention within an Antibiotic Domain of this Platform." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "MD_DSA" .

rcap:cbf77e1f709 a owl:Class ;
    rdfs:label "Patients are eligible for this domain only if they have been allocated a macrolide-containing intervention within an Antibiotic Domain of this Platform." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "MD_DSA" .

rcap:cbf7925c08d a owl:Class ;
    rdfs:label "The size of the pre-specified odds ratio delta is 0.10." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "AB_DSA;CS_DSA;IAV_DSA;IIM_DSA;TAB_DSA" .

rcap:cc02a7653f7 a owl:Class ;
    rdfs:label "If there is doubt about accuracy of a SaO 2 , arterial blood gases should be measured and used to adjust the PEEP and FiO 2 as required." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "MV_DSA" .

rcap:cc0ab609c4e a owl:Class ;
    rdfs:label "Oseltamivir twice daily for five days" ;
    rdfs:subClassOf rcap:InterventionSpecification ;
    rcap:occursIn "IAV_DSA" .

rcap:cc0ad33a8ee a owl:Class ;
    rdfs:label "The options following a Statistical Trigger for a pair of interventions in a Domain with three or more Interventions are more complex." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:coreStatus "same" ;
    rcap:occursIn "CORE40;CORE41" .

rcap:cc0c73f73da a owl:Class ;
    rdfs:label "The generic variables to be collected for all domains in this Platform are as detailed below." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:coreStatus "same" ;
    rcap:occursIn "CORE40;CORE41" .

rcap:cc1810a8322 a owl:Class ;
    rdfs:label "Qualifying organ failure support is defined as: Patients are not eligible for randomization in the Moderate State if they have been previously randomized in the Severe State, if they have previously been randomized in the Recovering State, or if they have received invasive mechanical ventilation at any time during this acute admission." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "PANDA" .

rcap:cc26608429f a owl:Class ;
    rdfs:label "These States are defined in Core Protocol documents." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "CS_DSA;IAV_DSA;IG_DSA" .

rcap:cc28e5ec339 a owl:Class ;
    rdfs:label "For the presence of a pathogen to be ‘confirmed’ or ‘excluded’, there must be supportive microbiological testing." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "PANDA" .

rcap:cc2adca9ada a owl:Class ;
    rdfs:label "While it is expected that all sites will participate in the ceftriaxone intervention, each site has the option to opt-in to one or more of the remaining three interventions based on local practice and the availability of the antibiotic in the country." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "AB_DSA" .

rcap:cc2ba8bee5c a owl:Class ;
    rdfs:label "For the purposes of eligibility, domains may include patients with differing likelihood thresholds for the same pathogen (e.g., one domain may include patients with suspected or confirmed influenza infection and another may constrain eligibility to confirmed infection only)." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "PANDA" .

rcap:cc3e5be1718 a owl:Class ;
    rdfs:label "MERS-CoV infection is stratified as MERS-CoV infection confirmed (MERS-CoV detected on microbiological testing with a compatible clinical assessment) and MERS-CoV not confirmed." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "PANDA" .

rcap:cc3ec0b825c a owl:Class ;
    rdfs:label "Receiving immune suppressive therapy with a calcineurin inhibitor (e.g. cyclosporine, tacrolimus), everolimus or sirolimus will exclude a patient from receiving enteral imatinib" ;
    rdfs:subClassOf obo:OBI_0500028 ;
    rcap:occursIn "END_DSA" .

rcap:cc3fd74fe4a a owl:Class ;
    rdfs:label "Any recognized viral respiratory pathogen other than influenza, SARS-CoV-2, MERS-CoV or RSV (grouped together)" ;
    rdfs:subClassOf rcap:CategorySpecification ;
    rcap:occursIn "PANDA" .

rcap:cc40460369d a owl:Class ;
    rdfs:label "Tocilizumab will be administered as a single dose of 8mg/kg based on measured body weight (or estimated body weight in adults if measured body weight is unavailable) with the total dose not exceeding 800mg." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "IIM_DSA" .

rcap:cc434dea8eb a owl:Class ;
    rdfs:label "The rationale for this is that each of these interventions comprises a beta-lactam antibiotic combined with a macrolide." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "AB_DSA" .

rcap:cc4a3982cda a owl:Class ;
    rdfs:label "Patients will be excluded from this domain if they have any of the following:" ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "AB_DSA;CS_DSA;END_DSA;IAV_DSA;IG_DSA;IIM_DSA;MD_DSA;MV_DSA;TAB_DSA" .

rcap:cc4b95a9b0a a owl:Class ;
    rdfs:label "Each pathogen status used for analysis is defined as a binary variable at Platform level." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "PANDA" .

rcap:cc4d4bee65c a owl:Class ;
    rdfs:label "High-flow nasal oxygen*" ;
    rdfs:subClassOf rcap:EndpointSpecification ;
    rcap:coreStatus "only_41" ;
    rcap:occursIn "CORE41" .

rcap:cc4efc1a692 a owl:Class ;
    rdfs:label "Interactions with all other domains are either not evaluable or not considered possible and will not be incorporated into the statistical model or models in which this domain is evaluated." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "AB_DSA;CS_DSA;END_DSA;IAV_DSA;IG_DSA;IIM_DSA;MD_DSA;MV_DSA;TAB_DSA" .

rcap:cc52e0becdf a owl:Class ;
    rdfs:label "In addition to Platform inclusion and exclusion criteria, a domain can restrict eligibility by specifically including or excluding patients with a specific pathogen status (including co-infection) as domain eligibility criteria." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "PANDA" .

rcap:cc5809dffc7 a owl:Class ;
    rdfs:label "As exploratory outcomes, the exact categorizations of respiratory support may change in both of the above exploratory outcomes, which will be transparently reported in publications and presentations." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:coreStatus "only_41" ;
    rcap:occursIn "CORE41" .

rcap:cc60d05ae13 a owl:Class ;
    rdfs:label "Acute myocardial infarction" ;
    rdfs:subClassOf rcap:EndpointSpecification ;
    rcap:occursIn "END_DSA" .

rcap:cc66e2d09a4 a owl:Class ;
    rdfs:label "Hospitalized on low-intensity oxygen" ;
    rdfs:subClassOf rcap:EndpointSpecification ;
    rcap:coreStatus "moved" ;
    rcap:occursIn "CORE40;CORE41" .

rcap:cc69f3a284d a owl:Class ;
    rdfs:label "At the time of establishing eligibility, if feasible, the patient’s height will be entered into the on-line eligibility system which will be used to calculate PBW and to specify a starting tidal volume that will be set on the ventilator that corresponds to a tidal volume of 6.0 ml/kg PBW." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "MV_DSA" .

rcap:cc6cadc9e2c a owl:Class ;
    rdfs:label "This endpoint is designed to encompass all illness severity states, and builds on our experience with the distribution and power of the primary endpoints used in previous versions of this Core Protocol and the Pandemic Appendix to the Core Protocol." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:coreStatus "same" ;
    rcap:occursIn "CORE40;CORE41" .

rcap:cc769ad72db a owl:Class ;
    rdfs:label "At the time of establishing eligibility, the treating clinician will specify a target range for the arterial PaCO 2 ." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "MV_DSA" .

rcap:cc80fdb595f a owl:Class ;
    rdfs:label "Disability status measured at 180 days after enrollment using the WHODAS 2.0, 12-item instrument (where feasible, refer to relevant regional RSA) in those aged 18 or older" ;
    rdfs:subClassOf rcap:EndpointSpecification ;
    rcap:coreStatus "same" ;
    rcap:occursIn "CORE40;CORE41" .

rcap:cc8e4c6a249 a owl:Class ;
    rdfs:label "Pulmonary edema precipitated by respiratory tract infection and not exclusively or primarily attributable to cardiac failure or fluid overload with hypoxemia not primarily attributable to atelectasis" ;
    rdfs:subClassOf rcap:CategorySpecification ;
    rcap:occursIn "PANDA" .

rcap:cc905bfb5f1 a owl:Class ;
    rdfs:label "Response Adaptive Randomization will not be applied to this domain." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "IG_DSA;TAB_DSA" .

rcap:cc94f676f8f a owl:Class ;
    rdfs:label "The dosing of and route of administration of macrolide antibiotics are not specified in the protocol but the following guidance is provided:" ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "MD_DSA" .

rcap:cc977d9946c a owl:Class ;
    rdfs:label "Septic shock would always be regarded as having resolved if vasopressor infusion has not been administered in the preceding 24 hours." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "CS_DSA" .

rcap:cc99a9f0acf a owl:Class ;
    rdfs:label "Change to targeted antibiotic therapy if a causative microbiological diagnosis has been made, and continue assigned melioidosis-specific treatment (ceftazidime or meropenem) if melioidosis is confirmed, and transition to oral eradication therapy based on local practices and guidelines (usually trimethoprim-sulfamethoxazole for 3-6 months)." ;
    rdfs:subClassOf rcap:InterventionSpecification ;
    rcap:occursIn "TAB_DSA" .

rcap:cca301735af a owl:Class ;
    rdfs:label "Severe thrombocytopenia (defined as platelet count <50 x 10 9 /L)" ;
    rdfs:subClassOf rcap:EndpointSpecification ;
    rcap:occursIn "END_DSA" .

rcap:ccbc477aff8 a owl:Class ;
    rdfs:label "The threshold probability for statistical triggers for superiority and inferiority are those specified in the Core Protocol documents." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "AB_DSA;TAB_DSA" .

rcap:ccc10ee88ac a owl:Class ;
    rdfs:label "A baseline neutrophil count <1.0 x 10 9 /L will exclude a patient from receiving enteral imatinib" ;
    rdfs:subClassOf obo:OBI_0500028 ;
    rcap:occursIn "END_DSA" .

rcap:ccc13cbc8a7 a owl:Class ;
    rdfs:label "The hypoxemia is caused by acute respiratory infection (and not primarily due to other causes such as acute heart failure, fluid overload, or pulmonary embolism)" ;
    rdfs:subClassOf rcap:CategorySpecification ;
    rcap:occursIn "PANDA" .

rcap:ccd4355519f a owl:Class ;
    rdfs:label "The timing of the revealing of allocation status and administration of interventions is specified to be Randomization with Deferred Reveal once the results of microbiological testing to establish domain eligibility are available, or if prospective agreement to participate is required for this domain." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "MD_DSA" .

rcap:ccd60c004da a owl:Class ;
    rdfs:label "For a domain with three or more interventions, the information provided by the DSMB to the ITSC may include specification of the ordinal rank of the interventions within the domain." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:coreStatus "same" ;
    rcap:occursIn "CORE40;CORE41" .

rcap:ccdc64e11f3 a owl:Class ;
    rdfs:label "If RAR is applied, the cap on the maximum or minimum proportion of patients assigned to an intervention that is specified in core protocol documents may be modified by the Statistical Analysis Committee (SAC) if needed to reduce the likelihood of sites being unblinded or to improve power." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "CS_DSA;END_DSA;IAV_DSA;IIM_DSA" .

rcap:ccddbe3fd4b a owl:Class ;
    rdfs:label "No Endothelial modulator therapy" ;
    rdfs:subClassOf rcap:InterventionSpecification ;
    rcap:occursIn "END_DSA" .

rcap:cce1901356c a owl:Class ;
    rdfs:label "All interventions are administered until the stated duration of therapy has been reached or until hospital discharge (whichever occurs first)." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "IAV_DSA" .

rcap:cce99450a79 a owl:Class ;
    rdfs:label "A full blood count (to monitor for cytopenias) and liver function tests (bilirubin, ALT +/- AST) should be performed, as part of usual care, at least twice weekly whilst receiving enteral imatinib." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "END_DSA" .

rcap:ccecc33eb10 a owl:Class ;
    rdfs:label "The FiO 2 and PEEP should be set on the ventilator to the minimum allowable combination of FiO 2 and PEEP that consistently achieves a PaO 2 / SaO 2 within the target range and adjusted further, as required according to either of the tables below which is derived from either the ARMA ARDSnet trial (the standard PEEP arm) OR the LOVS and ALVEOLI trials (the high PEEP arm) (Meade et al., 2008, Brower et al., 2004)." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "MV_DSA" .

rcap:cceee3b61f1 a owl:Class ;
    rdfs:label "Discharged from index hospitalization" ;
    rdfs:subClassOf rcap:EndpointSpecification ;
    rcap:coreStatus "only_40" ;
    rcap:occursIn "CORE40" .

rcap:ccfef3c27d2 a owl:Class ;
    rdfs:label "Patients enrolled in previous versions of this DSA to the 10-day oseltamivir intervention will continue to be nested with the 5-day oseltamivir intervention." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "IAV_DSA" .

rcap:cd0dc3a1b8d a owl:Class ;
    rdfs:label "The dose of baricitinib is dependent on age and renal function." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "IIM_DSA" .

rcap:cd0ec3ba25a a owl:Class ;
    rdfs:label "Administration of immune modulatory agents intended to influence host response to infection" ;
    rdfs:subClassOf rcap:DataCollectionSpecification ;
    rcap:occursIn "END_DSA" .

rcap:cd236bdcb8b a owl:Class ;
    rdfs:label "Respiratory tract infection can be associated with specific clinical features or syndromes." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "PANDA" .

rcap:cd269ca08fb a owl:Class ;
    rdfs:label "Patients assigned to this intervention will not receive any preparation of polyclonal immunoglobulin intended to neutralize COVID-19 during the index hospitalization." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "IG_DSA" .

rcap:cd2a29aeec5 a owl:Class ;
    rdfs:label "Virologic endpoints, at selected sites:" ;
    rdfs:subClassOf rcap:DataCollectionSpecification ;
    rcap:occursIn "IIM_DSA" .

rcap:cd3604c9617 a owl:Class ;
    rdfs:label "It is noted that the definition of shock that is specified in the Core Protocol (presence or absence of inotrope or vasopressor infusion at baseline) determines strata status, and not the definition of septic shock that is used to define administration of hydrocortisone in the shock-dependent duration hydrocortisone intervention." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "CS_DSA" .

rcap:cd39e0ef162 a owl:Class ;
    rdfs:label "In pregnancy dexamethasone should be replaced by oral prednisolone 40mg once daily or IV hydrocortisone 50mg every 6 hours for 10 days while in hospital." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "CS_DSA" .

rcap:cd3a5049ef6 a owl:Class ;
    rdfs:label "There will be a list of tertiary outcomes where no formal hypothesis tests will be performed." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:coreStatus "same" ;
    rcap:occursIn "CORE40;CORE41" .

rcap:cd3b3a61b4c a owl:Class ;
    rdfs:label "The dose of tocilizumab is dependent on age and weight." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "IIM_DSA" .

rcap:cd447210279 a owl:Class ;
    rdfs:label "In children the dose of dexamethasone will be 0.15 mg/kg (max 6mg/day) for a maximum of 10 days while in hospital." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "CS_DSA" .

rcap:cd48313d7dc a owl:Class ;
    rdfs:label "Patients who are eligible for only a single intervention at a site (i.e., all other interventions are contraindicated or not available) are not eligible for this domain." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "IAV_DSA" .

rcap:cd4e923874a a owl:Class ;
    rdfs:label "The preferred enteral macrolide is azithromycin, but enteral clarithromycin or roxithromycin may be substituted." ;
    rdfs:subClassOf rcap:InterventionSpecification ;
    rcap:occursIn "MD_DSA" .

rcap:cd52a12348a a owl:Class ;
    rdfs:label "Enteral clarithromycin or roxithromycin" ;
    rdfs:subClassOf rcap:InterventionSpecification ;
    rcap:occursIn "AB_DSA;TAB_DSA" .

rcap:cd55c1341f6 a owl:Class ;
    rdfs:label "Fixed duration dexamethasone for 10 days" ;
    rdfs:subClassOf rcap:InterventionSpecification ;
    rcap:occursIn "CS_DSA" .

rcap:cd5cc6b9856 a owl:Class ;
    rdfs:label "If the PaCO 2 target cannot be achieved the respiratory rate should be adjusted upwards preserving, at all times (unless pH of arterial blood is less than 7.15 see below), the tidal volume (and plateau pressure target)." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "MV_DSA" .

rcap:cd6c006ce42 a owl:Class ;
    rdfs:label "If a patient develops neutropenia (neutrophil count <1.0 x 10 9 /L) and/or thrombocytopenia (platelet count <50 x 10 9 /L), stop imatinib and do not restart" ;
    rdfs:subClassOf rcap:InterventionSpecification ;
    rcap:occursIn "END_DSA" .

rcap:cd715a78d79 a owl:Class ;
    rdfs:label "Nesting high titer plasma with low titer plasma in the Non-Immune Suppressed strata is intended to reduce the amount of information borrowed from the previous positive result." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "IG_DSA" .

rcap:cd7c43ab99a a owl:Class ;
    rdfs:label "If not specified by a domain, guidance about qualifying microbiological testing will be provided in operational documents." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "PANDA" .

rcap:cd7c91b15f5 a owl:Class ;
    rdfs:label "Multi-resistant organisms (MRO) colonization/infection: Isolation of multi-drug resistant (MDR) bacteria from clinical or screening specimens including vancomycin resistant enterococci (VRE), MRSA, extended spectrum beta-lactamase (ESBL)-producing enterobacteriaceae, carbapenem resistant enterobacteriaceae (CRE)." ;
    rdfs:subClassOf rcap:EndpointSpecification ;
    rcap:occursIn "AB_DSA;TAB_DSA" .

rcap:cd7e3bd8fce a owl:Class ;
    rdfs:label "Serious adverse event (SAE) as defined in Core Protocol" ;
    rdfs:subClassOf rcap:EndpointSpecification ;
    rcap:occursIn "AB_DSA;CS_DSA;IIM_DSA;MD_DSA;TAB_DSA" .

rcap:cd89c60e3af a owl:Class ;
    rdfs:label "The unit-of-analysis for this domain consists of all patients who have received an allocation in this domain, and is further stratified by illness severity state at time of enrollment (defined as either Moderate State or Severe State) and Immune Suppressed Strata." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "IG_DSA" .

rcap:cd8acafd0a6 a owl:Class ;
    rdfs:label "Such decisions will be specified in an amended DSA." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:coreStatus "same" ;
    rcap:occursIn "CORE40;CORE41" .

rcap:cd9bbfeda6a a owl:Class ;
    rdfs:label "The approach to a Statistical Trigger for equivalence or noninferiority is different depending on the number of interventions within a domain." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:coreStatus "same" ;
    rcap:occursIn "CORE40;CORE41" .

rcap:cd9cb1c9a3b a owl:Class ;
    rdfs:label "Under such circumstances, discontinuation of baricitinib prior to the end of the 10-day course is not a protocol deviation." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "IIM_DSA" .

rcap:cd9f81c7ca1 a owl:Class ;
    rdfs:label "Domain-specific efficacy outcomes, where applicable" ;
    rdfs:subClassOf rcap:EndpointSpecification ;
    rcap:coreStatus "same" ;
    rcap:occursIn "CORE40;CORE41" .

rcap:cda45f8b5ea a owl:Class ;
    rdfs:label "All patients recruited using versions of this DSA prior to Version 3 are classified as members of the No Prior Monoclonal Antibody sub-group." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "IG_DSA" .

rcap:cdb0dcd08e1 a owl:Class ;
    rdfs:label "Patient was receiving imatinib or another tyrosine kinase inhibitor targeting the same pathway as imatinib (i.e. dasatinib, nilotinib, ponatinib) prior to this hospital admission" ;
    rdfs:subClassOf obo:OBI_0500028 ;
    rcap:occursIn "END_DSA" .

rcap:cdb227e9044 a owl:Class ;
    rdfs:label "Protocolized mechanical ventilation strategy" ;
    rdfs:subClassOf rcap:InterventionSpecification ;
    rcap:occursIn "MV_DSA" .

rcap:cdb232416a7 a owl:Class ;
    rdfs:label "Pneumonia, defined in two categories, present or absent, with present defined as radiological evidence of new onset infiltrate consistent with infection (in patients with pre-existing radiological changes, evidence of new infiltrate)" ;
    rdfs:subClassOf rcap:CategorySpecification ;
    rcap:occursIn "PANDA" .

rcap:cdb38085787 a owl:Class ;
    rdfs:label "It is noted that interaction with these other domains that include patients with confirmed influenza as part of their unit-of-analysis will be evaluated as post-platform conclusion sub-groups." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "IIM_DSA" .

rcap:cdb5e5b5b01 a owl:Class ;
    rdfs:label "DSAs dated before this Core Protocol amendment will additionally report the pre-specified endpoints as indicated in their respective documents and previous versions of the Core Protocol (available on the trial website)." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:coreStatus "same" ;
    rcap:occursIn "CORE40;CORE41" .

rcap:cdb6639ba6e a owl:Class ;
    rdfs:label "The exact dose of vasopressor that defines septic shock is not set by the protocol but is based on the treating clinician’s judgement." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "CS_DSA" .

rcap:cdbae604627 a owl:Class ;
    rdfs:label "If no local guideline exists, recommendations based on estimated Glomerular Filtration Rate (eGFR) are as follows: Hemo(dia)filtration Hemo(dia)filtration Agent eGFR <30 ml/min (1-1.8 L/hr exchange) (>1.8 L/hr exchange) Oseltamivir 30 mg twice daily 30 mg twice daily 75 mg, twice daily Dosing for children is as per local guidelines." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "IAV_DSA" .

rcap:cdc78559427 a owl:Class ;
    rdfs:label "The threshold probability for the statistical trigger of effectiveness will be the same as that applied for superiority." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "IIM_DSA" .

rcap:cdc7ec59d43 a owl:Class ;
    rdfs:label "The Moderate State, defined as hospitalized patients who are:" ;
    rdfs:subClassOf rcap:CategorySpecification ;
    rcap:occursIn "PANDA" .

rcap:cdcbe6d2eed a owl:Class ;
    rdfs:label "Patient is aged ≥ 18 years old" ;
    rdfs:subClassOf obo:OBI_0500027 ;
    rcap:occursIn "END_DSA" .

rcap:cdd2be8e9cf a owl:Class ;
    rdfs:label "Hydrocortisone should be ceased prior to hospital discharge." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "CS_DSA" .

rcap:cdd710c464b a owl:Class ;
    rdfs:label "Patients randomized in early versions of this DSA who did not have confirmed influenza infection are not part of this unit of analysis." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "IAV_DSA" .

rcap:cdd715af259 a owl:Class ;
    rdfs:label "tested and not detected) based on clinical assessment and microbiological test results." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "PANDA" .

rcap:cdd87c4f09f a owl:Class ;
    rdfs:label "A standard set of secondary endpoints will be evaluated, including the components of the primary endpoint." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:coreStatus "only_41" ;
    rcap:occursIn "CORE41" .

rcap:cdd924bb867 a owl:Class ;
    rdfs:label "Standard course macrolide discontinued between day 3 and day 5 or at hospital discharge, whichever occurs first" ;
    rdfs:subClassOf rcap:InterventionSpecification ;
    rcap:occursIn "MD_DSA" .

rcap:cde10e40597 a owl:Class ;
    rdfs:label "For sites that are including the moxifloxacin or levofloxacin intervention it is strongly encouraged that the sites participate in at least one intervention that includes a cephalosporin and one intervention that includes a penicillin so that causal inference by random allocation is possible for patients who have known non-serious intolerance to either cephalosporins or penicillins but not both." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "AB_DSA" .

rcap:cde66571e15 a owl:Class ;
    rdfs:label "If a Platform Conclusion is reached, the ITSC will take responsibility to undertake Public Disclosure as soon as practicable with the dissemination of the research result via presentation or publication or both." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:coreStatus "same" ;
    rcap:occursIn "CORE40;CORE41" .

rcap:cde67788f7a a owl:Class ;
    rdfs:label "No corticosteroid (no placebo)" ;
    rdfs:subClassOf rcap:InterventionSpecification ;
    rcap:occursIn "CS_DSA" .

rcap:cde7d81c44b a owl:Class ;
    rdfs:label "As such, most patients who receive an allocation within this domain will have already received empiric antibiotic therapy prior to enrollment." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "AB_DSA;TAB_DSA" .

rcap:cdeac60dcf6 a owl:Class ;
    rdfs:label "Patients will be randomly assigned to receive one of the following open-label antiviral strategies, depending on illness severity." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "IAV_DSA" .

rcap:cdee1a90648 a owl:Class ;
    rdfs:label "The timing of the revealing of allocation status and administration of interventions is as specified to be Randomization with Immediate Reveal and Initiation, Delayed Reveal and Initiation, or Deferred Reveal and Initiation." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "MV_DSA" .

rcap:cdee655cc92 a owl:Class ;
    rdfs:label "Meropenem + Macrolide" ;
    rdfs:subClassOf rcap:InterventionSpecification ;
    rcap:occursIn "TAB_DSA" .

rcap:cdef3264f84 a owl:Class ;
    rdfs:label "Additional domain-specific variables are outlined in the relevant DSAs." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:coreStatus "same" ;
    rcap:occursIn "CORE40;CORE41" .

rcap:cdef6c52c73 a owl:Class ;
    rdfs:label "Suspected or proven concomitant infection such as meningitis" ;
    rdfs:subClassOf obo:OBI_0500028 ;
    rcap:occursIn "AB_DSA;TAB_DSA" .

rcap:cdf3f3063de a owl:Class ;
    rdfs:label "Confirmation of qualifying pathogen status may occur through a delayed reveal process if commencement of assigned treatment can reasonably be deferred." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "PANDA" .

rcap:cdffd88ebc9 a owl:Class ;
    rdfs:label "The standard dose for oseltamivir for adult patients is 75 mg enterally twice per day." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "IAV_DSA" .

rcap:ce075d8b7cc a owl:Class ;
    rdfs:label "An additional endpoint, that will be reported as it becomes available and only from sites where linked data is available, is occurrence of major adverse cardiovascular events." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "IIM_DSA" .

rcap:ce0a442373c a owl:Class ;
    rdfs:label "With respect to the adaptation of the domain, the following actions are possible:" ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:coreStatus "same" ;
    rcap:occursIn "CORE40;CORE41" .

rcap:ce0d5a36d2c a owl:Class ;
    rdfs:label "Immune suppression: Patients who have increased susceptibility to infection due to receipt of immunosuppressive treatment or due an immunosuppressive disease at the time of Platform enrollment are categorized as immune suppressed." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "PANDA" .

rcap:ce0effacc30 a owl:Class ;
    rdfs:label "Each DSA will specify which pathogens are relevant to the domain." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "PANDA" .

rcap:ce1d999722f a owl:Class ;
    rdfs:label "not in the Recovering State" ;
    rdfs:subClassOf rcap:CategorySpecification ;
    rcap:occursIn "PANDA" .

rcap:ce246d5a2ae a owl:Class ;
    rdfs:label "Statistical Triggers for equivalence in domains with three or more interventions may occur with or without Platform Conclusions and public disclosure of results, as determined by the ITSC and DSMB." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:coreStatus "same" ;
    rcap:occursIn "CORE40;CORE41" .

rcap:ce39d43c5e4 a owl:Class ;
    rdfs:label "Confirmed deep venous thrombosis" ;
    rdfs:subClassOf rcap:EndpointSpecification ;
    rcap:occursIn "IG_DSA" .

rcap:ce3a7f92a37 a owl:Class ;
    rdfs:label "Acute Hypoxemic Respiratory Failure is a State defined in two categories, present or absent, with ‘present’ defined as patients with all of the following:" ;
    rdfs:subClassOf rcap:CategorySpecification ;
    rcap:occursIn "PANDA" .

rcap:ce3b8327b04 a owl:Class ;
    rdfs:label "Hospitalized, no oxygen" ;
    rdfs:subClassOf rcap:EndpointSpecification ;
    rcap:coreStatus "moved" ;
    rcap:occursIn "CORE40;CORE41" .

rcap:ce3d8c467cd a owl:Class ;
    rdfs:label "Survival status at 90 days" ;
    rdfs:subClassOf rcap:DataCollectionSpecification ;
    rcap:coreStatus "same" ;
    rcap:occursIn "CORE40;CORE41" .

rcap:ce532680788 a owl:Class ;
    rdfs:label "For example, a domain could include participants with influenza virus infection, exclude patients with confirmed SARS-CoV-2 infection and exclude participants who have confirmed bacterial co-infection." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "PANDA" .

rcap:ce575914efd a owl:Class ;
    rdfs:label "There is no nesting of interventions in this domain." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "END_DSA;TAB_DSA" .

rcap:ce5c526ddb9 a owl:Class ;
    rdfs:label "Eligibility within these strata may be further constrained by domain-specific eligibility criteria specified below." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "CS_DSA;IAV_DSA;IG_DSA;IIM_DSA" .

rcap:ce5d9618bb0 a owl:Class ;
    rdfs:label "The following reasons should prompt discontinuation of imatinib therapy:" ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "END_DSA" .

rcap:ce5e7726301 a owl:Class ;
    rdfs:label "Clinician-preference mechanical ventilation strategy" ;
    rdfs:subClassOf rcap:InterventionSpecification ;
    rcap:occursIn "MV_DSA" .

rcap:ce60bf2679f a owl:Class ;
    rdfs:label "Other confirmed thrombotic events" ;
    rdfs:subClassOf rcap:EndpointSpecification ;
    rcap:occursIn "IG_DSA" .

rcap:ce697805e1b a owl:Class ;
    rdfs:label "However, integrating 90-day mortality with a shorter-term outcome is patient-centered and allows continuity with previous versions of the Core protocol and the Pandemic Appendix to the Core Protocol." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:coreStatus "only_41" ;
    rcap:occursIn "CORE41" .

rcap:ce6c5856c8f a owl:Class ;
    rdfs:label "Receipt of organ failure support" ;
    rdfs:subClassOf rcap:DataCollectionSpecification ;
    rcap:coreStatus "same" ;
    rcap:occursIn "CORE40;CORE41" .

rcap:ce7001d5827 a owl:Class ;
    rdfs:label "Receiving invasive mechanical ventilation" ;
    rdfs:subClassOf obo:OBI_0500027 ;
    rcap:occursIn "MV_DSA" .

rcap:ce70d7458d7 a owl:Class ;
    rdfs:label "The primary endpoint, named Survival and Recovery Trajectory, will be a composite of 90-day all-cause mortality and, among survivors, a daily ordinal scale analyzed as a trajectory of illness and recovery to 28 days." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:coreStatus "only_40" ;
    rcap:occursIn "CORE40" .

rcap:ce71bb98dce a owl:Class ;
    rdfs:label "Criteria for extubation, or insertion of a tracheostomy tube, are not specified by the trial and are at the discretion of the treating clinician." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "MV_DSA" .

rcap:ce7febd34c0 a owl:Class ;
    rdfs:label "The interventions in this domain apply up until study day 28 during the index hospitalization, noting that the criteria related to respiratory tract infection and its direct complications still apply." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "CS_DSA" .

rcap:ce9865c51f8 a owl:Class ;
    rdfs:label "Administration of a monoclonal antibody directed against SARS-CoV-2 was an exclusion criteria in all earlier versions of this DSA." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "IG_DSA" .

rcap:ce9fbd2a72d a owl:Class ;
    rdfs:label "The trajectory will be analyzed with a statistical model (Markov longitudinal proportional odds model) that captures how patients move through different health states over time, reported as an odds ratio with covariate adjustment." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:coreStatus "only_41" ;
    rcap:occursIn "CORE41" .

rcap:ceb8d951140 a owl:Class ;
    rdfs:label "Patient has an underlying immunodeficiency or has received recent immunosuppressant therapy, corresponding to the APACHE II definitions (Knaus et al., 1985) , extended to take into account equivalent forms of immunosuppressant therapy that post-date the APACHE II definitions." ;
    rdfs:subClassOf obo:OBI_0500027 ;
    rcap:occursIn "IG_DSA" .

rcap:cebb11ad03d a owl:Class ;
    rdfs:label "So as to achieve continuity with the initial phase of this domain, a stratum is defined as comprising patients who are immune suppressed." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "IG_DSA" .

rcap:cec9be7e972 a owl:Class ;
    rdfs:label "Aged 28 days or older" ;
    rdfs:subClassOf obo:OBI_0500027 ;
    rcap:coreStatus "same" ;
    rcap:occursIn "CORE40;CORE41" .

rcap:cecdd35161c a owl:Class ;
    rdfs:label "There is microbiological confirmation or the clinician strongly suspects Legionella or any other form of atypical pneumonia" ;
    rdfs:subClassOf obo:OBI_0500028 ;
    rcap:occursIn "MD_DSA" .

rcap:cecffffb51b a owl:Class ;
    rdfs:label "Patient is expected to be discharged from hospital within the next 24 hours" ;
    rdfs:subClassOf obo:OBI_0500028 ;
    rcap:coreStatus "same" ;
    rcap:occursIn "CORE40;CORE41" .

rcap:ced7c375feb a owl:Class ;
    rdfs:label "This domain is available to patients who are in the Adult Age Stratum, as defined in Core Protocol documents." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "AB_DSA;END_DSA;MD_DSA;MV_DSA;TAB_DSA" .

rcap:ceda595c821 a owl:Class ;
    rdfs:label "Dose adjustment for renal dysfunction in children will be per local guidelines." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "IAV_DSA" .

rcap:cedb34ad204 a owl:Class ;
    rdfs:label "Known condition or treatment resulting in ongoing immune suppression, including neutropenia, prior to this hospitalization" ;
    rdfs:subClassOf obo:OBI_0500028 ;
    rcap:occursIn "IIM_DSA" .

rcap:cedbd214eac a owl:Class ;
    rdfs:label "Criteria for readiness for a trial of unsupported or minimally supported spontaneous ventilation are not specified by the trial and are at the discretion of the treating clinician." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "MV_DSA" .

rcap:cedd28ca5fa a owl:Class ;
    rdfs:label "The primary endpoint is a composite of 90-day all-cause mortality and, among survivors, the number of days on which the patient was not receiving organ failure support (OFS) during the index hospitalization, up to the end of study day 28; and among survivors who never receive OFS, hospital free days for the index hospitalization up to the end of study day 28." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:coreStatus "only_41" ;
    rcap:occursIn "CORE41" .

rcap:cee36dc04d1 a owl:Class ;
    rdfs:label "Transfusion-transmitted infection occurring at any time during the study" ;
    rdfs:subClassOf rcap:DataCollectionSpecification ;
    rcap:occursIn "IG_DSA" .

rcap:cee7d1a66ec a owl:Class ;
    rdfs:label "The threshold probability of a statistical trigger for futility will be those specified in the Core Protocol." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "CS_DSA;IIM_DSA" .

rcap:cf04bc22981 a owl:Class ;
    rdfs:label "28-day survival" ;
    rdfs:subClassOf rcap:EndpointSpecification ;
    rcap:coreStatus "same" ;
    rcap:occursIn "CORE40;CORE41" .

rcap:cf053b7b727 a owl:Class ;
    rdfs:label "Increase in AST or ALT to 5 x ULN or bilirubin 3 x ULN" ;
    rdfs:subClassOf rcap:EndpointSpecification ;
    rcap:occursIn "END_DSA" .

rcap:cf0778908bc a owl:Class ;
    rdfs:label "Administration of such a preparation is considered a protocol deviation." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "IG_DSA" .

rcap:cf124de0190 a owl:Class ;
    rdfs:label "More than 48 hours has elapsed since commencement of sustained organ failure support in an ICU" ;
    rdfs:subClassOf obo:OBI_0500028 ;
    rcap:occursIn "IG_DSA" .

rcap:cf159a28650 a owl:Class ;
    rdfs:label "Macrolide therapy will be commenced following reveal of allocation to a macrolide-containing intervention in an Antibiotic Domain of this Platform." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "MD_DSA" .

rcap:cf16d68999a a owl:Class ;
    rdfs:label "This Appendix defines the following disease entity states at the time of randomization:" ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "PANDA" .

rcap:cf22bf3aed7 a owl:Class ;
    rdfs:label "Piperacillin-tazobactam ≥4.5 grams administered IV every 8 hours" ;
    rdfs:subClassOf rcap:InterventionSpecification ;
    rcap:occursIn "AB_DSA" .

rcap:cf2692d44e7 a owl:Class ;
    rdfs:label "In children 2 years to <9 years of age, baricitinib will be given at a dose of 1 mg daily if the eGFR is at least 30 and less than 60 mL/min/1.73m 2 ." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "IIM_DSA" .

rcap:cf3451859c0 a owl:Class ;
    rdfs:label "Administration of anticoagulation or antiplatelet therapy" ;
    rdfs:subClassOf rcap:DataCollectionSpecification ;
    rcap:occursIn "END_DSA" .

rcap:cf380408d29 a owl:Class ;
    rdfs:label "In children weighing less than 30 kg, the tocilizumab dose will be 12mg/kg." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "IIM_DSA" .

rcap:cf38c43f5dc a owl:Class ;
    rdfs:label "unlikely to require or receive a significant escalation in level of organ failure support for the remainder of their hospital admission" ;
    rdfs:subClassOf rcap:CategorySpecification ;
    rcap:occursIn "PANDA" .

rcap:cf3df6f4af5 a owl:Class ;
    rdfs:label "Nesting high titer plasma with low titer plasma in the Immune Suppressed strata effectively borrows information from the previous immune suppressed patients randomized to convalescent plasma." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "IG_DSA" .

rcap:cf40128f15b a owl:Class ;
    rdfs:label "If in the Severe State, more than 48 hours has elapsed since commencement of sustained organ failure support" ;
    rdfs:subClassOf obo:OBI_0500028 ;
    rcap:occursIn "IAV_DSA" .

rcap:cf408836934 a owl:Class ;
    rdfs:label "The trajectory of patients will be modelled through a Markov longitudinal proportional odds model, using daily ordinal scale categories." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:coreStatus "only_40" ;
    rcap:occursIn "CORE40" .

rcap:cf49162b05e a owl:Class ;
    rdfs:label "Hospital-acquired respiratory tract infection, except where the patient has confirmed influenza infection" ;
    rdfs:subClassOf obo:OBI_0500028 ;
    rcap:occursIn "CS_DSA" .

rcap:cf4fb663d1f a owl:Class ;
    rdfs:label "Known hypersensitivity to carbapenems will result in exclusion from receiving interventions that include meropenem" ;
    rdfs:subClassOf obo:OBI_0500028 ;
    rcap:occursIn "TAB_DSA" .

rcap:cf5572160df a owl:Class ;
    rdfs:label "Dose adjustment for renal dysfunction will be per local guidelines." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "IAV_DSA" .

rcap:cf6051db800 a owl:Class ;
    rdfs:label "In such cases, patients will be randomly allocated a remaining intervention from among those available at that site." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "AB_DSA;CS_DSA;END_DSA;IAV_DSA;IIM_DSA" .

rcap:cf670d47a1a a owl:Class ;
    rdfs:label "Removal of the domain from the Platform" ;
    rdfs:subClassOf rcap:AllocationSpecification ;
    rcap:coreStatus "same" ;
    rcap:occursIn "CORE40;CORE41" .

rcap:cf674dd11cd a owl:Class ;
    rdfs:label "Mortality at 90-days is the worst possible outcome regardless of duration of organ support or hospital stay, and outcomes for survivors are ordered by length of organ failure support and hospital stay." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:coreStatus "only_41" ;
    rcap:occursIn "CORE41" .

rcap:cf6882128d8 a owl:Class ;
    rdfs:label "If, after cessation of hydrocortisone, there is redevelopment of septic shock due to CAP (as defined above), then hydrocortisone IV 50 mg every 6 hours is to be recommenced until resolution." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "CS_DSA" .

rcap:cf75a7deb88 a owl:Class ;
    rdfs:label "Administration of a combination of PEEP and FiO 2 that is not specified by the table is a protocol deviation unless the plateau pressure is 30 cm of H 2 O or more." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "MV_DSA" .

rcap:cf76cd04abc a owl:Class ;
    rdfs:label "The threshold probability for statistical triggers for superiority, effectiveness, and inferiority are those specified in the relevant Core Protocol documents." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "IIM_DSA" .

rcap:cf7a01ea34e a owl:Class ;
    rdfs:label "The duration of empiric antibiotics will be determined by the treating clinician based on daily reviews of the following criteria:" ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "AB_DSA;TAB_DSA" .

rcap:cf8d30209fa a owl:Class ;
    rdfs:label "The choice of macrolide will depend on the availability and acceptability of the agents at each site in the following order of preference;" ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "AB_DSA;TAB_DSA" .

rcap:cf96154a40f a owl:Class ;
    rdfs:label "Vancomycin, linezolid or other antimicrobials active against MRSA may be added if MRSA is suspected at the discretion of the treating clinician, irrespective of the intervention to which the participant is allocated." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "AB_DSA;TAB_DSA" .

rcap:cf9f13d39df a owl:Class ;
    rdfs:label "*High-flow oxygen defined as a fractional inspired oxygen concentration of 0.4 or higher and with flow rate of at least 30 liters per minute (or at least 2 liters per minute per kilogram of bodyweight in children less than 15 kilograms)." ;
    rdfs:subClassOf rcap:r87900e2424 ;
    rcap:coreStatus "revised" ;
    rcap:inVersion "4.0" ;
    rcap:occursIn "CORE40" ;
    rcap:revisionOf rcap:r87900e2424 .

rcap:cfaa5fbfd6e a owl:Class ;
    rdfs:label "Administration of a systemic corticosteroid, including hydrocortisone or dexamethasone, after completion of the 10-day course is permitted only for the treatment of new illnesses that develop in the course of a patient’s hospital stay, such as asthma, airway swelling or treatment of an allergic reaction." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "CS_DSA" .

rcap:cfad5121cfc a owl:Class ;
    rdfs:label "Known or suspected pregnancy will result in exclusion from moxifloxacin or levofloxacin interventions. It is normal clinical practice that women admitted who are in an age group in which pregnancy is possible will have a pregnancy test conducted. The results of such tests will be used to determine interpretation of this exclusion criteria." ;
    rdfs:subClassOf obo:OBI_0500028 ;
    rcap:occursIn "AB_DSA" .

rcap:cfb4eb163d9 a owl:Class ;
    rdfs:label "For baloxavir containing interventions, a third dose can be administered on day 7, if, in the opinion of the treating clinician, there has been insufficient clinical improvement." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "IAV_DSA" .

rcap:cfb6fc009ea a owl:Class ;
    rdfs:label "Known hypersensitivity to any corticosteroid" ;
    rdfs:subClassOf obo:OBI_0500028 ;
    rcap:occursIn "CS_DSA" .

rcap:cfbd5d9fa18 a owl:Class ;
    rdfs:label "Data on the identification of Aspergillus species from respiratory tract specimens is collected at a platform level." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "IIM_DSA" .

rcap:cfbfe88c56e a owl:Class ;
    rdfs:label "The Recovering State, defined as hospitalized patients who are:" ;
    rdfs:subClassOf rcap:CategorySpecification ;
    rcap:occursIn "PANDA" .

rcap:cfc5e4fa95a a owl:Class ;
    rdfs:label "Macrolide therapy should be discontinued if there is development of an SAE which, in the opinion of the treating clinician, could be related to participation in this domain." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "MD_DSA" .

rcap:cfc67fd1c19 a owl:Class ;
    rdfs:label "The domain-specific secondary outcome measures (occurring during the index hospitalization, censored at 90 days after enrollment) will be:" ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "AB_DSA;CS_DSA;IG_DSA;MD_DSA;MV_DSA;TAB_DSA" .

rcap:cfccd458a0a a owl:Class ;
    rdfs:label "After completion of the infusion of active study drug, at least 20 mls of 0.9% saline should be used to flush the drug through the giving set." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "IIM_DSA" .

rcap:cfead389651 a owl:Class ;
    rdfs:label "Source of hospital admission" ;
    rdfs:subClassOf rcap:DataCollectionSpecification ;
    rcap:coreStatus "same" ;
    rcap:occursIn "CORE40;CORE41" .

rcap:cfef18ad5c3 a owl:Class ;
    rdfs:label "This will be applied in a one-sided analysis for futility for active interventions specified in this domain." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "END_DSA" .

rcap:cff12d8c7ff a owl:Class ;
    rdfs:label "Receiving strong CYP3A4 inhibitors (e.g. ketoconazole, itraconazole, erythromycin) or inducers (e.g. rifampicin, phenobarbital, carbamazepine, phenytoin) will exclude a patient receiving enteral imatinib" ;
    rdfs:subClassOf obo:OBI_0500028 ;
    rcap:occursIn "END_DSA" .

