rcap:c3a6cd10440 a owl:Class ;
    rdfs:label "Baloxavir will be administered as follows: Agent Weight < 40 kg Weight 40-80 kg Weight > 80 kg 2 mg/kg on days 1 and Baloxavir 40 mg on days 1 and 4 80 mg on days 1 and 4 4 to max of 40 mg No dose adjustment is necessary for renal impairment, hepatic impairment, or extracorporeal membrane oxygenation." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "IAV_DSA" .

rcap:c3a886e5212 a owl:Class ;
