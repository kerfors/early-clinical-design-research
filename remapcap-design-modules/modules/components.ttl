rcap:c85858c8378 a owl:Class ;
    rdfs:label "Refer to relevant Core Protocol documents for criteria for discontinuation of participation in this trial." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "AB_DSA;CS_DSA;END_DSA;IAV_DSA;IG_DSA;IIM_DSA;MD_DSA;MV_DSA;TAB_DSA" .

rcap:c876d85ebab a owl:Class ;
    rdfs:label "This hierarchical ordinal scale is a composite of:" ;
    rdfs:subClassOf rcap:DesignStatement ;
