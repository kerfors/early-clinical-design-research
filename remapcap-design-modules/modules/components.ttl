    rcap:occursIn "IAV_DSA" .

rcap:c83bd011155 a owl:Class ;
    rdfs:label "Each participating site has the option to opt-in to one or more of the remaining interventions depending on local clinical preference, usual practice, acceptable practice, and the availability of the agent at that site." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "IAV_DSA" .

rcap:c83be773831 a owl:Class ;
    rdfs:label "Amoxicillin-clavulanate ≥1200mg administered IV every 8 hours" ;
    rdfs:subClassOf rcap:InterventionSpecification ;
    rcap:occursIn "AB_DSA" .

rcap:c83c14adf1c a owl:Class ;
    rdfs:label "Any and all ventilatory parameters, including mode of ventilation, can be adjusted at any time." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "MV_DSA" .

rcap:c83d2f160ad a owl:Class ;
    rdfs:label "It is possible that a superior or efficacious intervention will be retained but subjected to further evaluation to refine the optimal characteristics (for example duration of therapy or optimal dose)." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:coreStatus "same" ;
