    rcap:coreStatus "same" ;
    rcap:occursIn "CORE40;CORE41" .

rcap:c597271389c a owl:Class ;
    rdfs:label "Ceftazidime 2 grams administered intravenously (IV) every 8 hours" ;
    rdfs:subClassOf rcap:InterventionSpecification ;
    rcap:occursIn "TAB_DSA" .

rcap:c599074e5e9 a owl:Class ;
    rdfs:label "At any time, if the tidal volume is less than that specified following calculation from the patient’s height and the plateau pressure is 29 cm or less, the tidal volume should be increased in 5% increments to achieve a tidal volume as close to, but not exceeding, the specified target tidal volume while maintain plateau pressure of not more than 30 cm H 2 O." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "MV_DSA" .

rcap:c59ffd75f17 a owl:Class ;
    rdfs:label "The default threshold probability of a statistical trigger for futility is as specified in the core protocol." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "IAV_DSA" .

rcap:c5a9afc4a18 a owl:Class ;
    rdfs:label "Patient has already received one or more doses of baloxavir" ;
    rdfs:subClassOf obo:OBI_0500028 ;
    rcap:occursIn "IAV_DSA" .

rcap:c5ab9f3456c a owl:Class ;
    rdfs:label "HRQoL measured by EQ-5D or EQ-5D-Y and PedsQL-SF15 in participants aged less than 18 years at 180 days" ;
    rdfs:subClassOf rcap:DataCollectionSpecification ;
