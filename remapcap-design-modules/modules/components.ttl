    owl:imports <https://kerfors.github.io/early-clinical-design-research/remapcap-design-modules/modules/rcap-core> .

rcap:r52076d4ff9 a owl:Class ;
    rdfs:label "Core 7.8.7 (version-independent): For RAR, allocation proportions will be capped at 75% for two-intervention domains, unless otherwise specified in a DSA." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:note "I-revision parent: Core 4.0 and 4.1 texts differ; the version-independent component is what an unversioned reference can point at." .

rcap:r87900e2424 a owl:Class ;
    rdfs:label "Core 7.6.1 (version-independent): *High-flow oxygen is defined as a fractional inspired oxygen concentration of 0.4 or higher and with flow rate of at least 30 liters per minute (or at least 2 liters per minute per kilogram of bodyweight in children less than 15 kilograms)." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:note "I-revision parent: Core 4.0 and 4.1 texts differ; the version-independent component is what an unversioned reference can point at." .

rcap:rcdb4b81960 a owl:Class ;
    rdfs:label "Core 8.8.2 (version-independent): Collected while participants are admitted to hospital between randomization and Day 28: For participants admitted to ICU at the time of enrollment, or after enrollment: Unless specified otherwise in an RSA or DSA:" ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:note "I-revision parent: Core 4.0 and 4.1 texts differ; the version-independent component is what an unversioned reference can point at." .

