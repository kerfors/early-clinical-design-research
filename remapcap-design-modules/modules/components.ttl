rcap:c6333bb2823 a owl:Class ;
    rdfs:label "clearly recovering from their acute respiratory tract infection AND" ;
    rdfs:subClassOf rcap:CategorySpecification ;
    rcap:occursIn "PANDA" .

rcap:c634411012a a owl:Class ;
    rdfs:label "Administration of a tidal volume of more than 6.0 ml/kg PBW or a plateau pressure of 30 cm H20 or more is a protocol deviation unless the pH is less than 7.15." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "MV_DSA" .

rcap:c6379004c57 a owl:Class ;
    rdfs:label "High titer convalescent plasma" ;
    rdfs:subClassOf rcap:InterventionSpecification ;
    rcap:occursIn "IG_DSA" .

rcap:c63908c2226 a owl:Class ;
    rdfs:label "Qualifying immunosuppressive diseases and treatments are defined in an operational document." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "PANDA" .

rcap:c63e7da15e3 a owl:Class ;
    rdfs:label "Enteral imatinib" ;
    rdfs:subClassOf rcap:InterventionSpecification ;
    rcap:occursIn "END_DSA" .

rcap:c6434a3b7ee a owl:Class ;
    rdfs:label "Baricitinib will be commenced as soon as possible following reveal of allocation and will be administered for 10 days or until hospital discharge, whichever occurs first." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "IIM_DSA" .

rcap:c64d13396b5 a owl:Class ;
    rdfs:label "In children aged >2 years and <9 years, a baseline eGFR <30 mL/min/1.73m 2 and/or receipt of renal replacement therapy (including long-term renal replacement therapy) at baseline will result in exclusion from receiving baricitinib" ;
    rdfs:subClassOf obo:OBI_0500028 ;
    rcap:occursIn "IIM_DSA" .

rcap:c64daa4653d a owl:Class ;
    rdfs:label "The dose of all macrolides is the same for IV and enteral administration and no dose adjustment is required for alterations in renal function including if the patient is receiving renal replacement therapy." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "MD_DSA" .

rcap:c64ec076e74 a owl:Class ;
    rdfs:label "The choice of enteral or IV administration is at the discretion of the treating clinician based on the patient’s ability to take enteral medication and illness severity including likely gastric absorption rates." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "CS_DSA" .

rcap:c65709c1927 a owl:Class ;
    rdfs:label "The statistical model will not permit borrowing between Severity States but will borrow between Age Strata, as specified in the Core Protocol." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "IAV_DSA" .

rcap:c6591df809e a owl:Class ;
    rdfs:label "Isolation or detection of MROs" ;
    rdfs:subClassOf rcap:DataCollectionSpecification ;
    rcap:occursIn "AB_DSA;TAB_DSA" .

rcap:c66579d1944 a owl:Class ;
    rdfs:label "Acute respiratory tract infection" ;
    rdfs:subClassOf obo:OBI_0500027 ;
    rcap:coreStatus "same" ;
    rcap:occursIn "CORE40;CORE41" .

rcap:c66f12cc92f a owl:Class ;
    rdfs:label "Severe renal impairment (eGFR <30 mL/min/1.73m 2 ) and/or receipt of renal replacement therapy (including long-term renal replacement therapy) at baseline will result in exclusion from receiving imatinib" ;
    rdfs:subClassOf obo:OBI_0500028 ;
    rcap:occursIn "END_DSA" .

rcap:c6959a0587f a owl:Class ;
    rdfs:label "Known viral hepatitis B or hepatitis C will exclude a patient from receiving imatinib" ;
    rdfs:subClassOf obo:OBI_0500028 ;
    rcap:occursIn "END_DSA" .

rcap:c6a2bdef4ca a owl:Class ;
    rdfs:label "Respiratory tract infection can be acquired in the community or in hospital." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "PANDA" .

rcap:c6a51302e4c a owl:Class ;
    rdfs:label "No dosage adjustment is suggested for Body Mass Index (BMI), pregnancy, or for extracorporeal membrane oxygenation." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "IAV_DSA" .

rcap:c6a712fb80d a owl:Class ;
    rdfs:label "SARS-CoV-2 antibody status at baseline" ;
    rdfs:subClassOf rcap:DataCollectionSpecification ;
    rcap:occursIn "IG_DSA" .

rcap:c6a8feb5659 a owl:Class ;
    rdfs:label "Reveal of allocation status can occur at any time before the end of Study Day 5 after randomization to a macrolide-containing intervention within an Antibiotic Domain of this Platform, as soon as sufficient information is available to confirm eligibility." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "MD_DSA" .

rcap:c6bea1689f9 a owl:Class ;
    rdfs:label "Dosage guidance of vasopressor for initiation of corticosteroids for this intervention is described in a separate operational document." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "CS_DSA" .

rcap:c6c3b3de8ef a owl:Class ;
    rdfs:label "The following doses (Table 2) are provided as guidance and may be modified according to local guidelines or practice." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "MD_DSA" .

rcap:c6c97a30d25 a owl:Class ;
    rdfs:label "For RAR, allocation proportions will be capped at 75% for two-intervention domains, unless otherwise specified in a DSA." ;
    rdfs:subClassOf rcap:r52076d4ff9 ;
    rcap:coreStatus "revised" ;
    rcap:inVersion "4.1" ;
    rcap:occursIn "CORE41" ;
    rcap:revisionOf rcap:r52076d4ff9 .

rcap:c6c9dcda960 a owl:Class ;
    rdfs:label "Bacteria known to cause respiratory tract infection" ;
    rdfs:subClassOf rcap:CategorySpecification ;
    rcap:occursIn "PANDA" .

rcap:c6cb92153ee a owl:Class ;
    rdfs:label "Progression to IMV/ECLS/death" ;
    rdfs:subClassOf rcap:EndpointSpecification ;
    rcap:coreStatus "only_40" ;
    rcap:occursIn "CORE40" .

rcap:c6d1c3df7f2 a owl:Class ;
    rdfs:label "Patient is aged ≥2 years" ;
    rdfs:subClassOf obo:OBI_0500027 ;
    rcap:occursIn "IIM_DSA" .

rcap:c6d2d9b72d9 a owl:Class ;
    rdfs:label "Some domain-specific secondary endpoints may be specified as Key Domain-Specific Endpoints and will be interpreted in conjunction with the primary endpoint in determining the overall effectiveness of interventions." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:coreStatus "same" ;
    rcap:occursIn "CORE40;CORE41" .

rcap:c6da44bf065 a owl:Class ;
    rdfs:label "Respiratory virus infection (influenza, SARS-CoV-2, MERS-CoV, RSV and any other recognized viral respiratory pathogen grouped together) is stratified as viral infection confirmed (a recognized viral respiratory pathogen is detected on microbiological testing with a clinically compatible illness) and respiratory viral infection not confirmed." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "PANDA" .

rcap:c6e0ef15ff9 a owl:Class ;
    rdfs:label "Known non-serious hypersensitivity to penicillins will result in exclusion from receiving interventions that include piperacillin and amoxicillin" ;
    rdfs:subClassOf obo:OBI_0500028 ;
    rcap:occursIn "AB_DSA" .

rcap:c6e16e97770 a owl:Class ;
    rdfs:label "Patient is aged ≥ 16 years old" ;
    rdfs:subClassOf obo:OBI_0500027 ;
    rcap:occursIn "IG_DSA" .

rcap:c6e4a622d7b a owl:Class ;
    rdfs:label "Nesting is not applicable to this domain." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "CS_DSA;IIM_DSA;MD_DSA;MV_DSA" .

rcap:c6f0eda0eb3 a owl:Class ;
    rdfs:label "Previous versions of this DSA incorporated a 10-day duration of oseltamivir intervention, which has been removed from this version." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "IAV_DSA" .

rcap:c6fb7a69975 a owl:Class ;
    rdfs:label "No immunoglobulin against COVID-19 (no placebo)" ;
    rdfs:subClassOf rcap:InterventionSpecification ;
    rcap:occursIn "IG_DSA" .

rcap:c701544ad16 a owl:Class ;
    rdfs:label "Hospitalized on extracorporeal life support (ECLS) or invasive mechanical ventilation (IMV)" ;
    rdfs:subClassOf rcap:EndpointSpecification ;
    rcap:coreStatus "only_40" ;
    rcap:occursIn "CORE40" .

rcap:c70b281ddd1 a owl:Class ;
    rdfs:label "Patients may also be excluded from receiving one or both interventions within the domain for patient-specific reasons." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "TAB_DSA" .

rcap:c70c1cc212f a owl:Class ;
    rdfs:label "Administration of a systemic corticosteroid, including hydrocortisone or dexamethasone, is permitted only for the treatment of new illnesses that develop in the course of a patient’s hospital stay, such as asthma, airway swelling or treatment of an allergic reaction." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "CS_DSA" .

rcap:c70fcba7483 a owl:Class ;
    rdfs:label "The primary endpoint for this domain is as specified in Core Protocol documents." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "CS_DSA;IG_DSA;MV_DSA" .

rcap:c711c3155bb a owl:Class ;
    rdfs:label "Days alive and out of hospital to day 28" ;
    rdfs:subClassOf rcap:EndpointSpecification ;
    rcap:coreStatus "only_41" ;
    rcap:occursIn "CORE41" .

rcap:c712552cb85 a owl:Class ;
    rdfs:label "In this regard, consideration should be given to the development of ventricular dysrhythmias and evaluation of the QT interval during the intervention period and prior to discontinuation of continuous ECG monitoring." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "MD_DSA" .

rcap:c715f02f8d2 a owl:Class ;
    rdfs:label "If two interventions within this domain, for a unit-of-analysis, have at least a 0.90 probability of being within a pre-specified delta for the primary endpoint then these interventions will be deemed as being equivalent." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "AB_DSA;CS_DSA;IAV_DSA;IIM_DSA;TAB_DSA" .

rcap:c7194d0f95a a owl:Class ;
    rdfs:label "Previous enrollment in this Platform within the last 90 days" ;
    rdfs:subClassOf obo:OBI_0500028 ;
    rcap:coreStatus "same" ;
    rcap:occursIn "CORE40;CORE41" .

rcap:c71fe32f4bd a owl:Class ;
    rdfs:label "For RAR, allocation proportions will be capped at 60% for two-intervention domains, unless otherwise specified in a DSA." ;
    rdfs:subClassOf rcap:r52076d4ff9 ;
    rcap:coreStatus "revised" ;
    rcap:inVersion "4.0" ;
    rcap:occursIn "CORE40" ;
    rcap:revisionOf rcap:r52076d4ff9 .

rcap:c724a498c9a a owl:Class ;
    rdfs:label "ǂ Melioidosis: Sites in areas where melioidosis is endemic (including Northern Australia and South-East Asia) where antibiotic treatment protocols specify antibiotics active against Burkholderia pseudomallei (e.g., ceftazidime or meropenem) will not participate in this domain." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "AB_DSA" .

rcap:c73967ff128 a owl:Class ;
    rdfs:label "The discontinuation of a domain, or interventions within a domain, in response to reaching a Statistical Trigger will not require a protocol amendment." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:coreStatus "same" ;
    rcap:occursIn "CORE40;CORE41" .

rcap:c74d77f164d a owl:Class ;
    rdfs:label "Administration of rescue therapies" ;
    rdfs:subClassOf obo:IAO_0000033 ;
    rcap:occursIn "MV_DSA" .

rcap:c7573c19064 a owl:Class ;
    rdfs:label "SAE as defined in the core protocol documents and qualified in this DSA" ;
    rdfs:subClassOf rcap:EndpointSpecification ;
    rcap:occursIn "MV_DSA" .

rcap:c7584fb6acd a owl:Class ;
    rdfs:label "Participating sites may choose to offer this domain to patients in one or both of these Illness Severity States." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "CS_DSA;IAV_DSA;IG_DSA" .

rcap:c759e6b1e5d a owl:Class ;
    rdfs:label "Where compression converts a domain with three or more interventions into a domain with two interventions (and data continues to support equivalence of the compressed interventions) such a domain will be regarded as a two-intervention domain for the purposes of RAR and for evaluation of Statistical Triggers for superiority, inferiority, and equivalence." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:coreStatus "same" ;
    rcap:occursIn "CORE40;CORE41" .

rcap:c761a97ac05 a owl:Class ;
    rdfs:label "The respiratory rate is set by the treating clinician with the goal of achieving the targeted PaCO 2 and adjusted, as required, to achieve the PaCO 2 target." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "MV_DSA" .

rcap:c762828ec4b a owl:Class ;
    rdfs:label "In the presence of severe acidosis, bicarbonate may be administered, at the discretion of the treating clinician." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "MV_DSA" .

rcap:c766b35362d a owl:Class ;
    rdfs:label "Discharged from index hospitalization Respiratory Infection Ordinal Weighted Score" ;
    rdfs:subClassOf rcap:EndpointSpecification ;
    rcap:coreStatus "only_41" ;
    rcap:occursIn "CORE41" .

rcap:c766b87cc4e a owl:Class ;
    rdfs:label "Baricitinib will be given at a dose of 1 mg daily if the eGFR is at least 15 and less than 30 mL/min/1.73m 2 ." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "IIM_DSA" .

rcap:c7772292f5f a owl:Class ;
    rdfs:label "As co-infection is a common finding in the respiratory tract, Domains can constrain eligibility and define analysis populations to include or exclude patients with an assigned pathogen status in one or more of these categories." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "PANDA" .

rcap:c77ba2be096 a owl:Class ;
    rdfs:label "All use of systemic corticosteroids is recorded and the reason for any administration will be documented." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "CS_DSA" .

rcap:c77c332e823 a owl:Class ;
    rdfs:label "This Appendix defines pathogen analysis strata that contribute to the unit-of-analysis for the following pathogens: Influenza virus infection is stratified as influenza confirmed (influenza virus detected on microbiological testing with a compatible clinical assessment) and influenza not confirmed." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "PANDA" .

rcap:c790b78b24e a owl:Class ;
    rdfs:label "Survival status at 28 days" ;
    rdfs:subClassOf rcap:DataCollectionSpecification ;
    rcap:coreStatus "same" ;
    rcap:occursIn "CORE40;CORE41" .

rcap:c796cb21447 a owl:Class ;
    rdfs:label "Following any Platform Conclusion in this domain, a sensitivity analysis will be conducted that is restricted to patients randomized concurrently to P1 and P4 interventions." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "IG_DSA" .

rcap:c7a19fee7fd a owl:Class ;
    rdfs:label "Survival status at hospital discharge" ;
    rdfs:subClassOf rcap:DataCollectionSpecification ;
    rcap:coreStatus "same" ;
    rcap:occursIn "CORE40;CORE41" .

rcap:c7a203272b8 a owl:Class ;
    rdfs:label "The same odds ratio delta as specified in the relevant Core Protocol documents for equivalence will be used for futility." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "END_DSA" .

rcap:c7a4a3d204c a owl:Class ;
    rdfs:label "The timing of the revealing of allocation status and administration of interventions is specified to be Randomization with Immediate Reveal and Initiation, or with Delayed Reveal and Initiation, for situations where randomization occurs before influenza test results are available, with reveal of allocation occurring at time of confirmed positive result." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "IAV_DSA" .

rcap:c7b4a0d3026 a owl:Class ;
    rdfs:label "The maximum rate is 35 breaths per minute." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "MV_DSA" .

rcap:c7b592a7e46 a owl:Class ;
    rdfs:label "There is sufficient microbiological information to guide specific antibacterial therapy" ;
    rdfs:subClassOf obo:OBI_0500028 ;
    rcap:occursIn "AB_DSA;TAB_DSA" .

rcap:c7bbb84cd18 a owl:Class ;
    rdfs:label "If the treating clinician suspects MRSA pneumonia, these patients should be included (see Section 8.3.5)." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "AB_DSA;TAB_DSA" .

rcap:c7bc833fbed a owl:Class ;
    rdfs:label "Known previous history of transfusion-related acute lung injury will exclude a patient from receiving high titer plasma" ;
    rdfs:subClassOf obo:OBI_0500028 ;
    rcap:occursIn "IG_DSA" .

rcap:c7c5d9e9c31 a owl:Class ;
    rdfs:label "The timing of the revealing of allocation status and administration of interventions is specified to be Randomization with Immediate Reveal and Initiation or Randomization with Deferred Reveal and Initiation (see relevant Core Protocol documents)." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "END_DSA" .

rcap:c7c759a1608 a owl:Class ;
    rdfs:label "The doses specified below are recommended minimum doses and may be modified according to local guidelines or practice." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "AB_DSA;TAB_DSA" .

rcap:c7ca5b8485d a owl:Class ;
    rdfs:label "C. difficile detection from feces" ;
    rdfs:subClassOf rcap:DataCollectionSpecification ;
    rcap:occursIn "TAB_DSA" .

rcap:c7cb95286f2 a owl:Class ;
    rdfs:label "The Respiratory Infection Ordinal Weighted Score will use the same ordinal scale categories as in the Survival and Recovery Trajectory described above but will be transformed to a numeric value between 0 (best) and 1 (worst) that reflects the severity of a patient’s illness and recovery trajectory over 28 days." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:coreStatus "only_41" ;
    rcap:occursIn "CORE41" .

rcap:c7d9db91aab a owl:Class ;
    rdfs:label "If, at any time after reveal of allocation, there is confirmed diagnosis (or a strong clinical suspicion) of legionellosis or other microbiological diagnosis of an ‘atypical’ organism, then effective treatment for ‘atypical’ organisms must be provided." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "MD_DSA" .

rcap:c7e00deda39 a owl:Class ;
    rdfs:label "However, declaration of a Platform Conclusion will always result in the removal of inferior or harmful interventions from a domain." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:coreStatus "same" ;
    rcap:occursIn "CORE40;CORE41" .

rcap:c7e5aa8a12c a owl:Class ;
    rdfs:label "Any patient randomized to standard course macrolide, in whom legionellosis or another ‘atypical’ organism is diagnosed after cessation of macrolide, must commence treatment that is effective against the organisms such as a macrolide or fluoroquinolone." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "MD_DSA" .

rcap:c7e605d5258 a owl:Class ;
    rdfs:label "Hospital length-of-stay" ;
    rdfs:subClassOf rcap:EndpointSpecification ;
    rcap:coreStatus "only_40" ;
    rcap:occursIn "CORE40" .

rcap:c7f0201166f a owl:Class ;
    rdfs:label "Known non-serious hypersensitivity to cephalosporins will result in exclusion from receiving interventions that include ceftriaxone" ;
    rdfs:subClassOf obo:OBI_0500028 ;
    rcap:occursIn "AB_DSA" .

rcap:c7fd21cde5f a owl:Class ;
