@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rcap: <https://kerfors.github.io/early-clinical-design-research/remapcap-design-modules/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

rcap:c0096438fef a owl:Class ;
    rdfs:label "Patients who are eligible for only a single intervention at a site (i.e." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "AB_DSA;END_DSA;IG_DSA;IIM_DSA" .

rcap:c0103ae2e32 a owl:Class ;
    rdfs:label "With respect to reporting of Platform Conclusions and adaptations of the domain the following actions are possible: Factors that should be taken into account by the DSMB and the ITSC include the results of the primary analysis, analysis of clinically relevant secondary end-points, the possibility of treatment-by-treatment interactions, the relative burden and cost of the two interventions, the clinical interpretation of the adequacy of the delta, the possibility that ongoing randomization with a smaller delta might also allow a Statistical Trigger for superiority (with a small effect size) and the ordinal position of the equivalent pair within the domain." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:coreStatus "same" ;
    rcap:occursIn "CORE40;CORE41" .

rcap:c017de64a90 a owl:Class ;
    rdfs:label "In particular longer courses of corticosteroids should be avoided in very young infants." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "CS_DSA" .

rcap:c024c5c7541 a owl:Class ;
    rdfs:label "In keeping with all international guidelines optimized empiric antibiotic treatment should commence as soon as possible." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "AB_DSA;TAB_DSA" .

rcap:c025838a38f a owl:Class ;
    rdfs:label "Survival and Recovery Trajectory Survival and Recovery Trajectory is a composite of all-cause mortality at day 90 and, among survivors, a daily ordinal scale of illness and recovery to 28 days." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:coreStatus "only_41" ;
    rcap:occursIn "CORE41" .

rcap:c02716df73b a owl:Class ;
    rdfs:label "A baseline platelet count <50 x10 9 /L will exclude a patient from receiving enteral imatinib" ;
    rdfs:subClassOf obo:OBI_0500028 ;
    rcap:occursIn "END_DSA" .

rcap:c027ab13bf7 a owl:Class ;
    rdfs:label "Serious clinically diagnosed arterial (e.g. myocardial infarction (MI), cerebrovascular accident (CVA), mesenteric arterial thrombosis) or venous thrombotic events (e.g. deep vein thrombosis (DVT), pulmonary embolism (PE), portal or mesenteric venous thrombosis, or cortical venous sinus thrombosis) occurring during the index hospitalization censored at day 90 after enrolment." ;
    rdfs:subClassOf rcap:DataCollectionSpecification ;
    rcap:occursIn "IG_DSA" .

rcap:c02c1e22ba9 a owl:Class ;
    rdfs:label "In this Platform, pathogen status may be assigned based on clinical assessment, microbiological testing, or both." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "PANDA" .

rcap:c02c7c3c4db a owl:Class ;
    rdfs:label "If a patient develops a severe adverse reaction, imatinib should be discontinued and not restarted" ;
    rdfs:subClassOf rcap:InterventionSpecification ;
    rcap:occursIn "END_DSA" .

rcap:c0322fd9949 a owl:Class ;
    rdfs:label "If no local guidelines exist, it is recommended that subsequent doses of antibiotics will be adjusted for estimated renal function (based on estimated Glomerular Filtration Rate (eGFR)) as follows:" ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "AB_DSA" .

rcap:c03a44f4e7e a owl:Class ;
    rdfs:label "Known hypersensitivity to an agent specified as an intervention in this domain will exclude a patient from receiving that agent." ;
    rdfs:subClassOf obo:OBI_0500028 ;
    rcap:occursIn "END_DSA;IAV_DSA;IG_DSA;IIM_DSA" .

rcap:c0431228721 a owl:Class ;
    rdfs:label "Moxifloxacin 400mg administered IV once daily, or Levofloxacin 750mg IV q24h" ;
    rdfs:subClassOf rcap:InterventionSpecification ;
    rcap:occursIn "AB_DSA" .

rcap:c048bddcbd7 a owl:Class ;
    rdfs:label "The statistical model will permit borrowing between all strata as specified in Core Protocol documents." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "CS_DSA" .

rcap:c04aca4d5c7 a owl:Class ;
    rdfs:label "If the patient is allocated to extended course macrolide, macrolide therapy should be prescribed to Study Day 14, irrespective of the timing of reveal." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "MD_DSA" .

rcap:c04bf744260 a owl:Class ;
    rdfs:label "Patients assigned to this intervention are not to receive imatinib or another tyrosine kinase inhibitor targeting the same pathway as imatinib (i.e." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "END_DSA" .

rcap:c04d371375d a owl:Class ;
    rdfs:label "patients who are receiving invasive mechanical ventilation and have a ratio of arterial partial pressure of oxygen to fractional inspired concentration of oxygen (P:F ratio) of ≥ 200 mmHg (or saturation to fractional inspired concentration of oxygen ratio of ≥235) or are receiving invasive mechanical ventilation with the Positive End-Expiratory Pressure (PEEP) set to less than 5 cm of water (irrespective of the P:F ratio), and" ;
    rdfs:subClassOf rcap:CategorySpecification ;
    rcap:occursIn "PANDA" .

rcap:c05075dff40 a owl:Class ;
    rdfs:label "For all patients in this domain who remain in hospital after study day 28, data on the administration of corticosteroids are not collected, and administration of corticosteroids after study day 28 is at the discretion of the treating clinician." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "CS_DSA" .

rcap:c050828c00a a owl:Class ;
    rdfs:label "No change to the interventions within the domain with continuation of RAR. This could be to further evaluate secondary endpoints, a smaller delta, or interest in interactions with other interventions." ;
    rdfs:subClassOf rcap:AllocationSpecification ;
    rcap:coreStatus "same" ;
    rcap:occursIn "CORE40;CORE41" .

rcap:c05662763c7 a owl:Class ;
    rdfs:label "The unit-of- analysis is further subdivided by Illness Severity State (defined as the Moderate and Severe Illness Severity States) and two Age Strata (defined as Pediatric Age Stratum and a combination of Adolescent and Adult Age Strata, which will be combined for analytic purposes)." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "IAV_DSA" .

rcap:c05beb36299 a owl:Class ;
    rdfs:label "Physiologic and laboratory results indicative of severity of illness and organ dysfunction" ;
    rdfs:subClassOf rcap:DataCollectionSpecification ;
    rcap:coreStatus "same" ;
    rcap:occursIn "CORE40;CORE41" .

rcap:c05d5045c24 a owl:Class ;
    rdfs:label "Hospital readmission within 28 days" ;
    rdfs:subClassOf rcap:DataCollectionSpecification ;
    rcap:coreStatus "only_40" ;
    rcap:occursIn "CORE40" .

rcap:c06de9f2a96 a owl:Class ;
    rdfs:label "Adherence to the allocated mechanical ventilation strategy should continue as long as the patient is receiving invasive ventilation or until day 28, whichever occurs first." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "MV_DSA" .

rcap:c077742c43e a owl:Class ;
    rdfs:label "borrowing will occur between Moderate and Severe states." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "IG_DSA" .

rcap:c07829b4907 a owl:Class ;
    rdfs:label "Randomization to the non-superior or non-efficacious interventions may continue at sites at which the superior or efficacious intervention is not available, pending its availability." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:coreStatus "same" ;
    rcap:occursIn "CORE40;CORE41" .

rcap:c07ba9bbc05 a owl:Class ;
    rdfs:label "Known hypersensitivity to moxifloxacin or levofloxacin will result in exclusion from moxifloxacin or levofloxacin intervention" ;
    rdfs:subClassOf obo:OBI_0500028 ;
    rcap:occursIn "AB_DSA" .

rcap:c07c65fbdc2 a owl:Class ;
    rdfs:label "High-flow nasal oxygen with a fractional inspired oxygen concentration of 0.4 or higher and with flow rate of at least 30 liters per minute (or at least 2 liters per minute per kilogram of bodyweight in children less than 15 kilograms)" ;
    rdfs:subClassOf rcap:CategorySpecification ;
    rcap:occursIn "PANDA" .

rcap:c08c9ced8d5 a owl:Class ;
    rdfs:label "It is acknowledged that a new pandemic pathogen may be completely novel and, in this situation, the default is for a novel pathogen to be considered separate from other pathogens as above." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "PANDA" .

rcap:c08df43abd6 a owl:Class ;
    rdfs:label "In order to be eligible to participate in this trial, all patients must meet the following criteria:" ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:coreStatus "same" ;
    rcap:occursIn "CORE40;CORE41" .

rcap:c08f5b718bc a owl:Class ;
    rdfs:label "The threshold probability for statistical triggers forefficacy are those specified in the relevant Core Protocol documents." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "END_DSA" .

rcap:c08fb792710 a owl:Class ;
    rdfs:label "If a patient has been receiving any corticosteroid for their respiratory tract infection or its direct complications prior to enrollment, this medication must be ceased." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "CS_DSA" .

rcap:c0914eb731b a owl:Class ;
    rdfs:label "Oseltamivir twice daily for 5 days + baloxavir on days 1 and 4 after reveal of randomized treatment assignment" ;
    rdfs:subClassOf rcap:InterventionSpecification ;
    rcap:occursIn "IAV_DSA" .

rcap:c09cf90d5ee a owl:Class ;
    rdfs:label "Domain-specific safety outcomes, where applicable" ;
    rdfs:subClassOf rcap:EndpointSpecification ;
    rcap:coreStatus "same" ;
    rcap:occursIn "CORE40;CORE41" .

rcap:c0a1453ce8f a owl:Class ;
    rdfs:label "Therefore, the population considered to have bacterial infection is defined primarily by clinical assessment plus any microbiological data available at the time of eligibility assessment rather than final microbiological test results." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "PANDA" .

rcap:c0a14a0953a a owl:Class ;
    rdfs:label "Change to enteral antibiotics once patient is clinically stable" ;
    rdfs:subClassOf rcap:InterventionSpecification ;
    rcap:occursIn "AB_DSA;TAB_DSA" .

rcap:c0a159d07c6 a owl:Class ;
    rdfs:label "No strata are applied in the model, although this may be modified as an operational decision as specified in the Current State document." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "AB_DSA;MD_DSA;TAB_DSA" .

rcap:c0a5dc0cbed a owl:Class ;
    rdfs:label "Disability status measured by WHODAS at 180 days and baseline information to interpret disability (adults)" ;
    rdfs:subClassOf rcap:DataCollectionSpecification ;
    rcap:coreStatus "same" ;
    rcap:occursIn "CORE40;CORE41" .

rcap:c0a964350f0 a owl:Class ;
    rdfs:label "Non-invasive ventilation (bilevel positive airway pressure or continuous positive airway pressure by mask or helmet)" ;
    rdfs:subClassOf obo:IAO_0000033 ;
    rcap:coreStatus "only_41" ;
    rcap:occursIn "CORE41;PANDA" .

rcap:c0ac63ad5df a owl:Class ;
    rdfs:label "In a domain that comprises three or more interventions, but in which two or more interventions are analyzed in a nested manner, the nested group may be combined for analyses of equivalence." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:coreStatus "same" ;
    rcap:occursIn "CORE40;CORE41" .

rcap:c0b3c8b79f8 a owl:Class ;
    rdfs:label "It is possible that additional defined pathogens may be included in this appendix over time due to the changing epidemiology of respiratory tract infections or due to a changing focus of the Platform." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "PANDA" .

rcap:c0bef8728bb a owl:Class ;
    rdfs:label "There is one nest within this domain, comprising ceftriaxone + macrolide, piperacillin-tazobactam + macrolide, and amoxicillin-clavulanate + macrolide interventions." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "AB_DSA" .

rcap:c0c776b6b49 a owl:Class ;
    rdfs:label "For other pathogens, the clinical features are non-specific and microbiological tests have a high sensitivity and, in this case, microbiological testing may be more important than clinical suspicion." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "PANDA" .

rcap:c0c7c9a9c53 a owl:Class ;
    rdfs:label "An example would include patients with a history of a penicillin hypersensitivity, who may receive a cephalosporin or moxifloxacin." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "AB_DSA" .

rcap:c0cc4f0f17b a owl:Class ;
    rdfs:label "Confirmed acute myocardial infarction" ;
    rdfs:subClassOf rcap:EndpointSpecification ;
    rcap:occursIn "IG_DSA" .

rcap:c0d027dc361 a owl:Class ;
    rdfs:label "It is not an objective of this trial to re-evaluate these questions but determine the aggregate effect of treatment with corticosteroids on mortality." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "CS_DSA" .

rcap:c0d034cc9f6 a owl:Class ;
    rdfs:label "If the patient has a significant and sudden drop in saturation, it is permitted to increase the PEEP/FiO 2 rapidly from the left to the right of the chart as quickly as required to achieve an oxygen saturation that is in the target range." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "MV_DSA" .

rcap:c0da3871612 a owl:Class ;
    rdfs:label "Patients may have multiple intervention exclusions (e.g., both a penicillin and a cephalosporin hypersensitivity)." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "TAB_DSA" .

rcap:c0de6d4fcdc a owl:Class ;
    rdfs:label "The weights for each daily ordinal status will be derived from existing REMAP-CAP data and correspond to the estimated probability of 90-day mortality for that category." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:coreStatus "only_41" ;
    rcap:occursIn "CORE41" .

rcap:c0e05a5a652 a owl:Class ;
    rdfs:label "Acute Respiratory Distress Syndrome is a State defined in two categories, present or absent, with ‘present’ defined as patients with all of the following:" ;
    rdfs:subClassOf rcap:CategorySpecification ;
    rcap:occursIn "PANDA" .

rcap:c0e7d61c2a9 a owl:Class ;
    rdfs:label "There is no administration of placebo." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "CS_DSA" .

rcap:c0f39507184 a owl:Class ;
    rdfs:label "Known severe liver disease or an alanine aminotransferase (ALT) or an aspartate aminotransferase (AST) that is more than five times the upper limit of normal or bilirubin more than three times the upper limit of normal will exclude a patient from receiving enteral imatinib" ;
    rdfs:subClassOf obo:OBI_0500028 ;
    rcap:occursIn "END_DSA" .

rcap:c0f40ddaf60 a owl:Class ;
    rdfs:label "Mortality is defined as death from any cause before the end of study day 90." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:coreStatus "only_40" ;
    rcap:occursIn "CORE40" .

rcap:c0f71d346a0 a owl:Class ;
    rdfs:label "For some participants, additional microbiological test results which are indicative of infection status at baseline may become available after reveal of treatment allocation." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "PANDA" .

rcap:c0f86ea227e a owl:Class ;
    rdfs:label "Patient has already received treatment with any non-trial prescribed polyclonal antibody therapy (hyperimmune immunoglobulin, or convalescent plasma) intended to be active against COVID-19 during this acute illness." ;
    rdfs:subClassOf obo:OBI_0500028 ;
    rcap:occursIn "IG_DSA" .

rcap:c10b27d976a a owl:Class ;
    rdfs:label "Hypotension and administration of vasopressors/inotropes" ;
    rdfs:subClassOf rcap:DataCollectionSpecification ;
    rcap:coreStatus "same" ;
    rcap:occursIn "CORE40;CORE41" .

rcap:c10b99f1d7e a owl:Class ;
    rdfs:label "Sedative medications should be administered, as determined by the treating clinician, with or without administration of a neuromuscular blocker, to provide patient safety and comfort as well as to allow delivery of the specified ventilator settings." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "MV_DSA" .

rcap:c114f0571f8 a owl:Class ;
    rdfs:label "Meropenem 1 gram administered IV every 8 hours" ;
    rdfs:subClassOf rcap:InterventionSpecification ;
    rcap:occursIn "TAB_DSA" .

rcap:c1230dec75c a owl:Class ;
    rdfs:label "Intention to prescribe systemic corticosteroids for a reason that is unrelated to the current respiratory tract infection, such as chronic corticosteroid use before admission, acute severe asthma, or suspected or proven Pneumocystis jiroveci or COVID-19 pneumonia" ;
    rdfs:subClassOf obo:OBI_0500028 ;
    rcap:occursIn "CS_DSA" .

rcap:c12828954c3 a owl:Class ;
    rdfs:label "If the acidosis has a substantial metabolic component, continuous renal replacement therapy may be instituted, at the discretion of the treating clinician." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "MV_DSA" .

rcap:c1287fb9829 a owl:Class ;
    rdfs:label "A switch from IV to enteral macrolide is permitted as directed by the treating clinician." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "MD_DSA" .

rcap:c129e610700 a owl:Class ;
    rdfs:label "Response Adaptive Randomization may be applied." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "CS_DSA;END_DSA;IAV_DSA;IIM_DSA" .

rcap:c13276457d5 a owl:Class ;
    rdfs:label "The DSMB will oversee a range of actions as described in operational documents and the DSMB charter to confirm that the Statistical Trigger has been reached validly." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:coreStatus "same" ;
    rcap:occursIn "CORE40;CORE41" .

rcap:c1424395077 a owl:Class ;
    rdfs:label "Domains may pool income level categories, for example, distinguishing two categories: high-income and non-high income (incorporating upper-middle, lower-middle, and low)." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "PANDA" .

rcap:c144fb17704 a owl:Class ;
    rdfs:label "All-cause mortality at 28 days censored at hospital discharge" ;
    rdfs:subClassOf rcap:EndpointSpecification ;
    rcap:occursIn "IG_DSA" .

rcap:c1465e48eba a owl:Class ;
    rdfs:label "Cease antibiotics if an alternative diagnosis is made." ;
    rdfs:subClassOf rcap:InterventionSpecification ;
    rcap:occursIn "AB_DSA;TAB_DSA" .

rcap:c149340e649 a owl:Class ;
    rdfs:label "Organ-support free days at day 28" ;
    rdfs:subClassOf rcap:EndpointSpecification ;
    rcap:coreStatus "only_40" ;
    rcap:occursIn "CORE40" .

rcap:c151c132f43 a owl:Class ;
    rdfs:label "Borrowing is permitted between States, i.e." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "IG_DSA" .

rcap:c151c19e49b a owl:Class ;
    rdfs:label "Pregnancy outcomes will be collected for patients who are pregnant at the time of randomization to this domain." ;
    rdfs:subClassOf rcap:DataCollectionSpecification ;
    rcap:occursIn "IIM_DSA" .

rcap:c15ec59dfe1 a owl:Class ;
    rdfs:label "The ITSC will take responsibility to undertake Public Disclosure as soon as practicable with the dissemination of the research result via presentation or publication or both." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:coreStatus "same" ;
    rcap:occursIn "CORE40;CORE41" .

rcap:c15f4b96ff8 a owl:Class ;
    rdfs:label "Cease antibiotics when there is evidence of sufficient clinical improvement, no microbiological diagnosis has been made and no clinical evidence of deep infection (e.g. empyema or lung abscess). The duration of antibiotic therapy will be decided by the treating clinician and local guidelines." ;
    rdfs:subClassOf rcap:InterventionSpecification ;
    rcap:occursIn "AB_DSA;TAB_DSA" .

rcap:c164a6e965d a owl:Class ;
    rdfs:label "Pulmonary aspergillosis, during this hopsitalization and more than 48 hours following randomization, defined as culture of Aspergillus species from tracheal aspirate or bronchoalveolar lavage or invasive pulmonary aspergillosis diagnosed and treated with one or more systemic antifungal agent" ;
    rdfs:subClassOf rcap:EndpointSpecification ;
    rcap:occursIn "IIM_DSA" .

rcap:c168c834f5a a owl:Class ;
    rdfs:label "If an interaction is specified with a future domain, it is sufficient for the interaction to be specified only in the DSA of such a future domain." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "AB_DSA;CS_DSA;END_DSA;IAV_DSA;IG_DSA;IIM_DSA;MD_DSA;TAB_DSA" .

rcap:c178de9633a a owl:Class ;
    rdfs:label "Days alive and free of organ-failure support to day 28" ;
    rdfs:subClassOf rcap:EndpointSpecification ;
    rcap:coreStatus "only_41" ;
    rcap:occursIn "CORE41" .

rcap:c1837126244 a owl:Class ;
    rdfs:label "Influenza Infection Confirmed Stratum)." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "IAV_DSA" .

rcap:c1873c181b7 a owl:Class ;
    rdfs:label "Age: Age is defined in three categories, Adult (aged 18 years or older), Adolescent (aged 12 years or older and less than 18 years), or Pediatric (aged 28 days or older and less than 12 years) at the time of Platform enrollment." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "PANDA" .

rcap:c187cffc67e a owl:Class ;
    rdfs:label "A patient’s pathogen status is defined by the matrix of all relevant pathogen groups." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "PANDA" .

rcap:c194af0dab6 a owl:Class ;
    rdfs:label "The threshold probability for statistical triggers for superiority, inferiority, and futility are those specified in the Core Protocol." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "MD_DSA" .

rcap:c19e778dc9d a owl:Class ;
    rdfs:label "Organ failure support or hospital stay received prior to the end of study day 28, but outside of the index hospitalization (i.e., during a subsequent hospital admission after discharge from the index hospitalization) will not contribute to the primary endpoint." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:coreStatus "only_41" ;
    rcap:occursIn "CORE41" .

rcap:c1a0b1bcfd0 a owl:Class ;
    rdfs:label "For each pathogen, a hierarchy of infection likelihood exists consisting of ‘confirmed’, ‘suspected but not confirmed’ (divisible, for bacterial infection, into two subcategories: ‘probable’ and ‘possible’), ‘not suspected’, and ‘excluded’ (i.e." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "PANDA" .

rcap:c1a78973420 a owl:Class ;
    rdfs:label "Confirmed SARS-CoV-2 infection" ;
    rdfs:subClassOf obo:OBI_0500028 ;
    rcap:occursIn "CS_DSA" .

rcap:c1a81fa0c38 a owl:Class ;
    rdfs:label "It is expected that most children will spend less than 10days in hospital and therefore duration of therapy will be shorter." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "CS_DSA" .

rcap:c1ae29f53d7 a owl:Class ;
    rdfs:label "For the purposes of this primary endpoint, organ failure support is defined as:" ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:coreStatus "only_41" ;
    rcap:occursIn "CORE41" .

rcap:c1b0d782be7 a owl:Class ;
    rdfs:label "Patient has lower-respiratory tract infection" ;
    rdfs:subClassOf obo:OBI_0500027 ;
    rcap:occursIn "CS_DSA" .

rcap:c1b2898941a a owl:Class ;
    rdfs:label "For patients who survive to day 90, each day's ordinal status is converted to its corresponding mortality-derived weight, and the score is calculated as the mean of these daily weights over the first 28 days." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:coreStatus "only_41" ;
    rcap:occursIn "CORE41" .

rcap:c1ba4c77056 a owl:Class ;
    rdfs:label "For participants discharged from hospital before the end of the allocated course of macrolide therapy, macrolides should be discontinued at hospital discharge." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "MD_DSA" .

rcap:c1bdd74e350 a owl:Class ;
    rdfs:label "Respiratory syncytial virus (RSV)" ;
    rdfs:subClassOf rcap:CategorySpecification ;
    rcap:occursIn "PANDA" .

rcap:c1bdec95f43 a owl:Class ;
    rdfs:label "A single statistical model requires pathogen analysis strata to be defined based on information available at eligibility assessment, no later than time of reveal of treatment allocation." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "PANDA" .

rcap:c1c0f1e7b50 a owl:Class ;
    rdfs:label "microbiological testing-confirmed influenza) and the Severe Illness Severity State." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "IIM_DSA" .

rcap:c1ca983b883 a owl:Class ;
    rdfs:label "More than 14 days have elapsed since hospital admission" ;
    rdfs:subClassOf obo:OBI_0500028 ;
    rcap:occursIn "IG_DSA" .

rcap:c1cb8756c31 a owl:Class ;
    rdfs:label "Patient has already received two or more doses of oseltamivir or other neuraminidase inhibitors" ;
    rdfs:subClassOf obo:OBI_0500028 ;
    rcap:occursIn "IAV_DSA" .

rcap:c1cc6e00337 a owl:Class ;
    rdfs:label "Baloxavir on days 1 and 4 after reveal of randomized treatment assignment" ;
    rdfs:subClassOf rcap:InterventionSpecification ;
    rcap:occursIn "IAV_DSA" .

rcap:c1d4445d53f a owl:Class ;
    rdfs:label "Serious adverse events as defined in relevant core protocol documents and this DSA" ;
    rdfs:subClassOf rcap:EndpointSpecification ;
    rcap:occursIn "END_DSA" .

rcap:c1e17f524e4 a owl:Class ;
    rdfs:label "The dose of baricitinib administered will depend on the most recent eGFR, including modification of dose for change in renal function during the treatment period." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "IIM_DSA" .

rcap:c1e51711ff1 a owl:Class ;
    rdfs:label "Where antibiotic protocols specify BPS active antibiotics for part of the year (e.g., during the monsoonal season), sites may participate in this domain where BPS specific antibiotics are not indicated." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "AB_DSA" .

rcap:c1e6ba7ff69 a owl:Class ;
    rdfs:label "No antiviral agent (no placebo)" ;
    rdfs:subClassOf rcap:InterventionSpecification ;
    rcap:occursIn "IAV_DSA" .

rcap:c1f01b046eb a owl:Class ;
    rdfs:label "Each participating ICU will be asked to outline the mechanical ventilation strategy that is used most commonly, and this may be made available to guide patient care but is regarded only as advisory and deviation from this guide is permitted at any time." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "MV_DSA" .

rcap:c20585797b1 a owl:Class ;
    rdfs:label "Alternatively, 2 mg of baricitinib can be given every second day." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "IIM_DSA" .

rcap:c206b9c5488 a owl:Class ;
    rdfs:label "Domain-specific strata are not applied to patients at the time of assessment for this domain." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "AB_DSA;CS_DSA;END_DSA;IAV_DSA;IIM_DSA;MD_DSA;MV_DSA;TAB_DSA" .

rcap:c20d2fa4a96 a owl:Class ;
    rdfs:label "all other interventions are contraindicated) are not eligible for this domain." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "AB_DSA;END_DSA;IG_DSA;IIM_DSA" .

rcap:c21617daed3 a owl:Class ;
    rdfs:label "The estimand is the transition between categories and the relative time spent in each category, modelled to produce an odds ratio from an ordinal logistic model, incorporating covariate adjustment as described in Section 7.8.3." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:coreStatus "only_40" ;
    rcap:occursIn "CORE40" .

rcap:c21e3e6e673 a owl:Class ;
    rdfs:label "Known serious hypersensitivity to beta-lactams, including penicillins or cephalosporins, will result in exclusion from interventions that include piperacillin, amoxicillin, and ceftriaxone" ;
    rdfs:subClassOf obo:OBI_0500028 ;
    rcap:occursIn "AB_DSA" .

rcap:c220498dbf0 a owl:Class ;
    rdfs:label "Hospitalized on ECLS or invasive mechanical ventilation (IMV)" ;
    rdfs:subClassOf rcap:EndpointSpecification ;
    rcap:coreStatus "only_41" ;
    rcap:occursIn "CORE41" .

rcap:c223310e85c a owl:Class ;
    rdfs:label "Enteral imatinib will be administered as a 800mg loading dose (study day 1) followed by 400mg once daily (study day 2-14) while the patient remains in hospital." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "END_DSA" .

rcap:c224ee6f9f0 a owl:Class ;
    rdfs:label "If a patient develops elevation in bilirubin 3 times the upper limit of normal or ALT/AST 5 times the upper limit of normal, imatinib should be discontinued and not restarted" ;
    rdfs:subClassOf rcap:InterventionSpecification ;
    rcap:occursIn "END_DSA" .

rcap:c225b497b1c a owl:Class ;
    rdfs:label "Survivors who never receive organ failure support during their index hospitalization to the end of study day 28 will be coded above the organ support-free days range, with categories defined by their number of hospital free days to the end of study day 28." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:coreStatus "only_41" ;
    rcap:occursIn "CORE41" .

rcap:c228b0b878c a owl:Class ;
    rdfs:label "A clinician may regard septic shock to have resolved if vasopressor infusion is being administered intermittently or at sufficiently low dose." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "CS_DSA" .

rcap:c22dce2e60a a owl:Class ;
    rdfs:label "An a priori interaction with the Corticosteroid Domain or Influenza Immunomodulator domains, while possible, will not be incorporated in the statistical model." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "IAV_DSA" .

rcap:c23237d2b0f a owl:Class ;
    rdfs:label "Received more than 48 hours of intravenous antibiotic treatment for this index illness" ;
    rdfs:subClassOf obo:OBI_0500028 ;
    rcap:occursIn "AB_DSA;TAB_DSA" .

rcap:c2350a9a8ac a owl:Class ;
    rdfs:label "The Severe State, defined as hospitalized patients:" ;
    rdfs:subClassOf rcap:CategorySpecification ;
    rcap:occursIn "PANDA" .

rcap:c2369d7796b a owl:Class ;
    rdfs:label "If an intervention reaches a Statistical Trigger for futility and the DSMB declares this as a Platform Conclusion, the ITSC will be informed that the trigger has been met." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:coreStatus "same" ;
    rcap:occursIn "CORE40;CORE41" .

rcap:c2487d60744 a owl:Class ;
    rdfs:label "Factors that should be taken into account by the DSMB and the ITSC include the results of the primary analysis, analysis of clinically relevant secondary end-points, the possibility of treatment-by-treatment interactions, the relative burden and cost of the two interventions, the clinical interpretation of the adequacy of the delta, and the possibility that ongoing randomization with a smaller delta might also allow a Statistical Trigger for superiority (with a small effect size)." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:coreStatus "same" ;
    rcap:occursIn "CORE40;CORE41" .

rcap:c258c11804f a owl:Class ;
    rdfs:label "If in the Severe State, more than 24 hours have elapsed since commencement of sustained organ failure support" ;
    rdfs:subClassOf obo:OBI_0500028 ;
    rcap:occursIn "CS_DSA" .

rcap:c25ceebb432 a owl:Class ;
    rdfs:label "Influenza virus" ;
    rdfs:subClassOf rcap:CategorySpecification ;
    rcap:occursIn "PANDA" .

rcap:c27446f2f17 a owl:Class ;
    rdfs:label "Each participating Intensive Care Unit will declare a priori which PEEP table it will follow in the Protocolized intervention." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "MV_DSA" .

rcap:c279cf239e5 a owl:Class ;
    rdfs:label "Treating clinician expects the patient to still require invasive mechanical ventilation tomorrow." ;
    rdfs:subClassOf obo:OBI_0500027 ;
    rcap:occursIn "MV_DSA" .

rcap:c27bd7ad6c4 a owl:Class ;
    rdfs:label "Borrowing is permitted between strata." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "IIM_DSA" .

rcap:c27cacd94ff a owl:Class ;
    rdfs:label "The domain-specific secondary outcome measures will be: From randomization in this domain, during the index hospitalization until the end of study day 15:" ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "END_DSA" .

rcap:c287080749b a owl:Class ;
    rdfs:label "Known serious hypersensitivity to macrolides will result in exclusion from interventions that include macrolides" ;
    rdfs:subClassOf obo:OBI_0500028 ;
    rcap:occursIn "TAB_DSA" .

rcap:c287107c507 a owl:Class ;
    rdfs:label "This may be provided as a component of the allocation status for the patient but is determined by the treating clinician and can be adjusted at any time by the treating clinician." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "MV_DSA" .

rcap:c28cabd4385 a owl:Class ;
    rdfs:label "Treating clinician regards Protocolized Mechanical Ventilation Strategy or their preferred mechanical ventilation strategy as (equally) appropriate for this patient." ;
    rdfs:subClassOf obo:OBI_0500027 ;
    rcap:occursIn "MV_DSA" .

rcap:c29280fe471 a owl:Class ;
    rdfs:label "Ventilator-free days at day 28" ;
    rdfs:subClassOf rcap:EndpointSpecification ;
    rcap:coreStatus "same" ;
    rcap:occursIn "CORE40;CORE41" .

rcap:c2945b9d83a a owl:Class ;
    rdfs:label "For patients allocated to the shock-dependent duration hydrocortisone intervention, who are not in septic shock at the time of randomization, Immediate Reveal and Initiation is interpreted as intention to commence hydrocortisone if and when septic shock develops." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "CS_DSA" .

rcap:c29662860b2 a owl:Class ;
    rdfs:label "The allocated intervention will be commenced immediately after allocation status is revealed." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "AB_DSA;END_DSA;IAV_DSA;IG_DSA;IIM_DSA;MV_DSA;TAB_DSA" .

rcap:c298d7d1660 a owl:Class ;
    rdfs:label "Ceftriaxone ≥1 gram administered intravenously (IV) once daily" ;
    rdfs:subClassOf rcap:InterventionSpecification ;
    rcap:occursIn "AB_DSA" .

rcap:c29fbe389a1 a owl:Class ;
    rdfs:label "It is required that all sites will participate in the no antiviral intervention." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "IAV_DSA" .

rcap:c2b10bf304c a owl:Class ;
    rdfs:label "Participants assigned to imatinib who are women of childbearing potential (that is fertile, following menarche and until becoming post-menopausal unless permanently sterile, such as following hysterectomy, bilateral salpingectomy and bilateral oophorectomy) must be advised to use highly effective contraception for 15 days following the last dose of imatinib." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "END_DSA" .

rcap:c2bad68295e a owl:Class ;
    rdfs:label "We acknowledge mortality is tied to a longer time frame than the ordinal scale, however integrating 90-day mortality with a shorter-term outcome is patient-centered, allows continuity with previous versions of the Core protocol and the Pandemic Appendix to Core, and improves statistical power." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:coreStatus "only_40" ;
    rcap:occursIn "CORE40" .

rcap:c2bb8052454 a owl:Class ;
    rdfs:label "Other thrombotic events" ;
    rdfs:subClassOf rcap:EndpointSpecification ;
    rcap:occursIn "END_DSA" .

rcap:c2bd61c29d0 a owl:Class ;
    rdfs:label "Known objection to receiving plasma products will exclude a patient from receiving any plasma components" ;
    rdfs:subClassOf obo:OBI_0500028 ;
    rcap:occursIn "IG_DSA" .

rcap:c2c383e5024 a owl:Class ;
    rdfs:label "The Macrolide component contributes to all interventions and the beta-lactam agents are all members of the same class of antibiotic." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "AB_DSA" .

rcap:c2c5daff44d a owl:Class ;
    rdfs:label "Prior to the study commencement, sites will select which interventions that patients at their site will be allocated to, based on the current standards of acceptable care, local epidemiology and regulatory status of antibiotics as outlined below." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "AB_DSA" .

rcap:c2ca322189f a owl:Class ;
    rdfs:label "Patients may also be excluded from receiving one or more interventions within the domain for patient-specific reasons." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "AB_DSA;CS_DSA;END_DSA;IAV_DSA;IG_DSA;IIM_DSA" .

rcap:c2cc32f1c28 a owl:Class ;
    rdfs:label "A patient may transition between moderate, severe, and recovering illness severity stages while remaining potentially eligible within the Platform but is assigned to the Illness Severity State that applies at the time of each randomization." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "PANDA" .

rcap:c2cebf0c070 a owl:Class ;
    rdfs:label "Baricitinib will be withheld if the eGFR is less than 15 mL/min/1.73m 2 and in patients who are receiving intermittent or continuous renal replacement therapy In children 2 years to <9 years of age, the baricitinib dose will be 2mg daily if the eGFR is at least 60 mL/min/1.73m 2 ." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "IIM_DSA" .

rcap:c2cefafea4f a owl:Class ;
    rdfs:label "new diagnosis of chronic myeloid leukemia) until the end of study day 14 or until hospital discharge, whichever occurs first." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "END_DSA" .

rcap:c2d16af401c a owl:Class ;
    rdfs:label "Discontinuation if the patient experiences a serious adverse event (SAE) that is thought to be related to a study drug" ;
    rdfs:subClassOf rcap:InterventionSpecification ;
    rcap:occursIn "AB_DSA;TAB_DSA" .

rcap:c2dd383f950 a owl:Class ;
    rdfs:label "This will create a score reflecting whether and how quickly they recovered, where better health states receive weights closer to 0." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:coreStatus "only_41" ;
    rcap:occursIn "CORE41" .

rcap:c2ddec897ec a owl:Class ;
    rdfs:label "The following pathogen categories are recognized:" ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "PANDA" .

rcap:c2de2c66180 a owl:Class ;
    rdfs:label "In children 2 years to <9 years of age, baricitinib will be withheld if the eGFR is <30 mL/min/1.73m 2 or the patient is receiving renal replacement therapy For patients who are unable to swallow whole tablets, baricitinib may be dispersed in water and delivered via an enteral feeding tube." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "IIM_DSA" .

rcap:c2f2797ef7b a owl:Class ;
    rdfs:label "Date and time of ICU admission(s) (where applicable)" ;
    rdfs:subClassOf rcap:DataCollectionSpecification ;
    rcap:coreStatus "same" ;
    rcap:occursIn "CORE40;CORE41" .

rcap:c2f3692658b a owl:Class ;
    rdfs:label "Cause of immunosuppression at baseline" ;
    rdfs:subClassOf rcap:DataCollectionSpecification ;
    rcap:occursIn "IG_DSA" .

rcap:c2f468ce689 a owl:Class ;
    rdfs:label "It is acknowledged that, for bacterial infection or co-infection, results from commonly used microbiological testing strategies may take a significant time (e.g., culture) and have low sensitivity." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "PANDA" .

rcap:c2fc6c76dfa a owl:Class ;
    rdfs:label "SAE as defined in Core Protocol" ;
    rdfs:subClassOf rcap:DataCollectionSpecification ;
    rcap:occursIn "MD_DSA" .

rcap:c2fd0baa5ef a owl:Class ;
    rdfs:label "The study interventions can be temporarily or permanently discontinued at any time by the treating clinician if doing so is regarded as being in the best interests of the patient." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "AB_DSA;END_DSA;IAV_DSA;IIM_DSA;MD_DSA;TAB_DSA" .

rcap:c2ff63e56e1 a owl:Class ;
    rdfs:label "There are no additional domain-specific secondary outcome measures." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "CS_DSA" .

rcap:c304206ce4e a owl:Class ;
    rdfs:label "From randomization in this domain, during the index hospitalization unless otherwise specified, censored 90 days after enrollment:" ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "END_DSA" .

rcap:c30428b06d8 a owl:Class ;
    rdfs:label "Patients allocated to the fixed duration dexamethasone intervention, will have dexamethasone, IV or enteral 6 mg daily for 10 days while in hospital." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "CS_DSA" .

rcap:c308f0c806e a owl:Class ;
    rdfs:label "These microbiological test results do not influence pathogen strata for the primary analysis but can contribute to the definition of populations for additional safety analyses, secondary analyses or post-platform conclusion subgroups of interest for specific domains." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "PANDA" .

rcap:c30a922617d a owl:Class ;
    rdfs:label "It is accepted as being established that treatment with corticosteroids results in increase in blood sugar levels and decreases the duration of vasoactive therapy." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "CS_DSA" .

rcap:c30b25c536b a owl:Class ;
    rdfs:label "Patients who are eligible for only a single intervention at a site (i.e., all other interventions are contraindicated) are not eligible for this domain." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "CS_DSA;TAB_DSA" .

rcap:c314818bf48 a owl:Class ;
    rdfs:label "interventions At the time of establishing eligibility, the treating clinician will specify a current target range for the oxygen saturation." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "MV_DSA" .

rcap:c31bd59df7c a owl:Class ;
    rdfs:label "Major bleeding (as defined by the ISTH criteria)" ;
    rdfs:subClassOf rcap:EndpointSpecification ;
    rcap:occursIn "END_DSA" .

rcap:c322d3a6829 a owl:Class ;
    rdfs:label "Administration of oxygen support including ECLS" ;
    rdfs:subClassOf rcap:DataCollectionSpecification ;
    rcap:coreStatus "same" ;
    rcap:occursIn "CORE40;CORE41" .

rcap:c323b860242 a owl:Class ;
    rdfs:label "The timing of the revealing of allocation status and administration of interventions is specified to be Randomization with Deferred Reveal to permit confirmation of microbiological diagnosis if results of testing are not known at the time of initial assessment of eligibility (see relevant core protocol documents)." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "IG_DSA" .

rcap:c324186f8e2 a owl:Class ;
    rdfs:label "The treating clinician believes that participation in the domain would not be in the best interests of the patient" ;
    rdfs:subClassOf obo:OBI_0500028 ;
    rcap:occursIn "AB_DSA;CS_DSA;END_DSA;IAV_DSA;IG_DSA;IIM_DSA;MD_DSA;MV_DSA;TAB_DSA" .

rcap:c32c4257f26 a owl:Class ;
    rdfs:label "Domains may also constrain eligibility according to additional criteria related to the nature of the sample undergoing microbiological tests, the time-window in which the sample is collected, or microbiological testing types." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "PANDA" .

rcap:c32c8e26722 a owl:Class ;
    rdfs:label "If in the Moderate State, patient is receiving some form of supplemental oxygen (simple facemask, low or high flow nasal oxygen, or non-invasive ventilation)" ;
    rdfs:subClassOf obo:OBI_0500027 ;
    rcap:occursIn "CS_DSA" .

rcap:c33f3696e91 a owl:Class ;
    rdfs:label "Regional income level: Regional income level categories are defined by World Bank Income Classification (high, upper middle, lower middle, low) of the country of patient enrollment." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "PANDA" .

rcap:c347c9d7e7f a owl:Class ;
    rdfs:label "Days free of organ failure support will be coded as 0-28." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:coreStatus "only_41" ;
    rcap:occursIn "CORE41" .

rcap:c34900c49d6 a owl:Class ;
    rdfs:label "For domains with only two interventions a valid Statistical Trigger for equivalence or noninferiority will be reported as a Platform Conclusion." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:coreStatus "same" ;
    rcap:occursIn "CORE40;CORE41" .

rcap:c34ba902a86 a owl:Class ;
    rdfs:label "If septic shock develops due to a cause other than the respiratory tract infection, administration of corticosteroids is at the discretion of the treating clinician." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "CS_DSA" .

rcap:c34bbecb9d3 a owl:Class ;
    rdfs:label "Opinions and beliefs regarding participation in research (reported at 180 days)" ;
    rdfs:subClassOf rcap:DataCollectionSpecification ;
    rcap:coreStatus "same" ;
    rcap:occursIn "CORE40;CORE41" .

rcap:c3550866d02 a owl:Class ;
    rdfs:label "Administration of etomidate between index hospital admission and randomization, and between randomization and the end of study day 8" ;
    rdfs:subClassOf rcap:DataCollectionSpecification ;
    rcap:occursIn "CS_DSA" .

rcap:c3563d09427 a owl:Class ;
    rdfs:label "A platelet count < 50 x 10 9 / L will result in exclusion from receiving tocilizumab" ;
    rdfs:subClassOf obo:OBI_0500028 ;
    rcap:occursIn "IIM_DSA" .

rcap:c36608008f9 a owl:Class ;
    rdfs:label "This Appendix defines stage of illness in the following three categories of illness severity at the time of randomization:" ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "PANDA" .

rcap:c367ebe39ce a owl:Class ;
    rdfs:label "An a priori interaction with the Corticosteroid Domain or Influenza Antiviral Domain are considered possible but will only be investigated in post-trial subgroup analyses." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "IIM_DSA" .

rcap:c36b0150e31 a owl:Class ;
    rdfs:label "Baricitinib will be given at a dose of 2 mg daily if the eGFR is at least 30 and less than 60." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "IIM_DSA" .

rcap:c36cd017fd8 a owl:Class ;
    rdfs:label "If the treating clinician would usually apply low tidal volume ventilation this is acceptable." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "MV_DSA" .

rcap:c37a3fade76 a owl:Class ;
    rdfs:label "All secondary endpoints as specified in Core Protocol documents." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "END_DSA;IG_DSA" .

rcap:c38144b1e19 a owl:Class ;
    rdfs:label "A standard dose for oseltamivir in children is 6 mg/kg/day, divided into two doses, up to children of 40 kg." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "IAV_DSA" .

rcap:c381f58d58a a owl:Class ;
    rdfs:label "It is acknowledged that patients hospitalized with respiratory tract infection may not have a causative pathogen diagnosed by clinical assessment or confirmed by microbiological testing." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "PANDA" .

rcap:c384387fa17 a owl:Class ;
    rdfs:label "Hydrocortisone is to be commenced as soon as septic shock is diagnosed, including immediately after enrollment if septic shock has already been diagnosed." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "CS_DSA" .

rcap:c3895c1d30c a owl:Class ;
    rdfs:label "Acceptable modes of ventilation include but are not limited to Pressure Control, Synchronized Intermittent Mandatory Ventilation (SIMV), Assist Control (AC), and APRV." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "MV_DSA" .

rcap:c38a6a4fdb6 a owl:Class ;
    rdfs:label "Patient is already receiving or a clinical decision has been made to commence imatinib or another tyrosine kinase inhibitor targeting the same pathway as imatinib (i.e. dasatinib, nilotinib, ponatinib)" ;
    rdfs:subClassOf obo:OBI_0500028 ;
    rcap:occursIn "END_DSA" .

rcap:c392ca2f8d9 a owl:Class ;
    rdfs:label "The treating clinician will set the mode of ventilation as either SIMV, Assist Control, or Pressure Regulated Volume Control, setting the tidal volume to that specified by the on-line eligibility system or calculated by the site." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "MV_DSA" .

rcap:c39521898a2 a owl:Class ;
    rdfs:label "Additional domain-specific data will be collected on all participants:" ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "IG_DSA" .

rcap:c39a5310383 a owl:Class ;
    rdfs:label "No change to the interventions within the domain with continuation of RAR. This could be to further evaluate secondary endpoints, a smaller delta of equivalence, or interest in interactions with other interventions. Such changes would require amendment to the DSA. This could occur with or without reporting a Platform Conclusion." ;
    rdfs:subClassOf rcap:AllocationSpecification ;
    rcap:coreStatus "same" ;
    rcap:occursIn "CORE40;CORE41" .

rcap:c39ece23ec4 a owl:Class ;
    rdfs:label "This intervention is only available for patients in the Severe Illness Severity State at time of randomization." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "CS_DSA" .

rcap:c3a328f808d a owl:Class ;
    rdfs:label "Antibiotic therapy should be discontinued if there is development of a SAE which, in the opinion of the treating clinician, could be related to participation in this domain." ;
