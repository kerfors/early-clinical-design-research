    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "AB_DSA;END_DSA;IIM_DSA;MD_DSA;MV_DSA;TAB_DSA" .

rcap:c80882e3170 a owl:Class ;
    rdfs:label "No other strata will contribute to the unit-of-analysis, although this may be modified as an operational decision as specified in the Current State document." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "IIM_DSA" .

rcap:c814b709fb3 a owl:Class ;
    rdfs:label "Shock State, defined in two categories, present or absent, with ‘present’ defined as patients receiving a continuous infusion of intravenous vasopressor or inotrope medications" ;
    rdfs:subClassOf rcap:CategorySpecification ;
    rcap:occursIn "PANDA" .

rcap:c81b03e311b a owl:Class ;
    rdfs:label "Moxifloxacin or Levofloxacin" ;
    rdfs:subClassOf rcap:InterventionSpecification ;
    rcap:occursIn "AB_DSA" .

rcap:c81b67d784e a owl:Class ;
    rdfs:label "All secondary endpoints as specified in the Core Protocol The domain-specific secondary outcome measures (from randomization, during the index hospitalization, censored 90 days after enrollment) will be:" ;
    rdfs:subClassOf rcap:DesignStatement ;
