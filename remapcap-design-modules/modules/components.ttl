rcap:c5c4df60c48 a owl:Class ;
    rdfs:label "Administration of allocated medications" ;
    rdfs:subClassOf rcap:DataCollectionSpecification ;
    rcap:coreStatus "same" ;
    rcap:occursIn "CORE40;CORE41" .

rcap:c5cecd99a5f a owl:Class ;
    rdfs:label "An alanine aminotransferase or an aspartate aminotransferase that is more than five times the upper limit of normal will result in exclusion from receiving tocilizumab" ;
    rdfs:subClassOf obo:OBI_0500028 ;
    rcap:occursIn "IIM_DSA" .

rcap:c5cfc3e893b a owl:Class ;
    rdfs:label "This Appendix defines the following categories:" ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "PANDA" .

rcap:c5cfed2565b a owl:Class ;
    rdfs:label "Patients may have multiple intervention exclusions (e.g." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "AB_DSA" .

rcap:c5dc5cbaa4f a owl:Class ;
    rdfs:label "In this regard, the Macrolide Duration Domain sits within the macrolide-containing interventions of Antibiotic Domain(s) within this Platform." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "MD_DSA" .

rcap:c5eb0851e13 a owl:Class ;
    rdfs:label "Empiric antibiotic therapy for bacterial pneumonia is considered appropriate" ;
    rdfs:subClassOf obo:OBI_0500027 ;
    rcap:occursIn "AB_DSA" .

rcap:c5f64d55307 a owl:Class ;
    rdfs:label "Administration of renal replacement therapy" ;
    rdfs:subClassOf rcap:DataCollectionSpecification ;
    rcap:coreStatus "same" ;
    rcap:occursIn "CORE40;CORE41" .

rcap:c5f86629818 a owl:Class ;
    rdfs:label "The duration of administration of the interventions outlined in this domain is at the discretion of the treating clinician." ;
    rdfs:subClassOf rcap:DesignStatement ;
    rcap:occursIn "MV_DSA" .

rcap:c5fd82fa36d a owl:Class ;
    rdfs:label "Community-acquired, defined as acute infection acquired outside of the hospital and manifesting within 48 hours of hospital admission" ;
    rdfs:subClassOf rcap:CategorySpecification ;
    rcap:occursIn "PANDA" .

rcap:c608aaeeb9b a owl:Class ;
    rdfs:label "If in the Severe State, patient has pneumonia" ;
    rdfs:subClassOf obo:OBI_0500027 ;
    rcap:occursIn "CS_DSA" .

rcap:c6218f33cb2 a owl:Class ;
    rdfs:label "If in the Moderate State, more than 96 hours has elapsed since hospital admission" ;
    rdfs:subClassOf obo:OBI_0500028 ;
    rcap:occursIn "IAV_DSA" .

rcap:c627ea981bb a owl:Class ;
    rdfs:label "HRQoL at 180 days after enrollment using the EQ5D-5L or EQ-5D-Y and PedsQL-SF15 in participants aged less than 18 years (where feasible, refer to relevant regional RSA)" ;
    rdfs:subClassOf rcap:EndpointSpecification ;
    rcap:coreStatus "same" ;
    rcap:occursIn "CORE40;CORE41" .

rcap:c62d08e12d8 a owl:Class ;
    rdfs:label "More than 48 hours has elapsed since commencement of sustained organ failure support." ;
    rdfs:subClassOf obo:OBI_0500028 ;
