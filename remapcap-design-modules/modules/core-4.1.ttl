    rcap:evidencePosition "lead_in:2" ;
    rcap:evidenceSection "7.6.3" ;
    rcap:evidenceText "Survival and Recovery Trajectory Survival and Recovery Trajectory is a composite of all-cause mortality at day 90 and, among survivors, a daily ordinal scale of illness and recovery to 28 days." ;
    rcap:occurrenceKind "endpoint_exploratory" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:CoreDesign_4_1 ;
    owl:annotatedTarget _:N3e80b49fa4a441e986d83074af0fd1bf ;
    rcap:evidenceDoc "Core Protocol 4.1" ;
    rcap:evidencePosition "lead_in:1" ;
    rcap:evidenceSection "7.6.1" ;
    rcap:evidenceText "The primary endpoint is a composite of 90-day all-cause mortality and, among survivors, the number of days on which the patient was not receiving organ failure support (OFS) during the index hospitalization, up to the end of study day 28; and among survivors who never receive OFS, hospital free days for the index hospitalization up to the end of study day 28." ;
    rcap:occurrenceKind "endpoint_primary" .

