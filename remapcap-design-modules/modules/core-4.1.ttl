[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:CoreDesign_4_1 ;
    owl:annotatedTarget _:N9d786b75368b4ffbbf64ab3d79847bfa ;
    rcap:evidenceDoc "Core Protocol 4.1" ;
