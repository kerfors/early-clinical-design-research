    rcap:evidencePosition "lead_in:7" ;
    rcap:evidenceSection "3.4" ;
    rcap:evidenceText "Pandemic respiratory pathogen infection is stratified as pandemic respiratory pathogen infection confirmed (the pandemic respiratory pathogen is detected on microbiological testing with a clinically compatible illness) and pandemic respiratory pathogen infection not confirmed." ;
    rcap:occurrenceKind "category_pathogen_stratum" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:PandaDesign ;
    owl:annotatedTarget _:Nee2c97d561ce4b2e86af46c53c7b56dc ;
    rcap:evidenceDoc "Patient, Pathogen and Disease Appendix 1" ;
    rcap:evidencePosition "lead_in:2" ;
    rcap:evidenceSection "3.4.1" ;
    rcap:evidenceText "However, if the pandemic pathogen is considered to be sufficiently similar to an existing pathogen (e.g., pandemic influenza virus and seasonal influenza virus) it will be an operational decision as to whether borrowing, pooling, or an independent analysis occurs in the primary statistical model." ;
    rcap:occurrenceKind "category_pathogen_stratum" .

