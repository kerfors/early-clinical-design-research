    rcap:appendixTo rcap:CoreDesign ;
    rcap:documentDate "5 Nov 2024" ;
    rcap:documentTitle "Patient, Pathogen and Disease Appendix 1" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:PandaDesign ;
    owl:annotatedTarget _:Ne48f5b3ad912480d9f14c38ac9ac747a ;
    rcap:evidenceDoc "Patient, Pathogen and Disease Appendix 1" ;
    rcap:evidencePosition "lead_in:6" ;
    rcap:evidenceSection "3.4" ;
    rcap:evidenceText "Bacterial infection is stratified as bacterial infection diagnosed (comprising cases where infection with a recognized bacterial respiratory pathogen is confirmed or probable) and bacterial infection not diagnosed (comprising cases where infection with a recognized bacterial respiratory pathogen is neither confirmed nor probable i.e., bacterial infection was assessed as only possible or not suspected)." ;
    rcap:occurrenceKind "category_pathogen_stratum" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:PandaDesign ;
    owl:annotatedTarget _:N6e94b02f22f446229cb72649856260ac ;
    rcap:evidenceDoc "Patient, Pathogen and Disease Appendix 1" ;
    rcap:evidencePosition "lead_in:15" ;
    rcap:evidenceSection "3.1" ;
    rcap:evidenceText "For some pathogens, clinical features may be sufficiently similar that a domain considers them collectively (e.g., ‘confirmed viral respiratory tract infection’ may be a group defined as the detection of any virus known to cause respiratory tract infection on microbiological testing)." ;
    rcap:occurrenceKind "category_pathogen" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:PandaDesign ;
    owl:annotatedTarget _:N657216d0ab3a45c0af946e95daa4ee2b ;
    rcap:evidenceDoc "Patient, Pathogen and Disease Appendix 1" ;
    rcap:evidencePosition "lead_in:5" ;
    rcap:evidenceSection "2" ;
    rcap:evidenceText "Domains may pool income level categories, for example, distinguishing two categories: high-income and non-high income (incorporating upper-middle, lower-middle, and low)." ;
    rcap:occurrenceKind "category_patient" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:PandaDesign ;
    owl:annotatedTarget _:Na4231706e75f4a1180a147b0bb3cf6e8 ;
    rcap:evidenceDoc "Patient, Pathogen and Disease Appendix 1" ;
    rcap:evidencePosition "lead_in:2" ;
    rcap:evidenceSection "4.3" ;
    rcap:evidenceText "Randomization is only permitted once in each defined disease stage and illness severity analytic strata are always applied for domains that randomize patients in more than one stage of illness severity." ;
    rcap:occurrenceKind "category_illness_severity" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:PandaDesign ;
    owl:annotatedTarget _:N5abe7bd809644348b84601ae51dd1d0d ;
    rcap:evidenceDoc "Patient, Pathogen and Disease Appendix 1" ;
    rcap:evidenceGlyph "o" ;
    rcap:evidencePage 10 ;
    rcap:evidencePosition "2" ;
    rcap:evidenceSection "4.4" ;
    rcap:evidenceText "New or worsening respiratory symptoms that developed within 2 weeks prior to the onset of oxygen/respiratory support" ;
    rcap:occurrenceKind "category_clinical_feature" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:PandaDesign ;
    owl:annotatedTarget _:N2413ef50a6514990afb9fd115288a0eb ;
    rcap:evidenceDoc "Patient, Pathogen and Disease Appendix 1" ;
    rcap:evidenceGlyph "•" ;
    rcap:evidencePage 10 ;
    rcap:evidencePosition "9" ;
    rcap:evidenceSection "4.4" ;
    rcap:evidenceText "Acute Respiratory Distress Syndrome is a State defined in two categories, present or absent, with ‘present’ defined as patients with all of the following:" ;
    rcap:occurrenceKind "category_clinical_feature" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:PandaDesign ;
    owl:annotatedTarget _:Ncbd63991d2ad4dccb6cf4dd9c7c28427 ;
    rcap:evidenceDoc "Patient, Pathogen and Disease Appendix 1" ;
    rcap:evidenceGlyph "o" ;
    rcap:evidencePage 11 ;
    rcap:evidencePosition "13" ;
    rcap:evidenceSection "4.4" ;
    rcap:evidenceText "Receiving respiratory support with high-flow nasal oxygen (HFNO) at a flow rate of at least 30 liters per minute (or at least 2 liters per minute per kilogram of bodyweight in children less than 15 kilograms) OR invasive mechanical ventilation (IMV), non-invasive ventilation (NIV) or continuous positive airways pressure (CPAP) with PEEP or CPAP ≥5cm H 2 O. (This criterion is not required in resource-limited settings where none of these modalities are available)" ;
    rcap:occurrenceKind "category_clinical_feature" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:PandaDesign ;
    owl:annotatedTarget _:N12092353a14d45809b16e0f4f9540118 ;
    rcap:evidenceDoc "Patient, Pathogen and Disease Appendix 1" ;
    rcap:evidencePosition "lead_in:13" ;
    rcap:evidenceSection "3.1" ;
    rcap:evidenceText "Therefore, the population considered to have bacterial infection is defined primarily by clinical assessment plus any microbiological data available at the time of eligibility assessment rather than final microbiological test results." ;
    rcap:occurrenceKind "category_pathogen" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:PandaDesign ;
    owl:annotatedTarget _:N77586848566242b39ba16d0e2284d81b ;
    rcap:evidenceDoc "Patient, Pathogen and Disease Appendix 1" ;
    rcap:evidencePosition "lead_in:12" ;
    rcap:evidenceSection "3.1" ;
    rcap:evidenceText "It is acknowledged that, for bacterial infection or co-infection, results from commonly used microbiological testing strategies may take a significant time (e.g., culture) and have low sensitivity." ;
    rcap:occurrenceKind "category_pathogen" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:PandaDesign ;
    owl:annotatedTarget _:N8f4d11a52bf14443a0a55b267e7f3785 ;
    rcap:evidenceDoc "Patient, Pathogen and Disease Appendix 1" ;
    rcap:evidencePosition "lead_in:4" ;
    rcap:evidenceSection "2" ;
    rcap:evidenceText "Regional income level: Regional income level categories are defined by World Bank Income Classification (high, upper middle, lower middle, low) of the country of patient enrollment." ;
    rcap:occurrenceKind "category_patient" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:PandaDesign ;
    owl:annotatedTarget _:N03882ca093024207a817d59f63d10e00 ;
    rcap:evidenceDoc "Patient, Pathogen and Disease Appendix 1" ;
    rcap:evidencePosition "lead_in:9" ;
    rcap:evidenceSection "3.4" ;
    rcap:evidenceText "Such participants may be considered to be a separate pathogen analysis stratum." ;
    rcap:occurrenceKind "category_pathogen_stratum" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:PandaDesign ;
    owl:annotatedTarget _:Ne506779e4c084186848d77e237041c32 ;
    rcap:evidenceDoc "Patient, Pathogen and Disease Appendix 1" ;
    rcap:evidenceGlyph "•" ;
    rcap:evidencePage 4 ;
    rcap:evidencePosition "1" ;
    rcap:evidenceSection "3" ;
    rcap:evidenceText "Influenza virus" ;
    rcap:occurrenceKind "category_pathogen" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:PandaDesign ;
    owl:annotatedTarget _:Ne0b2ee375d7a4d29a922f1e1c665e952 ;
    rcap:evidenceDoc "Patient, Pathogen and Disease Appendix 1" ;
    rcap:evidencePosition "lead_in:2" ;
    rcap:evidenceSection "4.4" ;
    rcap:evidenceText "This Appendix defines the following categories:" ;
    rcap:occurrenceKind "category_clinical_feature" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:PandaDesign ;
    owl:annotatedTarget _:Nf066b7efcb4f4829ba43747e5ffd5e98 ;
    rcap:evidenceDoc "Patient, Pathogen and Disease Appendix 1" ;
    rcap:evidenceGlyph "•" ;
    rcap:evidencePage 8 ;
    rcap:evidencePosition "1" ;
    rcap:evidenceSection "4.2" ;
    rcap:evidenceText "Respiratory tract infection, defined in two categories, lower or upper, with lower defined as infection of the airways below the level of the larynx (including tracheitis, bronchitis, bronchiolitis, and pneumonia) and upper defined as infection of the airways at the level of the larynx and above, excluding isolated otitis media or mastoiditis" ;
    rcap:occurrenceKind "category_disease_entity" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:PandaDesign ;
    owl:annotatedTarget _:Na4dfbb46caa34f81a6a53da3b9824d21 ;
    rcap:evidenceDoc "Patient, Pathogen and Disease Appendix 1" ;
    rcap:evidencePosition "lead_in:11" ;
    rcap:evidenceSection "3.1" ;
    rcap:evidenceText "Each pathogen status used for analysis is defined as a binary variable at Platform level." ;
    rcap:occurrenceKind "category_pathogen" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:PandaDesign ;
    owl:annotatedTarget _:Nf7de824259104b59821593eb25fc48e8 ;
    rcap:evidenceDoc "Patient, Pathogen and Disease Appendix 1" ;
    rcap:evidencePosition "lead_in:2" ;
    rcap:evidenceSection "4.2" ;
    rcap:evidenceText "This Appendix defines the following disease entity states at the time of randomization:" ;
    rcap:occurrenceKind "category_disease_entity" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:PandaDesign ;
    owl:annotatedTarget _:Nb45fdfc4c56c4e88b75cdaa507ad26bf ;
    rcap:evidenceDoc "Patient, Pathogen and Disease Appendix 1" ;
    rcap:evidencePosition "lead_in:1" ;
    rcap:evidenceSection "4.3" ;
    rcap:evidenceText "Respiratory illness severity can change over time as a patient’s disease progresses and illness severity is an important determinate of both clinical outcome and potential differential treatment effect." ;
    rcap:occurrenceKind "category_illness_severity" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:PandaDesign ;
    owl:annotatedTarget _:N04f54cf2761c405cb23d45eb04edd416 ;
    rcap:evidenceDoc "Patient, Pathogen and Disease Appendix 1" ;
    rcap:evidencePosition "lead_in:8" ;
    rcap:evidenceSection "3.1" ;
    rcap:evidenceText "Domains can select the infection likelihood threshold that is required for eligibility." ;
    rcap:occurrenceKind "category_pathogen" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:PandaDesign ;
    owl:annotatedTarget _:N76d1eb1c24644b6b8988814b50fc37d8 ;
    rcap:evidenceDoc "Patient, Pathogen and Disease Appendix 1" ;
    rcap:evidencePosition "lead_in:3" ;
    rcap:evidenceSection "3.2" ;
    rcap:evidenceText "For the purposes of eligibility, domains may include patients with differing likelihood thresholds for the same pathogen (e.g., one domain may include patients with suspected or confirmed influenza infection and another may constrain eligibility to confirmed infection only)." ;
    rcap:occurrenceKind "category_pathogen" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:PandaDesign ;
    owl:annotatedTarget _:N0991f70f713d4f87adafafaddec1bf90 ;
    rcap:evidenceDoc "Patient, Pathogen and Disease Appendix 1" ;
    rcap:evidenceGlyph "•" ;
    rcap:evidencePage 10 ;
    rcap:evidencePosition "5" ;
    rcap:evidenceSection "4.4" ;
    rcap:evidenceText "Hypoxemic State, defined in 3 categories comprising:" ;
    rcap:occurrenceKind "category_clinical_feature" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:PandaDesign ;
    owl:annotatedTarget _:N61c45248b6b5492d81deba062088144f ;
    rcap:evidenceDoc "Patient, Pathogen and Disease Appendix 1" ;
    rcap:evidencePosition "lead_in:14" ;
    rcap:evidenceSection "3.1" ;
    rcap:evidenceText "For other pathogens, the clinical features are non-specific and microbiological tests have a high sensitivity and, in this case, microbiological testing may be more important than clinical suspicion." ;
    rcap:occurrenceKind "category_pathogen" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:PandaDesign ;
    owl:annotatedTarget _:N40eb8f62f11b429ea66080f468082c1c ;
    rcap:evidenceDoc "Patient, Pathogen and Disease Appendix 1" ;
    rcap:evidencePosition "lead_in:1" ;
    rcap:evidenceSection "3.1" ;
    rcap:evidenceText "Clinical treatment decisions are often made prior to the availability of microbiological test results and may rely on history, examination and supporting investigations such as inflammatory markers and imaging (“clinical assessment”) to include or exclude potential infecting pathogen(s) relevant to those decisions." ;
    rcap:occurrenceKind "category_pathogen" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:PandaDesign ;
    owl:annotatedTarget _:N09538b7c72074aac9875e4cb31cf0937 ;
    rcap:evidenceDoc "Patient, Pathogen and Disease Appendix 1" ;
    rcap:evidencePosition "lead_in:8" ;
    rcap:evidenceSection "3.4" ;
    rcap:evidenceText "It is acknowledged that patients hospitalized with respiratory tract infection may not have a causative pathogen diagnosed by clinical assessment or confirmed by microbiological testing." ;
    rcap:occurrenceKind "category_pathogen_stratum" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:PandaDesign ;
    owl:annotatedTarget _:N0b1b3c19760e4a89862562c2067813ce ;
    rcap:evidenceDoc "Patient, Pathogen and Disease Appendix 1" ;
    rcap:evidencePosition "lead_in:1" ;
    rcap:evidenceSection "3" ;
    rcap:evidenceText "The following pathogen categories are recognized:" ;
    rcap:occurrenceKind "category_pathogen" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:PandaDesign ;
    owl:annotatedTarget _:Nf14f5dbc0ba649d596d466b0c3f169e9 ;
    rcap:evidenceDoc "Patient, Pathogen and Disease Appendix 1" ;
    rcap:evidenceGlyph "•" ;
    rcap:evidencePage 9 ;
    rcap:evidencePosition "12" ;
    rcap:evidenceSection "4.3" ;
    rcap:evidenceText "High-flow nasal oxygen with a fractional inspired oxygen concentration of 0.4 or higher and with flow rate of at least 30 liters per minute (or at least 2 liters per minute per kilogram of bodyweight in children less than 15 kilograms)" ;
    rcap:occurrenceKind "category_illness_severity" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:PandaDesign ;
    owl:annotatedTarget _:N5bae070719764f348a04f1b36ee60f2a ;
    rcap:evidenceDoc "Patient, Pathogen and Disease Appendix 1" ;
    rcap:evidencePosition "trailing:3" ;
    rcap:evidenceSection "4.3" ;
    rcap:evidenceText "A patient may transition between moderate, severe, and recovering illness severity stages while remaining potentially eligible within the Platform but is assigned to the Illness Severity State that applies at the time of each randomization." ;
    rcap:occurrenceKind "category_illness_severity" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:PandaDesign ;
    owl:annotatedTarget _:N28c776e3ff9f4d85bb209814e226553b ;
    rcap:evidenceDoc "Patient, Pathogen and Disease Appendix 1" ;
    rcap:evidencePosition "trailing:1" ;
    rcap:evidenceSection "4.3" ;
    rcap:evidenceText "Qualifying organ failure support is defined as: Patients are not eligible for randomization in the Moderate State if they have been previously randomized in the Severe State, if they have previously been randomized in the Recovering State, or if they have received invasive mechanical ventilation at any time during this acute admission." ;
    rcap:occurrenceKind "category_illness_severity" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:PandaDesign ;
    owl:annotatedTarget _:N8f6bd259665e4628bd35378ba81dcbcc ;
    rcap:evidenceDoc "Patient, Pathogen and Disease Appendix 1" ;
    rcap:evidenceGlyph "•" ;
    rcap:evidencePage 4 ;
    rcap:evidencePosition "4" ;
    rcap:evidenceSection "3" ;
    rcap:evidenceText "Respiratory syncytial virus (RSV)" ;
    rcap:occurrenceKind "category_pathogen" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:PandaDesign ;
    owl:annotatedTarget _:Nc85b59ac9dbd45858bf06d1e8b8ca725 ;
    rcap:evidenceDoc "Patient, Pathogen and Disease Appendix 1" ;
    rcap:evidencePosition "lead_in:4" ;
    rcap:evidenceSection "3.4" ;
    rcap:evidenceText "RSV infection is stratified as RSV infection confirmed (RSV detected on microbiological testing with a compatible clinical assessment) and RSV not confirmed." ;
    rcap:occurrenceKind "category_pathogen_stratum" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
