    rcap:occurrenceKind "data_collection" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:CoreDesign_4_0 ;
    owl:annotatedTarget _:Nc8be6e40a11d4922aa38e9ca5746d2c6 ;
    rcap:evidenceDoc "Core Protocol 4.0" ;
    rcap:evidencePosition "trailing:1" ;
    rcap:evidenceSection "7.8.7" ;
    rcap:evidenceText "Factors that should be taken into account by the DSMB and the ITSC include the results of the primary analysis, analysis of clinically relevant secondary end-points, the possibility of treatment-by-treatment interactions, the relative burden and cost of the two interventions, the clinical interpretation of the adequacy of the delta, and the possibility that ongoing randomization with a smaller delta might also allow a Statistical Trigger for superiority (with a small effect size)." ;
    rcap:occurrenceKind "allocation_rar" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:CoreDesign_4_0 ;
    owl:annotatedTarget _:Ndc4febda5e2b42d8a8aca7ac32cb2ce4 ;
    rcap:evidenceDoc "Core Protocol 4.0" ;
    rcap:evidenceGlyph "•" ;
    rcap:evidenceGroup "Baseline and Eligibility data" ;
    rcap:evidencePage 77 ;
    rcap:evidencePosition "3" ;
    rcap:evidenceSection "8.8.2" ;
    rcap:evidenceText "Date and time of hospital admission" ;
    rcap:occurrenceKind "data_collection" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:CoreDesign_4_0 ;
    owl:annotatedTarget _:N1f4cc398824f4bbcbe8bbb8260629108 ;
    rcap:evidenceDoc "Core Protocol 4.0" ;
    rcap:evidencePosition "trailing:4" ;
    rcap:evidenceSection "7.6.1" ;
    rcap:evidenceText "The estimand is the transition between categories and the relative time spent in each category, modelled to produce an odds ratio from an ordinal logistic model, incorporating covariate adjustment as described in Section 7.8.3." ;
    rcap:occurrenceKind "endpoint_primary" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:CoreDesign_4_0 ;
    owl:annotatedTarget _:N9a3e7e876d62413a9c8ab9b57ba303e7 ;
    rcap:evidenceDoc "Core Protocol 4.0" ;
    rcap:evidenceGlyph "●" ;
    rcap:evidenceGroup "Actions following Statistical Trigger for equivalence, or noninferiority" ;
    rcap:evidencePage 66 ;
    rcap:evidencePosition "4" ;
    rcap:evidenceSection "7.8.7" ;
    rcap:evidenceText "A pair of equivalent interventions may be compressed into a single group for the purposes of ongoing analyses. Both interventions continue to be interventions that are available within the domain for allocation, but the primary analysis considers the effect of the two interventions as a single group, where a balanced randomization will be assigned to each of the intervention pair within this compressed group. Secondary analyses can continue to be conducted to determine if equivalence is maintained, with the possibility of the intervention being restored as individual interventions if results no longer support equivalence. It is acknowledged that re-analysis of the domain immediately following compression of one (or more) pairs of equivalent interventions may result in the occurrence of other Statistical Triggers (e.g., a compressed pair may be superior or inferior to all remaining interventions). Any Statistical Trigger that results from compression of one or more pairs will be responded to as outlined in this section with reporting of the cascade of Statistical Triggers. Compression of a pair of interventions can occur with or without reporting of a Platform Conclusion." ;
    rcap:occurrenceKind "allocation_rar" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:CoreDesign_4_0 ;
    owl:annotatedTarget _:N866f89926ce34b269a477bc291a5a06a ;
    rcap:evidenceDoc "Core Protocol 4.0" ;
    rcap:evidencePosition "lead_in:4" ;
    rcap:evidenceSection "7.6.2" ;
    rcap:evidenceText "DSAs dated before this Core Protocol amendment will additionally report the pre-specified endpoints as indicated in their respective documents and previous versions of the Core Protocol (available on the trial website)." ;
    rcap:occurrenceKind "endpoint_secondary" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:CoreDesign_4_0 ;
    owl:annotatedTarget _:N7c2e981ff9cd481bab0a741e45f3f3ee ;
    rcap:evidenceDoc "Core Protocol 4.0" ;
    rcap:evidencePosition "trailing:7" ;
    rcap:evidenceSection "7.6.1" ;
    rcap:evidenceText "90-day mortality will be hierarchically integrated with the daily ordinal scale so that 90-day mortality will be deemed the worst possible category, regardless of prior trajectory." ;
    rcap:occurrenceKind "endpoint_primary" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:CoreDesign_4_0 ;
    owl:annotatedTarget _:N7f63f460df244c16be441bb1973677be ;
    rcap:evidenceDoc "Core Protocol 4.0" ;
    rcap:evidencePosition "lead_in:8" ;
    rcap:evidenceSection "7.8.7" ;
    rcap:evidenceText "It is possible that a superior or efficacious intervention will be retained but subjected to further evaluation to refine the optimal characteristics (for example duration of therapy or optimal dose)." ;
    rcap:occurrenceKind "allocation_rar" .

[] a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource rcap:CoreDesign_4_0 ;
    owl:annotatedTarget _:Nefe1465fab0447139b719a432f82e174 ;
    rcap:evidenceDoc "Core Protocol 4.0" ;
    rcap:evidenceGlyph "●" ;
    rcap:evidenceGroup "Actions following Statistical Trigger for equivalence, or noninferiority" ;
    rcap:evidencePage 66 ;
    rcap:evidencePosition "2" ;
    rcap:evidenceSection "7.8.7" ;
    rcap:evidenceText "No change to the interventions within the domain with continuation of RAR. This could be to further evaluate secondary endpoints, a smaller delta, or interest in interactions with other interventions." ;
    rcap:occurrenceKind "allocation_rar" .

