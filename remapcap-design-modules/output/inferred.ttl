   <https://kerfors.github.io/early-clinical-design-research/remapcap-design-modules/evidenceText> "More than 48 hours has elapsed since commencement of sustained organ failure support in an ICU" ;
   <https://kerfors.github.io/early-clinical-design-research/remapcap-design-modules/occurrenceKind> "domain_exclusion"
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource <https://kerfors.github.io/early-clinical-design-research/remapcap-design-modules/DomainDesign_IG> ;
   owl:annotatedProperty rdfs:subClassOf ;
   owl:annotatedTarget _:genid2164 ;
   <https://kerfors.github.io/early-clinical-design-research/remapcap-design-modules/evidenceDoc> "COVID-19 Immunoglobulin Therapy Domain-Specific Appendix 4" ;
   <https://kerfors.github.io/early-clinical-design-research/remapcap-design-modules/evidencePosition> "lead_in:2" ;
   <https://kerfors.github.io/early-clinical-design-research/remapcap-design-modules/evidenceSection> "10.6" ;
   <https://kerfors.github.io/early-clinical-design-research/remapcap-design-modules/evidenceText> "Nesting high titer plasma with low titer plasma in the Immune Suppressed strata effectively borrows information from the previous immune suppressed patients randomized to convalescent plasma." ;
   <https://kerfors.github.io/early-clinical-design-research/remapcap-design-modules/occurrenceKind> "allocation_nesting"
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource <https://kerfors.github.io/early-clinical-design-research/remapcap-design-modules/DomainDesign_IG> ;
   owl:annotatedProperty rdfs:subClassOf ;
