   <https://kerfors.github.io/early-clinical-design-research/remapcap-design-modules/evidencePage> 19 ;
   <https://kerfors.github.io/early-clinical-design-research/remapcap-design-modules/evidencePosition> "1" ;
   <https://kerfors.github.io/early-clinical-design-research/remapcap-design-modules/evidenceSection> "8.2.3" ;
   <https://kerfors.github.io/early-clinical-design-research/remapcap-design-modules/evidenceText> "Known hypersensitivity to an agent specified as an intervention in this domain will exclude a patient from receiving that agent" ;
