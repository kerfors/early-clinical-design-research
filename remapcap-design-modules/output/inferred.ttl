   <https://kerfors.github.io/early-clinical-design-research/remapcap-design-modules/evidenceSection> "10.7" ;
   <https://kerfors.github.io/early-clinical-design-research/remapcap-design-modules/evidenceText> "The threshold probability for the statistical trigger of effectiveness will be the same as that applied for superiority." ;
   <https://kerfors.github.io/early-clinical-design-research/remapcap-design-modules/occurrenceKind> "allocation_threshold"
 ] .

