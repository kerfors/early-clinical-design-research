[ rdf:type owl:Axiom ;
   owl:annotatedSource <https://kerfors.github.io/early-clinical-design-research/remapcap-design-modules/CoreDesign_4_0> ;
   owl:annotatedProperty rdfs:subClassOf ;
   owl:annotatedTarget _:genid642 ;
   <https://kerfors.github.io/early-clinical-design-research/remapcap-design-modules/evidenceDoc> "Core Protocol 4.0" ;
   <https://kerfors.github.io/early-clinical-design-research/remapcap-design-modules/evidencePosition> "trailing:4" ;
   <https://kerfors.github.io/early-clinical-design-research/remapcap-design-modules/evidenceSection> "7.8.7" ;
   <https://kerfors.github.io/early-clinical-design-research/remapcap-design-modules/evidenceText> "With respect to reporting of Platform Conclusions and adaptations of the domain the following actions are possible: Factors that should be taken into account by the DSMB and the ITSC include the results of the primary analysis, analysis of clinically relevant secondary end-points, the possibility of treatment-by-treatment interactions, the relative burden and cost of the two interventions, the clinical interpretation of the adequacy of the delta, the possibility that ongoing randomization with a smaller delta might also allow a Statistical Trigger for superiority (with a small effect size) and the ordinal position of the equivalent pair within the domain." ;
   <https://kerfors.github.io/early-clinical-design-research/remapcap-design-modules/occurrenceKind> "allocation_rar"
