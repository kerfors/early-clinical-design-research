   <https://kerfors.github.io/early-clinical-design-research/remapcap-design-modules/evidenceSection> "8.5.2" ;
   <https://kerfors.github.io/early-clinical-design-research/remapcap-design-modules/evidenceText> "An additional endpoint, that will be reported as it becomes available and only from sites where linked data is available, is occurrence of major adverse cardiovascular events." ;
   <https://kerfors.github.io/early-clinical-design-research/remapcap-design-modules/occurrenceKind> "endpoint_secondary"
 ] .

[ rdf:type owl:Axiom ;
