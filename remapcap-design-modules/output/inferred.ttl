   <https://kerfors.github.io/early-clinical-design-research/remapcap-design-modules/evidenceSection> "4.3" ;
   <https://kerfors.github.io/early-clinical-design-research/remapcap-design-modules/evidenceText> "Qualifying organ failure support is defined as: Patients are not eligible for randomization in the Moderate State if they have been previously randomized in the Severe State, if they have previously been randomized in the Recovering State, or if they have received invasive mechanical ventilation at any time during this acute admission." ;
   <https://kerfors.github.io/early-clinical-design-research/remapcap-design-modules/occurrenceKind> "category_illness_severity"
 ] .

