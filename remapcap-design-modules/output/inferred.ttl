   <https://kerfors.github.io/early-clinical-design-research/remapcap-design-modules/evidenceText> "Ventilator-associated, a subcategory of hospital-acquired infection, additionally defined as infection in an invasively ventilated patient manifesting 48 hours or more after endotracheal intubation" ;
   <https://kerfors.github.io/early-clinical-design-research/remapcap-design-modules/occurrenceKind> "category_acquisition"
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource <https://kerfors.github.io/early-clinical-design-research/remapcap-design-modules/PandaDesign> ;
   owl:annotatedProperty rdfs:subClassOf ;
   owl:annotatedTarget _:genid2942 ;
   <https://kerfors.github.io/early-clinical-design-research/remapcap-design-modules/evidenceDoc> "Patient, Pathogen and Disease Appendix 1" ;
   <https://kerfors.github.io/early-clinical-design-research/remapcap-design-modules/evidencePosition> "lead_in:1" ;
   <https://kerfors.github.io/early-clinical-design-research/remapcap-design-modules/evidenceSection> "4.3" ;
   <https://kerfors.github.io/early-clinical-design-research/remapcap-design-modules/evidenceText> "Respiratory illness severity can change over time as a patient’s disease progresses and illness severity is an important determinate of both clinical outcome and potential differential treatment effect." ;
   <https://kerfors.github.io/early-clinical-design-research/remapcap-design-modules/occurrenceKind> "category_illness_severity"
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource <https://kerfors.github.io/early-clinical-design-research/remapcap-design-modules/PandaDesign> ;
   owl:annotatedProperty rdfs:subClassOf ;
   owl:annotatedTarget _:genid2944 ;
   <https://kerfors.github.io/early-clinical-design-research/remapcap-design-modules/evidenceDoc> "Patient, Pathogen and Disease Appendix 1" ;
