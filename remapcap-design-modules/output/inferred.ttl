[ rdf:type owl:Axiom ;
   owl:annotatedSource <https://kerfors.github.io/early-clinical-design-research/remapcap-design-modules/PandaDesign> ;
   owl:annotatedProperty rdfs:subClassOf ;
   owl:annotatedTarget _:genid2802 ;
   <https://kerfors.github.io/early-clinical-design-research/remapcap-design-modules/evidenceDoc> "Patient, Pathogen and Disease Appendix 1" ;
   <https://kerfors.github.io/early-clinical-design-research/remapcap-design-modules/evidencePosition> "lead_in:3" ;
   <https://kerfors.github.io/early-clinical-design-research/remapcap-design-modules/evidenceSection> "3.1" ;
   <https://kerfors.github.io/early-clinical-design-research/remapcap-design-modules/evidenceText> "In this Platform, pathogen status may be assigned based on clinical assessment, microbiological testing, or both." ;
   <https://kerfors.github.io/early-clinical-design-research/remapcap-design-modules/occurrenceKind> "category_pathogen"
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource <https://kerfors.github.io/early-clinical-design-research/remapcap-design-modules/PandaDesign> ;
   owl:annotatedProperty rdfs:subClassOf ;
   owl:annotatedTarget _:genid2804 ;
   <https://kerfors.github.io/early-clinical-design-research/remapcap-design-modules/evidenceDoc> "Patient, Pathogen and Disease Appendix 1" ;
   <https://kerfors.github.io/early-clinical-design-research/remapcap-design-modules/evidenceGlyph> "o" ;
   <https://kerfors.github.io/early-clinical-design-research/remapcap-design-modules/evidencePage> 10 ;
   <https://kerfors.github.io/early-clinical-design-research/remapcap-design-modules/evidencePosition> "7" ;
   <https://kerfors.github.io/early-clinical-design-research/remapcap-design-modules/evidenceSection> "4.4" ;
   <https://kerfors.github.io/early-clinical-design-research/remapcap-design-modules/evidenceText> "patients who are receiving invasive mechanical ventilation and have a ratio of arterial partial pressure of oxygen to fractional inspired concentration of oxygen (P:F ratio) of ≥ 200 mmHg (or saturation to fractional inspired concentration of oxygen ratio of ≥235) or are receiving invasive mechanical ventilation with the Positive End-Expiratory Pressure (PEEP) set to less than 5 cm of water (irrespective of the P:F ratio), and" ;
   <https://kerfors.github.io/early-clinical-design-research/remapcap-design-modules/occurrenceKind> "category_clinical_feature"
 ] .

