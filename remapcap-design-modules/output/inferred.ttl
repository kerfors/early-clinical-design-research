   <https://kerfors.github.io/early-clinical-design-research/remapcap-design-modules/evidenceText> "Patients who are eligible for only a single intervention at a site (i.e., all other interventions are contraindicated or not available) are not eligible for this domain." ;
   <https://kerfors.github.io/early-clinical-design-research/remapcap-design-modules/occurrenceKind> "intervention_exclusion"
 ] .

[ rdf:type owl:Axiom ;
