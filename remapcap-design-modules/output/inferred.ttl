[ rdf:type owl:Axiom ;
   owl:annotatedSource <https://kerfors.github.io/early-clinical-design-research/remapcap-design-modules/DomainDesign_IAV> ;
   owl:annotatedProperty rdfs:subClassOf ;
   owl:annotatedTarget _:genid1902 ;
   <https://kerfors.github.io/early-clinical-design-research/remapcap-design-modules/evidenceDoc> "Influenza Antiviral Domain-Specific Appendix 4" ;
