                                                                                                         <https://kerfors.github.io/early-clinical-design-research/remapcap-design-modules/responseStatement> <https://kerfors.github.io/early-clinical-design-research/remapcap-design-modules/c048bddcbd7> ,
                                                                                                                                                                                                              <https://kerfors.github.io/early-clinical-design-research/remapcap-design-modules/c3c4eef02e9> ,
                                                                                                                                                                                                              <https://kerfors.github.io/early-clinical-design-research/remapcap-design-modules/cd3604c9617> ;
