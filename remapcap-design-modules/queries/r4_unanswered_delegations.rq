# R4: Core 4.1 delegations a DSA leaves unanswered (no_answer, condition_not_stated) or answers only by
# referring back to the Core (defers_back), in the mapped section or, separately, in the secondary section.
# Umbrella and descriptive rows are not paired and not counted.
PREFIX rcap: <https://kerfors.github.io/early-clinical-design-research/remapcap-design-modules/>
SELECT ?dsa ?topic ?response ?secondary WHERE {
  ?r a rcap:DelegationReading ; rcap:allocationKind "delegation" ; rcap:role "paired" ;
     rcap:readingOf ?dsa ; rcap:topic ?topic ; rcap:response ?response .
  OPTIONAL { ?r rcap:secondaryResponse ?secondary }
  FILTER (?response IN ("no_answer", "condition_not_stated", "defers_back") || COALESCE(?secondary, "") = "defers_back")
}
ORDER BY ?dsa ?topic
