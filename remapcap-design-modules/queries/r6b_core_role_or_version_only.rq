# R6b: Core components whose occurrence differs between 4.0 and 4.1 without a text change:
# same component, different section or kind (moved), and components in one version only.
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX obo: <http://purl.obolibrary.org/obo/>
PREFIX rcap: <https://kerfors.github.io/early-clinical-design-research/remapcap-design-modules/>
SELECT ?component ?status ?kinds_40 ?kinds_41 ?sections_40 ?sections_41 WHERE {
  ?component rcap:coreStatus ?status .
  FILTER (?status IN ("moved", "only_40", "only_41"))
  OPTIONAL {
    SELECT ?component (GROUP_CONCAT(DISTINCT ?k; separator=";") AS ?kinds_40) (GROUP_CONCAT(DISTINCT ?s; separator=";") AS ?sections_40) WHERE {
      ?ax owl:annotatedSource rcap:CoreDesign_4_0 ; owl:annotatedTarget ?r ; rcap:occurrenceKind ?k ; rcap:evidenceSection ?s .
      ?r owl:someValuesFrom ?component .
    } GROUP BY ?component
  }
  OPTIONAL {
    SELECT ?component (GROUP_CONCAT(DISTINCT ?k; separator=";") AS ?kinds_41) (GROUP_CONCAT(DISTINCT ?s; separator=";") AS ?sections_41) WHERE {
      ?ax owl:annotatedSource rcap:CoreDesign_4_1 ; owl:annotatedTarget ?r ; rcap:occurrenceKind ?k ; rcap:evidenceSection ?s .
      ?r owl:someValuesFrom ?component .
    } GROUP BY ?component
  }
}
ORDER BY ?status ?sections_40 ?sections_41
