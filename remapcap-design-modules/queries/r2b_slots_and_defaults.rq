# R2b: what a DSA receives before it states anything, beyond components: the Core 4.1 overridable
# defaults (they hold while the DSA is silent) and the delegations (slots the DSA is to fill).
# One row per Core statement (topic), from the delegation readings, independent of the DSA.
PREFIX rcap: <https://kerfors.github.io/early-clinical-design-research/remapcap-design-modules/>
SELECT DISTINCT ?allocationKind ?role ?topic ?conditional WHERE {
  ?r a rcap:DelegationReading ; rcap:allocationKind ?allocationKind ; rcap:role ?role ; rcap:topic ?topic .
  OPTIONAL { ?r rcap:conditional ?conditional }
}
ORDER BY ?allocationKind ?role ?topic
