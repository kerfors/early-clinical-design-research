# R5: how each DSA answers each Core 4.1 overridable default (takes, overrides, silent, ambiguous),
# and, for the two-intervention defaults, the answer per illness-severity state (condition_not_met
# where the state does not have exactly two arms).
PREFIX rcap: <https://kerfors.github.io/early-clinical-design-research/remapcap-design-modules/>
SELECT ?dsa ?topic ?response ?state ?stateResponse ?arms WHERE {
  ?r a rcap:DelegationReading ; rcap:allocationKind "overridable default" ;
     rcap:readingOf ?dsa ; rcap:topic ?topic ; rcap:response ?response .
  OPTIONAL { ?s rcap:refinesReading ?r ; rcap:state ?state ; rcap:response ?stateResponse ; rcap:armCount ?arms }
}
ORDER BY ?topic ?dsa ?state
