# R1: components every DSA in scope has part of, that no Core version and no PANDA has part of.
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX obo: <http://purl.obolibrary.org/obo/>
PREFIX rcap: <https://kerfors.github.io/early-clinical-design-research/remapcap-design-modules/>
SELECT ?component ?text WHERE {
  VALUES ?d { rcap:DomainDesign_CS rcap:DomainDesign_AB rcap:DomainDesign_TAB rcap:DomainDesign_IAV
              rcap:DomainDesign_MD rcap:DomainDesign_IG rcap:DomainDesign_MV rcap:DomainDesign_END rcap:DomainDesign_IIM }
  ?d rdfs:subClassOf [ owl:onProperty obo:BFO_0000051 ; owl:someValuesFrom ?component ] .
  ?component rdfs:label ?text .
  FILTER NOT EXISTS {
    VALUES ?other { rcap:CoreDesign_4_0 rcap:CoreDesign_4_1 rcap:PandaDesign }
    ?other rdfs:subClassOf [ owl:onProperty obo:BFO_0000051 ; owl:someValuesFrom ?component ] .
  }
}
GROUP BY ?component ?text
HAVING (COUNT(DISTINCT ?d) = 9)
