ns2:MONDO_0024352 a owl:Class ;
    rdfs:label "viral respiratory tract infection" ;
    ns2:IAO_0000115 "A respiratory tract infection caused by a virus. Viruses represent the most common causes of upper and lower respiratory tract infections and include rhinoviruses, influenza viruses, parainfluenza viruses, and respiratory syncytial virus." ;
    dcterms:conformsTo <http://purl.obolibrary.org/obo/mondo/patterns/location.yaml> ;
    ns1:hasDbXref "ICD9:519.8",
        "MEDGEN:163755",
        "NCIT:C27219",
        "SCTID:312133006",
        "UMLS:C0877203" ;
