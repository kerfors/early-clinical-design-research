ns2:MONDO_7770006 a owl:Class ;
    rdfs:label "disease by body system or component" ;
    ns2:IAO_0000115 "A grouping class for human diseases classified by the body system or anatomical component primarily affected." ;
    ns1:id "MONDO:7770006" ;
    rdfs:comment "This term is intended solely for classification purposes and should not be used for direct data annotation." ;
    rdfs:subClassOf ns2:MONDO_0700096 .

ns2:MONDO_7770007 a owl:Class ;
    rdfs:label "disease by developmental or physiological process" ;
    ns2:IAO_0000115 "A grouping class for human diseases classified by the molecular, biochemical, cellular, anatomic, developmental or physiological process that is disrupted." ;
    ns1:id "MONDO:7770007" ;
    rdfs:comment "This term is intended solely for classification purposes and should not be used for direct data annotation." ;
    rdfs:subClassOf ns2:MONDO_0700096 .

ns2:MONDO_7770008 a owl:Class ;
    rdfs:label "disease by etiologic mechanism" ;
    ns2:IAO_0000115 "A grouping class for human diseases classified by their etiologic mechanism, encompassing primarily intrinsic (genetic, genomic), primarily extrinsic (e.g., infections, toxins, radiation), and complex multifactorial (e.g. nutritional) causes." ;
    ns1:id "MONDO:7770008" ;
    rdfs:comment "This term is intended solely for classification purposes and should not be used for direct data annotation." ;
    rdfs:subClassOf ns2:MONDO_0700096 .

ns2:MONDO_7770010 a owl:Class ;
    rdfs:label "disease of primarily extrinsic mechanism" ;
    ns2:IAO_0000115 "A grouping class for human diseases caused primarily by extrinsic factors, including infections, toxins, nutritional deficiencies, iatrogenic causes, and environmental exposures." ;
    ns1:id "MONDO:7770010" ;
    rdfs:comment "This term is intended solely for classification purposes and should not be used for direct data annotation." ;
    rdfs:subClassOf ns2:MONDO_7770008 .

ns2:OBI_0500026 a owl:Class ;
    rdfs:label "eligibility criterion"@en ;
    ns2:IAO_0000111 "eligibility criterion"@en ;
    ns2:IAO_0000112 "PMID: 17579629 -Eligibility criteria included: untreated ED-SCLC; age >/=70 and performance status 0-2, or age <70 and PS 3."@en ;
    ns2:IAO_0000114 ns2:IAO_0000122 ;
    ns2:IAO_0000115 """an eligibility criterion (rule) is_a selection criterion which 
defines and states the requirements (positive or negative) for an entity to be considered as suitable for a given task or participation in a process."""@en ;
    ns2:IAO_0000117 "Person: Philippe Rocca-Serra"@en ;
