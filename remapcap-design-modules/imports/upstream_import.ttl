    ns1:id "MONDO:0024352" ;
    ns1:inSubset ns3:otar ;
    rdfs:subClassOf ns2:MONDO_0005108,
        ns2:MONDO_0024355 ;
    skos:exactMatch <http://identifiers.org/medgen/163755>,
        <http://identifiers.org/snomedct/312133006>,
        <http://linkedlifedata.com/resource/umls/id/C0877203>,
        ns2:NCIT_C27219 .

