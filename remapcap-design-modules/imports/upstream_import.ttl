ns2:BFO_0000051 a owl:ObjectProperty ;
    rdfs:label "has part"@en ;
    ns2:IAO_0000115 "a core relation that holds between a whole and its part"@en .

ns2:IAO_0000005 a owl:Class ;
    rdfs:label "objective specification"@en ;
    ns2:IAO_0000115 "A directive information entity that describes an intended process endpoint. When part of a plan specification the concretization is realized in a planned process in which the bearer tries to effect the world so that the process endpoint is achieved."@en ;
    rdfs:subClassOf ns2:IAO_0000033 .

ns2:IAO_0000007 a owl:Class ;
    rdfs:label "action specification"@en ;
    ns2:IAO_0000115 "A directive information entity that describes an action the bearer will take."@en ;
    rdfs:subClassOf ns2:IAO_0000033 .

ns2:IAO_0000111 a owl:AnnotationProperty ;
    rdfs:label "editor preferred label",
        "editor preferred term",
        "editor preferred term~editor preferred label",
        "editor preferred label"@en,
        "editor preferred term"@en ;
    ns2:IAO_0000111 "editor preferred label",
        "editor preferred term",
        "editor preferred term~editor preferred label",
        "editor preferred label"@en,
        "editor preferred term"@en ;
    ns2:IAO_0000114 ns2:IAO_0000122 ;
    ns2:IAO_0000115 "The concise, meaningful, and human-friendly name for a class or property preferred by the ontology developers. (US-English)"@en ;
    ns2:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns2:IAO_0000119 "GROUP:OBI:<http://purl.obolibrary.org/obo/obi>"@en .

ns2:IAO_0000112 a owl:AnnotationProperty ;
    rdfs:label "example of usage"@en ;
    ns2:IAO_0000111 "example of usage"@en ;
    ns2:IAO_0000114 ns2:IAO_0000122 ;
    ns2:IAO_0000115 "A phrase describing how a term should be used and/or a citation to a work which uses it. May also include other kinds of examples that facilitate immediate understanding, such as widely know prototypes or instances of a class, or cases where a relation is said to hold."@en ;
    ns2:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns2:IAO_0000119 "GROUP:OBI:<http://purl.obolibrary.org/obo/obi>"@en .

ns2:IAO_0000114 a owl:AnnotationProperty ;
    rdfs:label "has curation status"@en ;
    ns2:IAO_0000111 "has curation status"@en ;
    ns2:IAO_0000117 "PERSON:Alan Ruttenberg"@en,
        "PERSON:Bill Bug"@en,
        "PERSON:Melanie Courtot"@en .

ns2:IAO_0000116 a owl:AnnotationProperty ;
    rdfs:label "editor note"@en ;
    ns2:IAO_0000111 "editor note"@en ;
    ns2:IAO_0000114 ns2:IAO_0000122 ;
    ns2:IAO_0000115 "An administrative note intended for its editor. It may not be included in the publication version of the ontology, so it should contain nothing necessary for end users to understand the ontology."@en ;
    ns2:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns2:IAO_0000119 "GROUP:OBI:<http://purl.obofoundry.org/obo/obi>"@en .

ns2:IAO_0000117 a owl:AnnotationProperty ;
    rdfs:label "term editor"@en ;
    ns2:IAO_0000111 "term editor"@en ;
    ns2:IAO_0000114 ns2:IAO_0000122 ;
    ns2:IAO_0000115 "Name of editor entering the term in the file. The term editor is a point of contact for information regarding the term. The term editor may be, but is not always, the author of the definition, which may have been worked upon by several people"@en ;
    ns2:IAO_0000116 "20110707, MC: label update to term editor and definition modified accordingly. See https://github.com/information-artifact-ontology/IAO/issues/115."@en ;
    ns2:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns2:IAO_0000119 "GROUP:OBI:<http://purl.obolibrary.org/obo/obi>"@en .

ns2:IAO_0000118 a owl:AnnotationProperty ;
    rdfs:label "alternative label"@en ;
    ns2:IAO_0000111 "alternative label"@en ;
    ns2:IAO_0000114 ns2:IAO_0000125 ;
    ns2:IAO_0000115 "A label for a class or property that can be used to refer to the class or property instead of the preferred rdfs:label. Alternative labels should be used to indicate community- or context-specific labels, abbreviations, shorthand forms and the like."@en ;
    ns2:IAO_0000117 "OBO Operations committee",
        "PERSON:Daniel Schober"@en ;
    ns2:IAO_0000119 "GROUP:OBI:<http://purl.obolibrary.org/obo/obi>"@en ;
    rdfs:comment "Consider re-defing to: An alternative name for a class or property which can mean the same thing as the preferred name (semantically equivalent, narrow, broad or related)." .

ns2:IAO_0000119 a owl:AnnotationProperty ;
    rdfs:label "definition source"@en ;
    ns2:IAO_0000111 "definition source"@en ;
    ns2:IAO_0000114 ns2:IAO_0000122 ;
    ns2:IAO_0000115 "Formal citation, e.g. identifier in external database to indicate / attribute source(s) for the definition. Free text indicate / attribute source(s) for the definition. EXAMPLE: Author Name, URI, MeSH Term C04, PUBMED ID, Wiki uri on 31.01.2007"@en ;
    ns2:IAO_0000117 "PERSON:Daniel Schober"@en ;
    ns2:IAO_0000119 "Discussion on obo-discuss mailing-list, see http://bit.ly/hgm99w"@en,
        "GROUP:OBI:<http://purl.obolibrary.org/obo/obi>"@en .

ns2:IAO_0000136 a owl:ObjectProperty ;
    rdfs:label "is about"@en ;
    ns2:IAO_0000115 "A (currently) primitive relation that relates an information artifact to an entity."@en .

ns2:IAO_0000232 a owl:AnnotationProperty ;
    rdfs:label "curator note"@en ;
    ns2:IAO_0000111 "curator note"@en ;
    ns2:IAO_0000114 ns2:IAO_0000122 ;
    ns2:IAO_0000115 "An administrative note of use for a curator but of no use for a user"@en ;
    ns2:IAO_0000117 "PERSON:Alan Ruttenberg"@en .

ns2:IAO_0000233 a owl:AnnotationProperty ;
    rdfs:label "term tracker item"@en ;
    ns2:IAO_0000111 "term tracker item"@en ;
    ns2:IAO_0000112 "the URI for an OBI Terms ticket at sourceforge, such as https://sourceforge.net/p/obi/obi-terms/772/"@en ;
    ns2:IAO_0000114 ns2:IAO_0000125 ;
    ns2:IAO_0000115 "An IRI or similar locator for a request or discussion of an ontology term."@en ;
    ns2:IAO_0000117 "Person: Jie Zheng, Chris Stoeckert, Alan Ruttenberg"@en ;
    ns2:IAO_0000119 "Person: Jie Zheng, Chris Stoeckert, Alan Ruttenberg"@en ;
    rdfs:comment "The 'tracker item' can associate a tracker with a specific ontology term."@en .

ns2:IAO_0000412 a owl:AnnotationProperty ;
    rdfs:label "imported from"@en ;
    ns2:IAO_0000111 "imported from"@en ;
    ns2:IAO_0000114 ns2:IAO_0000125 ;
    ns2:IAO_0000115 "For external terms/classes, the ontology from which the term was imported"@en ;
    ns2:IAO_0000117 "PERSON:Alan Ruttenberg"@en,
        "PERSON:Melanie Courtot"@en ;
    ns2:IAO_0000119 "GROUP:OBI:<http://purl.obolibrary.org/obo/obi>"@en .

ns2:OBI_0000750 a owl:Class ;
    rdfs:label "study design independent variable"@en ;
    ns2:IAO_0000111 "independent variable specification" ;
    ns2:IAO_0000112 "In a study in which gene expression is measured in patients between 8 month to 4 years old that have mild or severe malaria and in which the hypothesis is that gene expression in that age group is a function of disease status, disease status is the independent variable." ;
    ns2:IAO_0000114 ns2:IAO_0000122 ;
    ns2:IAO_0000115 "a directive information entity that is part of a study design. Independent variables are entities whose values are selected to determine its relationship to an observed phenomenon (the dependent variable). In such an experiment, an attempt is made to find evidence that the values of the independent variable determine the values of the dependent variable (that which is being measured). The independent variable can be changed as required, and its values do not represent a problem requiring explanation in an analysis, but are taken simply as given. The dependent variable on the other hand, usually cannot be directly controlled"@en ;
    ns2:IAO_0000116 "In the Philly 2013 workshop the label was chosen to distinguish it from \"dependent variable\" as used in statistical modelling. See: http://en.wikipedia.org/wiki/Statistical_modeling",
        "2/2/2009 Original definition - In the design of experiments, independent variables are those whose values are controlled or selected by the person experimenting (experimenter) to determine its relationship to an observed phenomenon (the dependent variable). In such an experiment, an attempt is made to find evidence that the values of the independent variable determine the values of the dependent variable (that which is being measured). The independent variable can be changed as required, and its values do not represent a problem requiring explanation in an analysis, but are taken simply as given. The dependent variable on the other hand, usually cannot be directly controlled."@en ;
    ns2:IAO_0000117 "PERSON: Alan Ruttenberg",
        "PERSON: Bjoern Peters",
        "PERSON: Chris Stoeckert" ;
    ns2:IAO_0000118 "experimental factor",
        "independent variable" ;
    ns2:IAO_0000119 "Web: http://en.wikipedia.org/wiki/Dependent_and_independent_variables" ;
    ns2:IAO_0000232 "2009-03-16: work has been done on this term during during the OBI workshop winter 2009 and the current definition was considered acceptable for use in OBI. If there is a need to modify thisdefinition please notify OBI." ;
    ns2:OBI_0001847 "study factor" ;
    rdfs:subClassOf ns2:IAO_0000033 .

ns2:OBI_0001847 a owl:AnnotationProperty ;
    rdfs:label "ISA alternative term"@en ;
    ns2:IAO_0000111 "ISA alternative term"@en ;
    ns2:IAO_0000114 ns2:IAO_0000122 ;
    ns2:IAO_0000115 "An alternative term used by the ISA tools project (http://isa-tools.org)."@en ;
    ns2:IAO_0000116 """Requested by Alejandra Gonzalez-Beltran
https://sourceforge.net/tracker/?func=detail&aid=3603413&group_id=177891&atid=886178""" ;
    ns2:IAO_0000117 "Person: Alejandra Gonzalez-Beltran",
        "Person: Philippe Rocca-Serra" ;
    ns2:IAO_0000119 "ISA tools project (http://isa-tools.org)" .

ns2:OBI_0500001 a owl:Class ;
    rdfs:label "clinical study design" ;
    ns2:IAO_0000111 "clinical study design" ;
    ns2:IAO_0000112 "PMID: 17655677.J Cardiovasc Electrophysiol. 2007 Aug;18(9):965-71.Biventricular versus right ventricular pacing in patients with AV block (BLOCK HF): clinical study design and rationale." ;
    ns2:IAO_0000114 ns2:IAO_0000125 ;
    ns2:IAO_0000115 "Plan for the precise procedure to be followed in a clinical trial, including planned and actual timing of events, choice of control group, method of allocating treatments, blinding methods; assigns a subject to pass through one or more epochs in the course of a trial. Specific design elements, e.g., crossover, parallel; dose-escalation [Modified from Pocock, Clinical Trials: A Practical Approach]"@en ;
    ns2:IAO_0000116 "The definition needs to be extended to other things than simply patients" ;
    ns2:IAO_0000117 "PlanAndPlannedProcess Branch" ;
    ns2:IAO_0000119 "Clinical Research Glossary Version 4.0 CDICS glossary group" ;
    rdfs:subClassOf ns2:OBI_0500000 .

ns2:OBI_0500027 a owl:Class ;
    rdfs:label "inclusion criterion"@en ;
    ns2:IAO_0000111 "inclusion criterion"@en ;
    ns2:IAO_0000112 "PMID: 23979341-The major inclusion criterion was patients in whom severe cerebral embolism was diagnosed at age 75 or younger (more than 9 in the NIHSS score on day 7 after the onset of stroke) ."@en ;
    ns2:IAO_0000114 ns2:IAO_0000125 ;
    ns2:IAO_0000115 "an inclusion criterion (rule) is_a *eligibility criterion*  which defines and states a condition which, if met, makes an entity suitable for a given task or participation in a given process. For instance, in a study protocol, inclusion criteria indicate the conditions that prospective subjects MUST meet to be eligible for participation in a study."@en ;
    ns2:IAO_0000117 "Person: Philippe Rocca-Serra"@en ;
    ns2:IAO_0000118 "inclusion condition"@en,
        "inclusion rule"@en ;
    ns2:IAO_0000119 "Adapted from Clinical Research Glossary Version 4.0 CDICS glossary group"@en ;
    rdfs:subClassOf ns2:OBI_0500026 .

ns2:OBI_0500028 a owl:Class ;
    rdfs:label "exclusion criterion"@en ;
    ns2:IAO_0000111 "exclusion rule"@en ;
    ns2:IAO_0000112 "PMID: 17600285-Exclusion criteria included the use of any topical ophthalmic or topical oral medication and/or history of ocular or oral surgery within the past six months."@en ;
    ns2:IAO_0000114 ns2:IAO_0000125 ;
    ns2:IAO_0000115 "an exclusion criterion (rule) is_a *eligibility criterion*  which defines and states a condition which, if met, makes an entity unsuitable for a given task or participation in a given process. For instance, in a study protocol, exclusion criteria indicate the conditions that prospective subjects SHOULD NOT meet to be eligible for participation in a study"@en ;
    ns2:IAO_0000117 "Person: Philippe Rocca-Serra"@en ;
    ns2:IAO_0000119 "Adapted from Clinical Research Glossary Version 4.0 CDICS glossary group"@en ;
    rdfs:subClassOf ns2:OBI_0500026 .

